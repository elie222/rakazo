{
  "name": "@rakazo/mobile",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "index.ts",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    },
    "autolinking": {
      "nativeModulesDir": "./modules",
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "cross-env EXPO_OFFLINE=1 expo install --check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/mobile/lib",
    "test:e2e": "maestro test .maestro/smoke.yaml"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/ui": "58.0.27",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@rakazo/chat-ui": "workspace:*",
    "@rakazo/contracts": "workspace:*",
    "@rakazo/core": "workspace:*",
    "@rakazo/i18n": "workspace:*",
    "@rakazo/logging": "workspace:*",
    "@rakazo/ui-tokens": "workspace:*",
    "@react-native-vector-icons/ionicons": "13.1.4",
    "@react-native-vector-icons/material-design-icons": "13.1.4",
    "@ronradtke/react-native-markdown-display": "9.0.3",
    "@sentry/react-native": "8.28.0",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.23",
