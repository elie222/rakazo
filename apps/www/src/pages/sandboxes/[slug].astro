---
import ProviderArticle from "../../components/ProviderArticle.astro";
import type { Sandbox } from "../../sandboxes";
import {
  SANDBOXES,
  SANDBOXES_ARTICLE_HUB,
  SANDBOXES_UPDATED,
  otherSandboxes,
  sandboxPath,
} from "../../sandboxes";

interface Props {
  sandbox: Sandbox;
}

export function getStaticPaths() {
  return SANDBOXES.map((sandbox) => ({
    params: { slug: sandbox.slug },
    props: { sandbox },
  }));
}

const { sandbox } = Astro.props;
---

<ProviderArticle
  article={sandbox}
  hub={SANDBOXES_ARTICLE_HUB}
  others={otherSandboxes(sandbox)}
  updated={SANDBOXES_UPDATED}
  ogId={`sandbox-${sandbox.slug}`}
  markdownPath={`${sandboxPath(sandbox.slug).slice(0, -1)}.md`}
/>
