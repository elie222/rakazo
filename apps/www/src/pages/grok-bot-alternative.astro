---
import CaptionedImage from "../components/CaptionedImage.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import RichText from "../components/RichText.astro";
import { githubStarsLabel } from "../github";
import {
  GROK_ALTERNATIVE_DESCRIPTION,
  GROK_ALTERNATIVE_FAQ,
  GROK_ALTERNATIVE_H1,
  GROK_ALTERNATIVE_TITLE,
  GROK_ALTERNATIVES,
  GROK_HOWTO,
  GROK_INTRO,
  GROK_MODELS_FIGURE,
  GROK_ROUTINE_FIGURE,
  GROK_SOURCES,
  GROK_UPDATED,
  grokAlternativeStructuredData,
} from "../grok-alternative";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ogPublicPath } from "../og-pages";
import { SITE_URL } from "../site";

const starsLabel = await githubStarsLabel();
const pageUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const structuredData = grokAlternativeStructuredData(pageUrl);

function externalAttrs(href: string) {
  if (!href.startsWith("http") || href.startsWith(SITE_URL)) return {};
  return { target: "_blank", rel: "nofollow noopener noreferrer" };
}
---

<BaseLayout
  title={GROK_ALTERNATIVE_TITLE}
  description={GROK_ALTERNATIVE_DESCRIPTION}
  ogImageAlt={GROK_ALTERNATIVE_H1}
  {structuredData}
  localeAlternates={false}
  ogImage={ogPublicPath("grok-bot-alternative")}
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class="privacy-copy guide">
      <h1>{GROK_ALTERNATIVE_H1}</h1>
      <p class="alt-note">Updated {GROK_UPDATED}.</p>
      {GROK_INTRO.map((paragraph) => (
        <p>
          <RichText text={paragraph} />
        </p>
      ))}
      <ul class="other-cards">
        {
          GROK_ALTERNATIVES.map((item) => (
            <li class="other-card">
              <a
                class="other-card__link"
                href={item.href}
                {...externalAttrs(item.href)}
              >
                <picture>
                  <source type="image/avif" srcset={item.image.avif} />
                  <img
                    src={item.image.webp}
                    alt={item.image.alt}
                    width={item.image.width}
                    height={item.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <span class="other-card__name">{item.label}</span>
              </a>
              {item.caption && <p class="other-card__caption">{item.caption}</p>}
              <p>
                <RichText text={item.note} />
              </p>
            </li>
          ))
        }
      </ul>
      <CaptionedImage
        src={GROK_ROUTINE_FIGURE.webp}
        avif={GROK_ROUTINE_FIGURE.avif}
        width={GROK_ROUTINE_FIGURE.width}
        height={GROK_ROUTINE_FIGURE.height}
        alt={GROK_ROUTINE_FIGURE.alt}
        caption={GROK_ROUTINE_FIGURE.caption}
        loading="lazy"
      />
      <CaptionedImage
        src={GROK_MODELS_FIGURE.webp}
        avif={GROK_MODELS_FIGURE.avif}
        width={GROK_MODELS_FIGURE.width}
        height={GROK_MODELS_FIGURE.height}
        alt={GROK_MODELS_FIGURE.alt}
        caption={GROK_MODELS_FIGURE.caption}
        loading="lazy"
      />

      <h2>How to choose</h2>
      {GROK_HOWTO.map((paragraph) => (
        <p>
          <RichText text={paragraph} />
        </p>
      ))}
      <ul class="source-list">
        {
          GROK_SOURCES.map((source) => (
            <li>
              <a href={source.href} {...externalAttrs(source.href)}>
                {source.label}
              </a>
            </li>
          ))
        }
      </ul>

      <h2 id="faq">FAQ</h2>
      {
        GROK_ALTERNATIVE_FAQ.map((item) => (
          <section>
            <h3>{item.question}</h3>
            <p>
              <RichText text={item.answer} />
            </p>
          </section>
        ))
      }
    </main>
    <Footer />
  </div>
</BaseLayout>
