---
import ProviderArticle from "../../components/ProviderArticle.astro";
import type { IntegrationPlatform } from "../../integration-platforms";
import {
  INTEGRATION_PLATFORMS,
  INTEGRATION_PLATFORMS_ARTICLE_HUB,
  INTEGRATION_PLATFORMS_UPDATED,
  integrationPlatformPath,
  otherIntegrationPlatforms,
} from "../../integration-platforms";

interface Props {
  platform: IntegrationPlatform;
}

export function getStaticPaths() {
  return INTEGRATION_PLATFORMS.map((platform) => ({
    params: { slug: platform.slug },
    props: { platform },
  }));
}

const { platform } = Astro.props;
---

<ProviderArticle
  article={platform}
  hub={INTEGRATION_PLATFORMS_ARTICLE_HUB}
  others={otherIntegrationPlatforms(platform)}
  updated={INTEGRATION_PLATFORMS_UPDATED}
  ogId={`integration-platform-${platform.slug}`}
  markdownPath={`${integrationPlatformPath(platform.slug).slice(0, -1)}.md`}
/>
