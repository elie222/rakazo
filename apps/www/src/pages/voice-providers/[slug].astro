---
import ProviderArticle from "../../components/ProviderArticle.astro";
import type { VoiceProvider } from "../../voice-providers";
import {
  VOICE_PROVIDERS,
  VOICE_PROVIDERS_ARTICLE_HUB,
  VOICE_PROVIDERS_UPDATED,
  voiceProviderPath,
  otherVoiceProviders,
} from "../../voice-providers";

interface Props {
  provider: VoiceProvider;
}

export function getStaticPaths() {
  return VOICE_PROVIDERS.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;
---

<ProviderArticle
  article={provider}
  hub={VOICE_PROVIDERS_ARTICLE_HUB}
  others={otherVoiceProviders(provider)}
  updated={VOICE_PROVIDERS_UPDATED}
  ogId={`voice-provider-${provider.slug}`}
  markdownPath={`${voiceProviderPath(provider.slug).slice(0, -1)}.md`}
/>
