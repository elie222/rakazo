---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  class:list={["product-hunt-badge", className]}
  href="https://www.producthunt.com/products/rakazo?embed=true&utm_source=badge-top-post-badge&utm_medium=badge&utm_campaign=badge-rakazo-2"
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    src="/graphics/badges/product-hunt-top-post.svg"
    alt="#1 Product of the Day on Product Hunt"
    width="200"
    height="43"
  />
</a>
