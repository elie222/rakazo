---
type Props = {
  href: string;
  variant?: "primary" | "secondary";
  size?: "md" | "sm";
  external?: boolean;
  "data-attr"?: string;
};

const { href, variant = "primary", size = "md", external = false, "data-attr": dataAttr } = Astro.props;
---

<a
  class:list={["button", `button--${variant}`, size === "sm" && "button--small"]}
  href={href}
  data-attr={dataAttr}
  {...(external ? { target: "_blank", rel: "noopener" } : {})}
>
  <slot />
</a>
