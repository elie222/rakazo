---
import { ogPublicPath } from "../og-pages";
import type { ArticleHub, ArticleLink, ProviderArticle } from "../provider-article/types";
import { GITHUB_URL } from "../site";
import ArticleText from "./ArticleText.astro";
import Button from "./Button.astro";
import CaptionedImage from "./CaptionedImage.astro";
import ProviderCard from "./ProviderCard.astro";
import { ProviderScene } from "./ProviderScene";
import SiteFrame from "./SiteFrame.astro";

type Props = {
  article: ProviderArticle;
  hub: ArticleHub;
  others: readonly ArticleLink[];
  updated: string;
  ogId: string;
  markdownPath: string;
};

const { article, hub, others, updated, ogId, markdownPath } = Astro.props;
---

<SiteFrame
  title={article.title}
  description={article.description}
  faq={article.faq}
  ogImage={ogPublicPath(ogId)}
  markdownAlternate={markdownPath}
>
  <p class="alt-crumb"><a href={hub.href}>{hub.label}</a></p>
  <h1>{article.h1}</h1>
  <p class="page-updated">Updated {updated}.</p>
  {article.intro.map((paragraph) => <p><ArticleText text={paragraph} /></p>)}

  <ProviderScene {...article.scene} />

  {
    article.sections.map((section) => (
      <section class="sandbox-section">
        <h2>{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => (
          <p>
            <ArticleText text={paragraph} />
          </p>
        ))}
        {section.bullets && (
          <ul>
            {section.bullets.map((item) => (
              <li>
                <ArticleText text={item} />
              </li>
            ))}
          </ul>
        )}
        {section.steps && (
          <ol class="sandbox-steps">
            {section.steps.map((step) => (
              <li>
                <ArticleText text={step} />
              </li>
            ))}
          </ol>
        )}
        {section.image && (
          <CaptionedImage
            src={article.image.webp}
            avif={article.image.avif}
            alt={article.image.alt}
            caption={article.image.caption}
            width={article.image.width}
            height={article.image.height}
          />
        )}
      </section>
    ))
  }

  <div class="alt-actions">
    <Button href={hub.guide.href}>{hub.guide.label}</Button>
    <Button href={GITHUB_URL} variant="secondary" external>View on GitHub</Button>
  </div>

  <h2 id="faq">FAQ</h2>
  {
    article.faq.map((item, index) => (
      <section aria-labelledby={`faq-${index}`}>
        <h3 id={`faq-${index}`}>{item.question}</h3>
        <p>
          <ArticleText text={item.answer} />
        </p>
      </section>
    ))
  }

  <h2>{hub.moreHeading}</h2>
  <ul class="sandbox-cards">
    {others.map((link) => <ProviderCard link={link} />)}
  </ul>
  <p class="sandbox-all"><a href={hub.href}>Compare all</a></p>

  <h2>Sources</h2>
  <ul class="source-list">
    {
      article.sources.map((source) => (
        <li>
          <a href={source.href} target="_blank" rel="noreferrer">
            {source.label}
          </a>
        </li>
      ))
    }
  </ul>
</SiteFrame>
