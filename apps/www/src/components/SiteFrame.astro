---
import type { FaqItem } from "../alternatives";
import { faqPageSchema } from "../alternatives";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

type Props = {
  title: string;
  description: string;
  faq?: readonly FaqItem[];
  structuredData?: object;
  ogImage?: string;
  ogType?: string;
  index?: boolean;
  wide?: boolean;
  markdownAlternate?: string;
};

const {
  title,
  description,
  faq,
  structuredData: structuredDataProp,
  ogImage,
  ogType,
  index = true,
  wide = false,
  markdownAlternate,
} = Astro.props;
const starsLabel = await githubStarsLabel();
const structuredData =
  structuredDataProp ?? (faq && faq.length > 0 ? faqPageSchema(faq) : undefined);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  localeAlternates={false}
  ogImage={ogImage}
  ogType={ogType}
  index={index}
  markdownAlternate={markdownAlternate}
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class:list={[wide ? "wide-page" : "alt-page"]}>
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
