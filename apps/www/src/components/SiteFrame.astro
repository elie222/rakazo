---
import type { FaqItem } from "../alternatives";
import type { ArticleMeta } from "../blog/format";
import { githubStarsLabel } from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { PageArticleInput } from "../structured-data";
import { faqPageSchema, pageArticleStructuredData } from "../structured-data";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

type Props = {
  title: string;
  description: string;
  faq?: readonly FaqItem[];
  structuredData?: object;
  /**
   * Describes the page as an Article with its FAQ. The breadcrumbs end at this page, named
   * `crumb` or the headline.
   */
  article?: Pick<PageArticleInput, "headline" | "crumb" | "parents">;
  /** More nodes for the article's graph, such as an ItemList. */
  nodes?: readonly object[];
  ogImage?: string;
  /** Published and modified times for the article meta tags. */
  articleMeta?: ArticleMeta;
  index?: boolean;
  wide?: boolean;
  markdownAlternate?: string;
};

const {
  title,
  description,
  faq,
  structuredData: structuredDataProp,
  article,
  nodes = [],
  ogImage,
  articleMeta,
  index = true,
  wide = false,
  markdownAlternate,
} = Astro.props;
const starsLabel = await githubStarsLabel();
const structuredData =
  structuredDataProp ??
  (article
    ? pageArticleStructuredData(
        { path: Astro.url.pathname, description, faq, image: ogImage, ...article },
        ...nodes,
      )
    : faq && faq.length > 0
      ? faqPageSchema(faq)
      : undefined);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  ogImage={ogImage}
  article={articleMeta}
  index={index}
  markdownAlternate={markdownAlternate}
>
  <div class="container">
    <Header starsLabel={starsLabel} />
    <main id="main" class:list={[wide ? "wide-page" : "alt-page"]}>
      <slot />
    </main>
    <Footer />
  </div>
</BaseLayout>
