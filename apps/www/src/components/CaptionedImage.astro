---
type Props = {
  src: string;
  avif?: string;
  alt: string;
  caption: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
};

const { src, avif, alt, caption, width, height, loading } = Astro.props;
---

<figure class="post-figure">
  {
    avif ? (
      <picture>
        <source type="image/avif" srcset={avif} />
        <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
      </picture>
    ) : (
      <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" />
    )
  }
  <figcaption>{caption}</figcaption>
</figure>
