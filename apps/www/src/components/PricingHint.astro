---
type Props = {
  label: string;
  detail: string;
};

const { label, detail } = Astro.props;
const id = `pricing-hint-${crypto.randomUUID()}`;
---

<span class="pricing-hint" tabindex="0" aria-describedby={id}>
  {label}
  <span class="pricing-hint__tip" id={id} role="tooltip">{detail}</span>
</span>
