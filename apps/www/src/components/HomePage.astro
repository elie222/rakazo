---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import GetStartedActions from "./GetStartedActions.astro";
import Header from "./Header.astro";
import { LandingBotAvatar } from "./LandingBotAvatar";
import PhoneMockup from "./PhoneMockup.astro";
import { ProductDemo } from "./ProductDemo";
import { demoMessages, getDemoBots } from "../i18n/demo";
import FeatureIllustration from "./FeatureIllustration.astro";
import CapabilityIllustration from "./CapabilityIllustration.astro";
import RepoCard from "./RepoCard.astro";
import RosterBotAvatar from "./RosterBotAvatar.astro";
import type { Locale } from "../i18n/locales";
import chatgptLogo from "./provider-logos/chatgpt.svg?raw";
import claudeLogo from "./provider-logos/claude.svg?raw";
import grokLogo from "./provider-logos/grok.svg?raw";
import lmStudioLogo from "./provider-logos/lmstudio.svg?raw";
import ollamaLogo from "./provider-logos/ollama.svg?raw";
import openRouterLogo from "./provider-logos/openrouter.svg?raw";
import imessageLogo from "./brand-logos/imessage.svg?raw";
import slackLogo from "./brand-logos/slack.svg?raw";
import telegramLogo from "./brand-logos/telegram.svg?raw";
import whatsappLogo from "./brand-logos/whatsapp.svg?raw";
import {
  HOME_CHANNELS,
  HOME_FEATURE_KINDS,
  HOME_MODEL_PROVIDERS,
  getHomeCopy,
} from "../i18n/home";
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
} from "../i18n/locales";
import {
  availableDesktopPlatforms,
  desktopDownloadHref,
  fetchDesktopDownloads,
  fetchRecentChanges,
  githubStarsLabel,
} from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeStructuredData } from "../structured-data";
import {
  ANDROID_APK_URL,
  APP_URL,
  GITHUB_URL,
  IOS_APP_URL,
  SELF_HOST_GUIDE_PATH,
  SETUP_PROMPT_URL,
  SITE_URL,
} from "../site";


const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;

const copy = getHomeCopy(locale);
const enCopy = getHomeCopy(DEFAULT_LOCALE);
const availableLanguages = LOCALES.map((supportedLocale) =>
  getHomeCopy(supportedLocale).availableLanguage
);
const homeHref = localeHomePath(locale);
const [starsLabel, desktopDownloads, recentChanges] = await Promise.all([
  githubStarsLabel(),
  fetchDesktopDownloads(),
  fetchRecentChanges(5),
]);
const setupAgentPrompt = `Set up Rakazo for me. Follow the setup prompt at ${SETUP_PROMPT_URL}`;
const desktopPlatforms = availableDesktopPlatforms(desktopDownloads);
const PLATFORM_NAMES = { mac: "macOS", windows: "Windows", linux: "Linux" } as const;
const PROVIDER_LOGOS: Record<string, string> = {
  Claude: claudeLogo,
  ChatGPT: chatgptLogo,
  OpenRouter: openRouterLogo,
  Grok: grokLogo,
  Ollama: ollamaLogo,
  "LM Studio": lmStudioLogo,
};
const CHANNEL_LOGOS: Record<(typeof HOME_CHANNELS)[number]["id"], string> = {
  slack: slackLogo,
  imessage: imessageLogo,
  whatsapp: whatsappLogo,
  telegram: telegramLogo,
};
const selfHostOnlyHref = `${SELF_HOST_GUIDE_PATH}#self-host-only`;
const pageUrl = `${SITE_URL}${homeHref === "/" ? "/" : homeHref}`;

const structuredData = homeStructuredData({
  pageUrl,
  title: copy.title,
  description: copy.description,
  siteDescription: enCopy.description,
  inLanguage: LOCALE_HTML_LANG[locale],
  defaultInLanguage: LOCALE_HTML_LANG[DEFAULT_LOCALE],
  availableLanguages,
  faq: copy.faq.items,
});
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} starsLabel={starsLabel} homeHref={homeHref} />

    <main id="main">
      <script is:inline>
        (() => {
          const ua = navigator.userAgent;
          document.documentElement.dataset.platform =
            /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
              ? "ios"
              : /Android/.test(ua)
                ? "android"
                : /Windows/.test(ua)
                  ? "windows"
                  : /Linux|X11/.test(ua) && !/CrOS|aarch64|arm/i.test(ua)
                    ? "linux"
                    : /Macintosh/.test(ua)
                      ? "mac"
                      : "web";
          // Chromium freezes the Linux UA at x86_64; the AppImage is x64-only.
          if (document.documentElement.dataset.platform === "linux") {
            navigator.userAgentData
              ?.getHighEntropyValues(["architecture"])
              .then(({ architecture }) => {
                if (architecture !== "x86") document.documentElement.dataset.platform = "web";
              })
              .catch(() => undefined);
          }
        })();
      </script>

      <section class="hero">
        <h1>{copy.hero.heading}</h1>
        <p class="lead">
          {copy.hero.lead}
        </p>
        <GetStartedActions
          class="hero__actions"
          copy={copy.hero}
          placement="hero"
          githubLabel={copy.openSource.starOnGithub}
        />
        <div class="hero__agent-setup">
          <button
            class="setup-copy"
            type="button"
            data-setup-copy={setupAgentPrompt}
            data-setup-label={copy.hero.setupWithAgent}
            data-setup-copied={copy.hero.copiedForAgent}
            data-setup-failed={copy.hero.copyFailed}
          >
            <span class="setup-copy__prefix" aria-hidden="true">$</span>
            <span class="setup-copy__label">{copy.hero.setupWithAgent}</span>
            <svg class="setup-copy__icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="8" y="8" width="12" height="12" rx="2"></rect>
              <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
            </svg>
          </button>
        </div>
      </section>

      <section id="demo">
        <ProductDemo bots={getDemoBots(locale)} strings={demoMessages(locale)} client:load />
      </section>

      <section id="roster" class="section">
        <div class="section-intro">
          <div class="eyebrow">{copy.roster.eyebrow}</div>
          <h2 class="section-heading">{copy.roster.heading}</h2>
          <p class="section-copy">
            {copy.roster.copy}
          </p>
        </div>
        <div class="card-grid-4">
          {
            copy.roster.bots.map((bot) => (
              <article class="roster-card">
                <RosterBotAvatar color={bot.color} name={bot.name} />
                <h3>{bot.name}</h3>
                <p>{bot.desc}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="channels" class="section channels">
        <div class="channels__intro">
          <h2 class="section-heading">{copy.channels.heading}</h2>
          <p class="section-copy">{copy.channels.copy}</p>
          <ul class="channel-list">
            {
              HOME_CHANNELS.map((channel) => (
                <li class="channel-tile">
                  <span class="channel-tile__logo"><Fragment set:html={CHANNEL_LOGOS[channel.id]} /></span>
                  <span class="channel-tile__name">{channel.name}</span>
                  {channel.selfHosted && (
                    <a class="self-host-tag" href={selfHostOnlyHref}>{copy.selfHost.heading}</a>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="slack-mock" aria-hidden="true">
          <div class="slack-mock__bar">
            <span class="slack-mock__logo"><Fragment set:html={slackLogo} /></span>
            <b># sales</b>
          </div>
          <div class="slack-mock__message">
            <span class="slack-mock__person">AK</span>
            <div>
              <div class="slack-mock__name">Avery Kim <time>9:41</time></div>
              <p><mark>@Sales Outbound</mark> {copy.channels.mock.ask}</p>
            </div>
          </div>
          <div class="slack-mock__message">
            <img src="/brand/job-bots/sales-outbound.webp" alt="" width="36" height="36" loading="lazy" />
            <div>
              <div class="slack-mock__name">Sales Outbound <span class="slack-mock__app">APP</span> <time>9:41</time></div>
              <p>{copy.channels.mock.reply}</p>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="section">
        <div class="section-intro">
          <h2 class="section-heading">{copy.features.heading}</h2>
        </div>
        <div class="card-grid-3 capability-grid">
          {
            HOME_FEATURE_KINDS.map((kind) => (
              <article class="feature-card">
                <CapabilityIllustration kind={kind} labels={copy.features.mock} />
                <h3>{copy.features.items[kind].title}</h3>
                <p>{copy.features.items[kind].body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="testimonials" class="section testimonials" aria-labelledby="testimonials-heading">
        <div class="section-intro testimonials__heading">
          <h2 id="testimonials-heading" class="section-heading">{copy.testimonials.heading}</h2>
          <button
            class="testimonial-pause"
            type="button"
            aria-label={copy.testimonials.pause}
            title={copy.testimonials.pause}
            data-testimonial-pause
            data-pause-label={copy.testimonials.pause}
            data-play-label={copy.testimonials.play}
          >
            <svg class="testimonial-pause__pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="3" width="2.5" height="10" rx="1" /><rect x="9.5" y="3" width="2.5" height="10" rx="1" /></svg>
            <svg class="testimonial-pause__play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.4v9.2a.8.8 0 0 0 1.2.7l7.4-4.6a.8.8 0 0 0 0-1.4L6.2 2.7A.8.8 0 0 0 5 3.4Z" /></svg>
          </button>
        </div>
        <div
          class="testimonial-viewport"
          data-testimonial-marquee
          tabindex="0"
          role="region"
          aria-labelledby="testimonials-heading"
        >
          <div class="testimonial-track">
            {
              [false, true].map((clone) => (
                <div
                  class="testimonial-group"
                  aria-hidden={clone ? "true" : undefined}
                  inert={clone ? true : undefined}
                  data-testimonial-clone={clone ? "" : undefined}
                >
                  {copy.testimonials.items.map((item, index) => (
                    <figure class="testimonial-card" lang="en">
                      <blockquote>
                        <p>{item.quote}</p>
                      </blockquote>
                      <figcaption>
                        <LandingBotAvatar
                          color={copy.roster.bots[index % copy.roster.bots.length].color}
                          size={32}
                          className="testimonial-avatar"
                        />
                        <span>{item.attribution}</span>
                      </figcaption>
                    </figure>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="selfhost" class="section">
        <div class="selfhost__intro">
          <div class="section-intro">
            <h2 class="section-heading">{copy.selfHost.heading}</h2>
            <p class="section-copy">
              {copy.selfHost.copy}
            </p>
          </div>
          <div class="selfhost__actions">
            <Button href={GITHUB_URL} external data-attr="selfhost-github">{copy.hero.viewOnGithub}</Button>
            <Button href="/docs/self-host/" variant="secondary">{copy.openSource.readTheDocs}</Button>
          </div>
        </div>
        <div class="card-grid-3">
          {
            copy.selfHost.features.map((feature, index) => (
              <article class="feature-card">
                <FeatureIllustration kind={index === 0 ? "model" : index === 1 ? "schedule" : "approval"} labels={copy.selfHost.mock} />
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
        <div class="works-with">
          <span>{copy.selfHost.worksWith}</span>
          {HOME_MODEL_PROVIDERS.map((name) => (
            <span class="provider-chip">
              <Fragment set:html={PROVIDER_LOGOS[name]} />
              {name}
            </span>
          ))}
        </div>
      </section>

      <section id="platforms" class="section platforms">
        <div class="section-intro">
          <h2 class="section-heading">{copy.platforms.heading}</h2>
          <div class="platforms__cards">
            <article class="platform-card">
              <svg class="platform-card__icon" viewBox="0 0 48 48" aria-hidden="true">
                <rect x="5" y="9" width="38" height="30" rx="4" />
                <path d="M5 17h38" />
                <circle cx="10.5" cy="13" r="1" />
                <circle cx="14.5" cy="13" r="1" />
                <circle cx="18.5" cy="13" r="1" />
              </svg>
              <h3>{copy.platforms.web}</h3>
              <div class="platform-card__links">
                <a href={APP_URL}>{copy.hero.getStarted}</a>
              </div>
            </article>
            <article class="platform-card">
              <svg class="platform-card__icon" viewBox="0 0 48 48" aria-hidden="true">
                <rect x="9" y="10" width="30" height="21" rx="3" />
                <path d="M4 36h40l-3 3H7z" />
              </svg>
              <h3>{copy.platforms.desktop}</h3>
              <div class="platform-card__links">
                {desktopPlatforms.map((platform) => (
                  <a href={desktopDownloadHref(platform)}>{PLATFORM_NAMES[platform]}</a>
                ))}
              </div>
            </article>
            <article class="platform-card">
              <svg class="platform-card__icon" viewBox="0 0 48 48" aria-hidden="true">
                <rect x="14" y="5" width="20" height="38" rx="5" />
                <path d="M21 9.5h6" />
              </svg>
              <h3>{copy.platforms.mobile}</h3>
              <div class="platform-card__links">
                <a href={IOS_APP_URL}>iOS</a>
                <a href={ANDROID_APK_URL}>Android</a>
              </div>
            </article>
          </div>
        </div>
        <PhoneMockup locale={locale} />
      </section>

      <section id="open-source" class:list={["section", recentChanges.length > 0 && "open-source"]}>
        <div>
          <h2 class="section-heading">{copy.openSource.heading}</h2>
          <p class="section-copy">
            {copy.openSource.copy}
          </p>
          <div class="source-links">
            <Button href={GITHUB_URL} external data-attr="open-source-github">
              {copy.openSource.starOnGithub}
            </Button>
          </div>
        </div>
        {
          recentChanges.length > 0 && (
            <RepoCard locale={locale} starsLabel={starsLabel} changes={recentChanges} />
          )
        }
      </section>

      <section id="faq" class="section" aria-labelledby="faq-heading">
        <div class="section-intro">
          <h2 id="faq-heading" class="section-heading">{copy.faq.heading}</h2>
        </div>
        <div class="home-faq">
          {
            copy.faq.items.map((item) => (
              <article>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="stats-band">
        <div>
          <h2>{copy.cta.heading}</h2>
          <p>{copy.cta.copy}</p>
          <GetStartedActions
            class="cta-actions"
            copy={copy.hero}
            downloads={desktopDownloads}
            placement="cta"
          />
        </div>
        <div class="stats-grid">
          {
            copy.cta.stats.map((stat) => (
              <div>
                <div class="stat-value">
                  {stat.value === "stars"
                    ? starsLabel
                    : stat.value === "license"
                      ? "Apache-2.0"
                      : stat.value === "openSource"
                        ? copy.cta.openSourceValue
                        : copy.cta.selfHostValue}
                </div>
                <div class="stat-label">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <Footer
      locale={locale}
      languagesLabel={copy.footer.languagesLabel}
      navLabel={copy.footer.navLabel}
      homeLabel={copy.nav.home}
      linkLabels={copy.footer.links}
      homeHref={homeHref}
    />
  </div>
</BaseLayout>

<script>
  import "../support-chat";
  const setupCopy = document.querySelector<HTMLButtonElement>("[data-setup-copy]");
  const setupCopyLabel = setupCopy?.querySelector<HTMLElement>(".setup-copy__label");

  setupCopy?.addEventListener("click", async () => {
    const prompt = setupCopy.dataset.setupCopy;
    const idleLabel = setupCopy.dataset.setupLabel;
    const copiedLabel = setupCopy.dataset.setupCopied;
    const failedLabel = setupCopy.dataset.setupFailed;
    if (!prompt || !setupCopyLabel || !idleLabel || !copiedLabel || !failedLabel) return;

    try {
      await navigator.clipboard.writeText(prompt);
      setupCopyLabel.textContent = copiedLabel;
      window.setTimeout(() => {
        setupCopyLabel.textContent = idleLabel;
      }, 2400);
    } catch {
      setupCopyLabel.textContent = failedLabel;
    }
  });

  const marquee = document.querySelector<HTMLElement>("[data-testimonial-marquee]");
  const marqueeGroup = marquee?.querySelector<HTMLElement>(".testimonial-group");
  if (marquee && marqueeGroup) {
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const pixelsPerSecond = 18;
    let frame = 0;
    let last = 0;
    let offset = 0;
    const pauseButton = document.querySelector<HTMLButtonElement>("[data-testimonial-pause]");
    const pauseLabel = pauseButton?.dataset.pauseLabel ?? "Pause";
    const playLabel = pauseButton?.dataset.playLabel ?? "Play";
    let hovering = false;
    let focused = false;
    let touching = false;
    let held = false;
    let onScreen = typeof IntersectionObserver === "undefined";

    const reduced = () => motion.matches;
    const paused = () => reduced() || held || !onScreen || hovering || focused || touching;

    const loopWidth = () => marqueeGroup.offsetWidth;

    const normalize = (value: number) => {
      const width = loopWidth();
      if (width <= 0) return 0;
      const next = value % width;
      return next < 0 ? next + width : next;
    };

    const stop = () => {
      if (!frame) return;
      window.cancelAnimationFrame(frame);
      frame = 0;
    };

    const tick = (now: number) => {
      if (paused()) {
        stop();
        return;
      }
      const delta = last === 0 ? 0 : Math.min(48, now - last);
      last = now;
      offset = normalize(offset + (pixelsPerSecond * delta) / 1000);
      marquee.scrollLeft = offset;
      frame = window.requestAnimationFrame(tick);
    };

    const resume = () => {
      offset = normalize(marquee.scrollLeft);
      if (frame || paused()) return;
      last = 0;
      frame = window.requestAnimationFrame(tick);
    };

    const sync = () => {
      const animate = !reduced();
      marquee.classList.toggle("is-animated", animate);
      if (!animate) {
        stop();
        offset = 0;
        marquee.scrollLeft = 0;
        return;
      }
      resume();
    };

    marquee.addEventListener("pointerenter", () => {
      hovering = true;
      stop();
    });
    marquee.addEventListener("pointerleave", () => {
      hovering = false;
      touching = false;
      resume();
    });
    marquee.addEventListener("pointerdown", () => {
      touching = true;
      stop();
    });
    marquee.addEventListener("pointerup", () => {
      touching = false;
      resume();
    });
    marquee.addEventListener("pointercancel", () => {
      touching = false;
      resume();
    });
    marquee.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      const card = marquee.querySelector<HTMLElement>(".testimonial-card");
      const step = (card?.offsetWidth ?? 280) + 16;
      event.preventDefault();
      marquee.scrollLeft += event.key === "ArrowRight" ? step : -step;
      offset = normalize(marquee.scrollLeft);
    });
    marquee.addEventListener("focusin", () => {
      focused = true;
      stop();
    });
    marquee.addEventListener("focusout", () => {
      focused = false;
      resume();
    });
    pauseButton?.addEventListener("click", () => {
      held = !held;
      pauseButton.classList.toggle("is-paused", held);
      pauseButton.setAttribute("aria-label", held ? playLabel : pauseLabel);
      pauseButton.title = held ? playLabel : pauseLabel;
      if (held) stop();
      else resume();
    });
    motion.addEventListener("change", sync);
    const section = document.getElementById("testimonials");
    if (section && typeof IntersectionObserver !== "undefined") {
      const observer = new IntersectionObserver((entries) => {
        onScreen = entries.some((entry) => entry.isIntersecting);
        if (onScreen) resume();
        else stop();
      });
      observer.observe(section);
    }
    sync();
  }
</script>
