---
import type { Sandbox } from "../sandboxes";
import { sandboxPath } from "../sandboxes";

type Props = {
  sandbox: Sandbox;
};

const { sandbox } = Astro.props;
---

<li>
  <a class="sandbox-card" href={sandboxPath(sandbox.slug)}>
    <picture>
      {sandbox.image.avif && <source type="image/avif" srcset={sandbox.image.avif} />}
      <img
        src={sandbox.image.webp}
        alt=""
        width={sandbox.image.width}
        height={sandbox.image.height}
        loading="lazy"
        decoding="async"
      />
    </picture>
    <span class="sandbox-card__name">{sandbox.name}</span>
    <span class="sandbox-card__meta">{sandbox.bestFor}</span>
  </a>
</li>
