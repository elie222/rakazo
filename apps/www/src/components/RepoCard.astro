---
import type { RecentChange } from "../github";
import type { Locale } from "../i18n/locales";
import { LOCALE_HREFLANG } from "../i18n/locales";
import { GITHUB_URL } from "../site";

type Props = {
  locale: Locale;
  starsLabel: string;
  changes: RecentChange[];
};

const { locale, starsLabel, changes } = Astro.props;
const formatDate = new Intl.DateTimeFormat(LOCALE_HREFLANG[locale], {
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<div class="repo-card">
  <a class="repo-card__head" href={GITHUB_URL} target="_blank" rel="noopener" data-attr="repo-card-github">
    <svg class="repo-card__mark" viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
      ></path>
    </svg>
    <span class="repo-card__name">elie222/rakazo</span>
    <span class="repo-card__meta">★ {starsLabel}</span>
  </a>
  <ol class="repo-card__changes">
    {
      changes.map((change) => (
        <li>
          <a href={change.url} target="_blank" rel="noopener" data-attr="repo-card-change">
            <span class="repo-card__dot" aria-hidden="true" />
            <span class="repo-card__title">{change.title}</span>
            {change.pr && <span class="repo-card__pr">#{change.pr}</span>}
            <time datetime={change.date}>{formatDate.format(new Date(change.date))}</time>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .repo-card {
    overflow: hidden;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-card);
    background: var(--panel);
    color: var(--panel-copy);
    box-shadow: var(--shadow-demo);
    font-size: 14px;
  }

  .repo-card a {
    color: inherit;
  }

  .repo-card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 18px 22px;
    border-bottom: 1px solid var(--panel-line);
  }

  .repo-card__mark {
    width: 20px;
    height: 20px;
    flex: none;
    fill: currentColor;
  }

  .repo-card__name {
    font-weight: 600;
  }

  .repo-card__meta {
    margin-left: auto;
    color: var(--panel-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .repo-card__changes {
    margin: 0;
    padding: 8px 0;
    list-style: none;
  }

  .repo-card__changes a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 22px;
    transition: background 160ms ease;
  }

  .repo-card__changes a:hover,
  .repo-card__changes a:focus-visible {
    background: var(--panel-line);
  }

  .repo-card__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 999px;
    background: var(--success);
  }

  .repo-card__changes li:first-child .repo-card__dot {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--success) 25%, transparent);
  }

  .repo-card__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .repo-card__pr,
  .repo-card__changes time {
    flex: none;
    color: var(--panel-muted);
    font-variant-numeric: tabular-nums;
  }

  .repo-card__changes time {
    width: 52px;
    text-align: right;
  }

  @media (max-width: 720px) {
    .repo-card__pr {
      display: none;
    }
  }
</style>
