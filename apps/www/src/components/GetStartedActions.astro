---
import type { HomeCopy } from "../i18n/home";
import type { DesktopDownloads } from "../github";
import { availableDesktopPlatforms, desktopDownloadHref } from "../github";
import {
  ANDROID_APK_URL,
  APP_URL,
  GITHUB_URL,
  IOS_APP_URL,
} from "../site";

type Props = {
  class: string;
  copy: HomeCopy["hero"];
  /** Omitted where the GitHub link should stay on every platform. */
  downloads?: DesktopDownloads;
  /** PostHog `data-attr` prefix that tells this placement apart from others. */
  placement: string;
  githubLabel?: string;
};

const { class: className, copy, downloads, placement, githubLabel = copy.viewOnGithub } =
  Astro.props;

// `data-show` lists the platforms (set on <html> by the HomePage script) that see each action.
const desktopDownloads = (downloads ? availableDesktopPlatforms(downloads) : []).map((platform) => ({
  platform,
  label: copy.download[platform],
  href: desktopDownloadHref(platform),
}));
const githubPlatforms = ["ios", "android", "web", "mac", "windows", "linux"]
  .filter((platform) => !desktopDownloads.some((download) => download.platform === platform))
  .join(" ");
---

<div class={className}>
  <a class="button button--primary" href={APP_URL} data-show="mac windows linux web">
    {copy.getStarted}
  </a>
  <a class="button button--primary" href={IOS_APP_URL} data-show="ios">{copy.download.ios}</a>
  <a class="button button--primary" href={ANDROID_APK_URL} data-show="android">
    {copy.download.android}
  </a>
  {
    desktopDownloads.map((download) => (
      <a class="button button--secondary" href={download.href} data-show={download.platform}>
        {download.label}
      </a>
    ))
  }
  <a
    class="button button--secondary"
    href={GITHUB_URL}
    target="_blank"
    rel="noopener"
    data-show={githubPlatforms}
    data-attr={`${placement}-github`}
  >
    {githubLabel}
  </a>
</div>
