---
import { getHomeCopy } from "../i18n/home";
import type { HomeCopy } from "../i18n/home";
import { DEFAULT_LOCALE, localeHomePath } from "../i18n/locales";
import type { Locale } from "../i18n/locales";
import { APP_URL, GITHUB_URL } from "../site";
import Logo from "./Logo.astro";

type Props = {
  starsLabel: string;
  locale?: Locale;
  copy?: HomeCopy["nav"];
  homeHref?: string;
};

const { starsLabel } = Astro.props;
const locale = Astro.props.locale ?? DEFAULT_LOCALE;
const copy = Astro.props.copy ?? getHomeCopy(locale).nav;
const homeHref = Astro.props.homeHref ?? localeHomePath(locale);

const NAV_LINKS = [
  { href: "/docs/", label: copy.docs },
  { href: "/integrations/", label: copy.integrations },
  { href: "/blog/", label: copy.blog },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  return (href.replace(/\/+$/, "") || "/") === currentPath;
}
---

<header class="site-header">
  <div class="site-header__left">
    <Logo href={homeHref} label={copy.home} />
    <nav class="site-nav" aria-label={copy.primary}>
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="site-header__right">
    <a
      class="star-pill"
      href={GITHUB_URL}
      target="_blank"
      rel="noopener"
      aria-label={copy.github}
      data-attr="header-github"
    >
      <span aria-hidden="true">★</span>
      <span>{starsLabel}</span>
    </a>
    <div class="site-header__cta">
      <a class="button button--primary button--small" href={APP_URL}>
        {copy.getStarted}
      </a>
    </div>
    <details class="site-menu" data-site-menu>
      <summary class="site-menu__toggle" aria-label={copy.menu}>
        <svg class="site-menu__icon site-menu__icon--open" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" />
        </svg>
        <svg class="site-menu__icon site-menu__icon--close" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </summary>
      <nav class="site-menu__panel" aria-label={copy.primary}>
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <a href={GITHUB_URL} target="_blank" rel="noopener" data-attr="menu-github">{copy.github}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-site-menu]");

  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) menu.open = false;
    });

    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu.open = false;
      }
    });
  }
</script>
