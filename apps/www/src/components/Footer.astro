---
import {
  DEFAULT_LOCALE,
  LOCALE_HREFLANG,
  LOCALE_HTML_LANG,
  LOCALE_LABELS,
  LOCALES,
  isLocale,
  localeHomePath,
  type Locale,
} from "../i18n/locales";
import { HUB_CARDS } from "../alternatives";
import { getHomeCopy } from "../i18n/home";
import type { HomeCopy } from "../i18n/home";
import {
  ANDROID_APK_URL,
  CHANGELOG_URL,
  GITHUB_URL,
  INBOX_ZERO_URL,
  IOS_APP_URL,
  SELF_HOST_GUIDE_PATH,
} from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale?: Locale;
  languagesLabel?: string;
  navLabel?: string;
  homeHref?: string;
  homeLabel?: string;
  linkLabels?: HomeCopy["footer"]["links"];
};

const currentLocale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : (Astro.props.locale ?? DEFAULT_LOCALE);
const localeCopy = getHomeCopy(currentLocale);

const {
  languagesLabel = localeCopy.footer.languagesLabel,
  navLabel = localeCopy.footer.navLabel,
  homeHref = localeHomePath(currentLocale),
  homeLabel = localeCopy.nav.home,
  linkLabels = localeCopy.footer.links,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrentPage(href: string): boolean {
  return (href.replace(/\/+$/, "") || "/") === currentPath;
}

type FooterLink = { href: string; label: string; external?: boolean };

const columns: Array<{ heading: string; links: FooterLink[] }> = [
  {
    heading: linkLabels.product,
    links: [
      { href: IOS_APP_URL, label: linkLabels.iosApp, external: true },
      { href: ANDROID_APK_URL, label: linkLabels.androidApp },
      { href: SELF_HOST_GUIDE_PATH, label: linkLabels.docs },
      { href: CHANGELOG_URL, label: linkLabels.changelog, external: true },
      { href: GITHUB_URL, label: "GitHub", external: true },
    ],
  },
  {
    heading: linkLabels.alternatives,
    links: [
      ...HUB_CARDS.map((card) => ({ href: card.href, label: card.name })),
      { href: "/alternatives/", label: linkLabels.all },
    ],
  },
  {
    heading: linkLabels.company,
    links: [
      { href: "/blog/", label: linkLabels.blog },
      { href: "/about/", label: linkLabels.about },
      { href: "/support/", label: linkLabels.support },
      { href: "/privacy/", label: linkLabels.privacy },
      { href: "/terms/", label: linkLabels.terms },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo href={homeHref} label={homeLabel} />
    <nav class="site-footer__languages" aria-label={languagesLabel}>
      <details class="language-menu">
        <summary>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
          {LOCALE_LABELS[currentLocale]}
          <svg class="language-menu__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </summary>
        <ul>
          {
            LOCALES.map((locale) => (
              <li>
                <a
                  href={localeHomePath(locale)}
                  hreflang={LOCALE_HREFLANG[locale]}
                  lang={LOCALE_HTML_LANG[locale]}
                  aria-current={locale === currentLocale ? "true" : undefined}
                >
                  {LOCALE_LABELS[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
    <span class="site-footer__legal">
      <span>© 2026 <a href={INBOX_ZERO_URL} target="_blank" rel="noopener">Inbox Zero Inc.</a></span>
      <span>Apache-2.0</span>
    </span>
  </div>
  <nav class="site-footer__columns" aria-label={navLabel}>
    {
      columns.map((column) => (
        <div class="site-footer__column">
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={!link.external && isCurrentPage(link.href) ? "page" : undefined}
                  {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</footer>
