---
import { richParts } from "../grok-alternative";

type Props = {
  text: string;
};

const { text } = Astro.props;
const parts = richParts(text);
---

{
  parts.map((part) =>
    part.kind === "link" ? (
      <a
        href={part.href}
        {...(part.href.startsWith("http") && !part.href.startsWith("https://rakazo.com")
          ? { target: "_blank", rel: "nofollow noopener noreferrer" }
          : {})}
      >
        {part.label}
      </a>
    ) : (
      part.value
    ),
  )
}
