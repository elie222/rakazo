---
import type { HomeCopy } from "../i18n/home";

interface Props {
  kind: "model" | "schedule" | "approval";
  labels: HomeCopy["selfHost"]["mock"];
}

const { kind, labels } = Astro.props;
// Familiar app surfaces: model picker, routine schedule, approval.
---

<div class:list={["feature-illustration", `feature-illustration--${kind}`]} aria-hidden="true">
  {kind === "model" ? (
    <div class="mini-window">
      <span class="mini-label">{labels.model}</span>
      <div class="mini-picker"><span>Claude Sonnet <b>✓</b></span><span>⌄</span></div>
      <div class="mini-option"><span>○</span> GPT</div>
    </div>
  ) : kind === "schedule" ? (
    <div class="mini-window mini-schedule">
      <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M7 3v4m10-4v4M3 11h18m-14 5h4" /></svg>
      <span>{labels.weekdays}</span><span class="mini-toggle"><i /></span>
    </div>
  ) : (
    <div class="mini-window">
      <span class="mini-label">{labels.approval}</span>
      <div class="mini-approval"><span>{labels.deny}</span><span>{labels.approve} ✓</span></div>
    </div>
  )}
</div>

<style>
  .feature-illustration {
    height: 144px;
    margin: -26px -26px 24px;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(120% 100% at 50% 100%, var(--accent-soft), var(--surface-soft) 85%);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    user-select: none;
    pointer-events: none;
    font-size: 12px;
    line-height: 1.4;
  }
  .feature-illustration--model { --accent: var(--coral); --accent-soft: var(--coral-soft); }
  .feature-illustration--schedule { --accent: var(--indigo); --accent-soft: var(--indigo-soft); }
  .feature-illustration--approval { --accent: var(--green); --accent-soft: var(--green-soft); }
  .mini-window {
    width: 100%;
    max-width: 240px;
    padding: 14px;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow-soft);
  }
  .mini-label { display: block; margin-bottom: 9px; color: var(--muted-2); font-size: 11px; }
  .mini-picker, .mini-option, .mini-approval, .mini-schedule { display: flex; align-items: center; gap: 10px; }
  .mini-picker { justify-content: space-between; padding: 7px 9px; border: 1px solid var(--accent); border-radius: 6px; box-shadow: 0 0 0 3px var(--accent-soft); }
  .mini-picker b { color: var(--accent); font-weight: inherit; }
  .mini-option { padding: 8px 9px 0; color: var(--muted-2); }
  .mini-schedule { max-width: 270px; padding: 16px 12px; }
  .mini-schedule > span:nth-child(2) { flex: 1; }
  .mini-schedule svg { color: var(--accent); }
  svg { flex: none; width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .mini-toggle { display: flex; flex: none; justify-content: flex-end; width: 28px; padding: 3px; border-radius: 20px; background: var(--accent); }
  .mini-toggle i { width: 10px; height: 10px; border-radius: 50%; background: var(--surface); }
  .mini-approval > span { flex: 1; padding: 7px 4px; border: 1px solid var(--line-2); border-radius: 6px; text-align: center; }
  .mini-approval > span:last-child { background: var(--accent); color: var(--surface); border-color: var(--accent); }
</style>
