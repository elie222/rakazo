---
import type { PricingPlan } from "../pricing";
import Button from "./Button.astro";

type Props = {
  plan: PricingPlan;
  primary?: boolean;
  attr: string;
};

const { plan, primary = false, attr } = Astro.props;
---

<section class="feature-card pricing__plan">
  <h2>{plan.name}</h2>
  <p class="pricing__price">{plan.price}</p>
  <p class="pricing__note">{plan.note}</p>
  <ul>
    {plan.features.map((feature) => <li>{feature}</li>)}
  </ul>
  <Button href={plan.action.href} variant={primary ? "primary" : "secondary"} data-attr={attr}>
    {plan.action.label}
  </Button>
</section>
