---
import "../styles/global.css";
import { getMarkdownAlternate } from "../agent-content";
import type { ArticleMeta } from "../blog/format";
import {
  DEFAULT_LOCALE,
  LOCALE_HREFLANG,
  LOCALE_HTML_LANG,
  LOCALE_OG,
  isLocale,
  RTL_LOCALES,
  type Locale,
} from "../i18n/locales";
import { pageVersions } from "../i18n/translations";
import { SITE_NAME, SITE_URL } from "../site";

type Props = {
  title?: string;
  description: string;
  structuredData?: object;
  locale?: Locale;
  skipLabel?: string;
  ogImageAlt?: string;
  /** Path or absolute URL. Defaults to the shared homepage image. */
  ogImage?: string;
  article?: ArticleMeta;
  /** False on the not-found page: noindex, and no canonical URL. */
  index?: boolean;
  /** For prerendered pages the edge middleware does not know about. */
  markdownAlternate?: string;
};

const {
  title = SITE_NAME,
  description,
  structuredData,
  skipLabel = "Skip to content",
  ogImageAlt = "Rakazo. AI teammates you actually own. Your keys, your model, your machine.",
  ogImage = "/og-image.png",
  article,
  index = true,
} = Astro.props;

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : (Astro.props.locale ?? DEFAULT_LOCALE);

const canonical = index ? new URL(Astro.url.pathname, SITE_URL).toString() : undefined;
const robots = index ? "index, follow, max-image-preview:large" : "noindex";
const socialImage = new URL(ogImage, SITE_URL).toString();
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : null;
const markdownAlternate =
  Astro.props.markdownAlternate ?? getMarkdownAlternate(Astro.url.pathname);
const htmlLang = LOCALE_HTML_LANG[locale];
const ogLocale = LOCALE_OG[locale];
const versions = pageVersions(Astro.url.pathname).map((version) => ({
  ...version,
  url: new URL(version.path, SITE_URL).toString(),
}));
const englishVersion = versions.find((version) => version.locale === DEFAULT_LOCALE);
---

<!doctype html>
<html lang={htmlLang} dir={RTL_LOCALES.has(locale) ? "rtl" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#FDFDFD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={ogLocale} />
    {
      versions
        .filter((version) => version.locale !== locale)
        .map((version) => (
          <meta property="og:locale:alternate" content={LOCALE_OG[version.locale]} />
        ))
    }
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={article.modified.toISOString()} />
          <meta property="article:author" content={article.authorUrl} />
        </>
      )
    }
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {canonical && <link rel="canonical" href={canonical} />}
    {versions.map((version) => (
      <link rel="alternate" hreflang={LOCALE_HREFLANG[version.locale]} href={version.url} />
    ))}
    {englishVersion && <link rel="alternate" hreflang="x-default" href={englishVersion.url} />}
    {markdownAlternate && (
      <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    )}
    <link rel="alternate" type="application/rss+xml" title="Rakazo blog" href="/blog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <link rel="ai-catalog" type="application/ai-catalog+json" href="/.well-known/ai-catalog.json" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="128x128" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&family=Geist+Mono:wght@400..600&display=swap"
      rel="stylesheet"
    />
    {structuredDataJson && <script is:inline type="application/ld+json" set:html={structuredDataJson} />}
    <title>{title}</title>
    <script>
      import "../analytics";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <div class="page-shell">
      <slot />
    </div>
  </body>
</html>
