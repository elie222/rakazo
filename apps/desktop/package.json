{
  "name": "@rakazo/desktop",
  "productName": "Rakazo",
  "version": "0.3.6",
  "author": {
    "name": "Rakazo"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node scripts/build.mjs && node scripts/copy-static.mjs && node scripts/build-speech.mjs",
    "pack": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.jsdom.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @rakazo/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@rakazo/contracts": "workspace:*",
    "@rakazo/logging": "workspace:*",
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.11",
    "koffi": "3.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@rakazo/adapters": "workspace:*",
    "@rakazo/ui-tokens": "workspace:*",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "dev.rakazo.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "name": "rakazo",
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "../../packages/ui-tokens/assets/Rakazo.icon",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "{**/node_modules/@koromix/koffi-darwin-*/darwin_*/koffi.node,**/node_modules/@oxc-parser/binding-darwin-*/parser.darwin-*.node}",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Rakazo uses the microphone for dictation and voice calls with your bots.",
        "NSSpeechRecognitionUsageDescription": "Rakazo turns what you say into text for dictation and voice calls with your bots."
      },
      "extraResources": [
        {
          "from": "build/speech/rakazo-speech",
          "to": "speech/rakazo-speech"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "dmg": {
      "title": "${productName}",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 175,
          "type": "file"
        },
        {
          "x": 490,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "rakazo",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "elie222",
        "repo": "rakazo"
      }
    ]
  }
}
