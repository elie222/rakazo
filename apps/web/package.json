    "@rakazo/contracts": "workspace:*",
    "@rakazo/core": "workspace:*",
    "@rakazo/ui-tokens": "workspace:*",
    "@rakazo/ui-web": "workspace:*",
    "@sentry/react": "11.10.0",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/react-query": "5.105.3",
    "better-auth": "1.7.16",
    "lucide-react": "1.68.0",
    "react": "19.2.3",
