  externalTranscriptFor  ExternalMessage?
  steeringMessages SteeringMessage[]
  createdAt        DateTime  @default(now())

  @@unique([threadId, seq])
  @@unique([threadId, clientNonce])
  @@index([replyToMessageId])
  @@index([runId, seq])
  @@index([searchTokens], type: Gin)
  @@map("messages")
}

