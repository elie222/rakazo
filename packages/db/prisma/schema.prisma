model Computer {
  screenGeneration Int @default(0)
  id                      String                   @id @default(cuid())
  spaceId                 String
  space                   Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                  String
  scope                   String                   @default("team")
  scopeKey                String                   @unique
  homeKey                 String                   @unique
  homeRevision            String                   @default("empty")
  /// When the sandbox was read for `homeRevision`; null when an older release saved it.
  homeRevisionAt          DateTime?
  /// When a damaged system last made Rakazo stop and start the computer by itself. Tried once
  /// until a later save shows the computer works again.
  autoRecoveredAt         DateTime?
  /// The machine at `providerRef` came from a start whose restore never finished, so it holds no
  /// full copy of the saved home: nothing is saved from it, and the next start restores it.
  restorePending          Boolean                  @default(false)
  /// Object storage only: random id naming the home's objects, its data key (wrapped by the
  /// space key) and the revision stored there. Deleting the computer deletes the key.
  homeStorageId           String?                  @unique
  homeStorageKey          String?
  homeStorageRevision     String?
  kind                    String
  providerRef             String?
  state                   String                   @default("stopped")
  controlHolder           String                   @default("none")
  controlLeaseId          String?
  controlLeaseExpiresAt   DateTime?
  controlBotId            String?
  controlRunId            String?
  controlFence            Int                      @default(0)
  executionRunId          String?
  executionBotId          String?
  executionLeaseExpiresAt DateTime?
  executionFence          Int                      @default(0)
  screenUrl               String?
  /// When the computer last started running; bounds how long it can stay up in one stretch.
  runningSince            DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bots                    Bot[]
  executionLeases         ComputerExecutionLease[]
  maintenanceId           String?
  updates                 ComputerUpdate[]

  @@index([spaceId, scope])
  @@map("computers")
}

/// One stretch a computer ran at its provider, from `computers.runningSince` until it stopped,
/// attributed to the computer's owning user and space. Run time is what sandbox providers bill.
///
/// `computerId` is deliberately not a relation, so the row outlives a deleted computer. Deleting
/// the user or space anonymises the row instead of erasing the run time it records.
model ComputerRun {
  id         String    @id @default(cuid())
  computerId String
  spaceId    String?
  space      Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The provider kind, such as docker or e2b.
  kind       String
  /// The provider's id for the sandbox, to match runs with the provider's own usage and billing.
  providerRef String?
  startedAt  DateTime
  /// Null while running. When the end was not seen as it happened, this is when it was detected.
  endedAt    DateTime?
  /// How it ended; see `ComputerRunEnd` in packages/db/src/computer-runs.ts.
  endReason  String?
  /// When Rakazo last saw this stretch running: at its start and at each idle check.
  lastSeenAt DateTime?

  @@unique([computerId, startedAt])
  @@index([spaceId, userId, startedAt])
  // computer_runs_open_idx (open runs by computer) is raw SQL: Prisma cannot express partial indexes.
  @@map("computer_runs")
}

