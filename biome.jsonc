{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/design",
      "!**/packages/db/src/generated",
      "!**/apps/mobile/.expo",
      "!**/playwright-report",
      "!**/test-results",
      "!**/test-report",
      "!**/verify-report",
      "!**/data",
      "!**/*.astro",
      "!**/apps/www"
    ]
  },
  "plugins": [
    {
      "path": "./scripts/biome/no-hex-colors.grit",
      "includes": [
        "**/apps/web/src/**/*.tsx",
        "**/packages/ui-web/src/**/*.tsx",
        "**/apps/mobile/**/*.tsx",
        "**/packages/chat-ui/**/*.tsx",
        "!**/*.test.tsx",
        "!**/packages/ui-web/src/bot-avatar.tsx",
        "!**/apps/mobile/components/bot-avatar.tsx",
        "!**/apps/web/src/pages/WindowChrome.tsx"
      ]
    },
    {
      "path": "./scripts/biome/no-css-var-arbitrary-values.grit",
      "includes": ["**/apps/web/src/**/*.tsx", "**/packages/ui-web/src/**/*.tsx"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": { "level": "error", "options": { "style": "separatedType" } },
        // An override replaces this rule's options instead of adding to them, so every override
        // of it below repeats the vendor group. Keep the copies identical.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@{alicloud,aws-sdk,axiomhq,boatdev,boxd-sh,chat-adapter}/**",
                  "@{composio,darabonba,daytona,e2b,insforge,kubernetes}/**",
                  "@{larksuiteoapi,opentelemetry,photon-ai,sentry,stripe}/**",
                  "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}",
                  "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}/**"
                ],
                "message": "This is a vendor SDK. Extend the provider-neutral interface in `@rakazo/adapter-kit`, implement it in `packages/adapters`, and load the SDK there with `import()`."
              }
            ]
          }
        }
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**", "packages/chat-ui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              // Our components that render string children inside a Text.
              "options": { "skip": ["SvgText", "ChatMarkdown", "LinkifiedText", "SettingsLabel"] }
            }
          }
        }
      }
    },
    {
      // Tests render mocked React Native through react-dom, so raw text there never reaches a
      // native view, and harness components are created once per test, not on each render.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off",
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui-web/src/components/ui/**", "packages/ui-web/src/shadcn.css"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "useKeyWithClickEvents": "off",
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/**",
        "apps/worker/**",
        "infra/sandboxes/supervisor/**",
        "infra/updater/**",
        "packages/adapters/**",
        "packages/db/**",
        "packages/logging/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/logging/src/console-sink.ts", "packages/logging/src/sink-guard.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    // Client code: no vendor SDKs and no server packages.
    {
      "includes": [
        "apps/web/src/**",
        "apps/mobile/**",
        "packages/ui-web/**",
        "packages/chat-ui/**",
        "packages/page-kit/**",
        "!apps/web/src/preview-middleware.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@{alicloud,aws-sdk,axiomhq,boatdev,boxd-sh,chat-adapter}/**",
                      "@{composio,darabonba,daytona,e2b,insforge,kubernetes}/**",
                      "@{larksuiteoapi,opentelemetry,photon-ai,sentry,stripe}/**",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}/**"
                    ],
                    "message": "This is a vendor SDK. Extend the provider-neutral interface in `@rakazo/adapter-kit`, implement it in `packages/adapters`, and load the SDK there with `import()`."
                  },
                  {
                    "group": [
                      "@rakazo/{adapter-kit,adapters,auth,db,memory,testkit}",
                      "@rakazo/{adapter-kit,adapters,auth,db,memory,testkit}/**"
                    ],
                    "message": "Client code cannot import server packages. The API owns this logic: add it in `apps/api` and call it over RPC, with shared types in `@rakazo/contracts`."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Client tests may use the test kit.
    {
      "includes": [
        "apps/web/src/**/*.test.{ts,tsx}",
        "apps/mobile/**/*.test.{ts,tsx}",
        "packages/ui-web/**/*.test.{ts,tsx}",
        "packages/chat-ui/**/*.test.{ts,tsx}",
        "packages/page-kit/**/*.test.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@{alicloud,aws-sdk,axiomhq,boatdev,boxd-sh,chat-adapter}/**",
                      "@{composio,darabonba,daytona,e2b,insforge,kubernetes}/**",
                      "@{larksuiteoapi,opentelemetry,photon-ai,sentry,stripe}/**",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}/**"
                    ],
                    "message": "This is a vendor SDK. Extend the provider-neutral interface in `@rakazo/adapter-kit`, implement it in `packages/adapters`, and load the SDK there with `import()`."
                  },
                  {
                    "group": [
                      "@rakazo/{adapter-kit,adapters,auth,db,memory}",
                      "@rakazo/{adapter-kit,adapters,auth,db,memory}/**"
                    ],
                    "message": "Client code cannot import server packages. The API owns this logic: add it in `apps/api` and call it over RPC, with shared types in `@rakazo/contracts`."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Packages every other package may depend on.
    {
      "includes": ["packages/contracts/**", "packages/ui-tokens/**", "packages/logging/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@{alicloud,aws-sdk,axiomhq,boatdev,boxd-sh,chat-adapter}/**",
                      "@{composio,darabonba,daytona,e2b,insforge,kubernetes}/**",
                      "@{larksuiteoapi,opentelemetry,photon-ai,sentry,stripe}/**",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}/**"
                    ],
                    "message": "This is a vendor SDK. Extend the provider-neutral interface in `@rakazo/adapter-kit`, implement it in `packages/adapters`, and load the SDK there with `import()`."
                  },
                  {
                    "group": ["@rakazo/**"],
                    "message": "This package sits at the bottom of the dependency graph and cannot import other `@rakazo/*` packages. Pass what it needs in as an argument, or move the code up to the package that depends on both."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@{alicloud,aws-sdk,axiomhq,boatdev,boxd-sh,chat-adapter}/**",
                      "@{composio,darabonba,daytona,e2b,insforge,kubernetes}/**",
                      "@{larksuiteoapi,opentelemetry,photon-ai,sentry,stripe}/**",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}",
                      "{chat-adapter-sendblue,mppx,novita-sandbox,railway,sendblue}/**"
                    ],
                    "message": "This is a vendor SDK. Extend the provider-neutral interface in `@rakazo/adapter-kit`, implement it in `packages/adapters`, and load the SDK there with `import()`."
                  },
                  {
                    "group": [
                      "@rakazo/**",
                      "!@rakazo/{contracts,ui-tokens}",
                      "!@rakazo/{contracts,ui-tokens}/**"
                    ],
                    "message": "`@rakazo/core` may import only `@rakazo/contracts` and `@rakazo/ui-tokens`. Pass other dependencies in as arguments, or move the code to the package that owns them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Monitoring and logging sinks load their vendor SDK on demand; the layering rules above
    // still apply to them.
    {
      "includes": ["apps/web/src/lib/monitoring.ts", "apps/mobile/lib/monitoring.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@rakazo/{adapter-kit,adapters,auth,db,memory,testkit}",
                      "@rakazo/{adapter-kit,adapters,auth,db,memory,testkit}/**"
                    ],
                    "message": "Client code cannot import server packages. The API owns this logic: add it in `apps/api` and call it over RPC, with shared types in `@rakazo/contracts`."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/logging/src/sentry.ts",
        "packages/logging/src/sentry.test.ts",
        "packages/logging/src/axiom-sink.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@rakazo/**"],
                    "message": "This package sits at the bottom of the dependency graph and cannot import other `@rakazo/*` packages. Pass what it needs in as an argument, or move the code up to the package that depends on both."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Adapters are where vendor SDKs live. The desktop monitoring sink and the screenshot
    // publisher load theirs on demand.
    {
      "includes": [
        "packages/adapters/**",
        "apps/desktop/src/monitoring.ts",
        "packages/testkit/src/cli/ios-screenshot-publish.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
