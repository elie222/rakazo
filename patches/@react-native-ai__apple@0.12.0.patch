diff --git a/ios/transcription/TaughtWords.swift b/ios/transcription/TaughtWords.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a16da901f93d181288aa0d6c3454675303e7a6e4
--- /dev/null
+++ b/ios/transcription/TaughtWords.swift
@@ -0,0 +1,128 @@
+import Foundation
+
+/// One run of transcribed text and the audio it was heard in. Runs without a time range
+/// (spacing, punctuation) carry a negative start and are never replaced.
+struct HeardRun: Equatable, Sendable {
+  var text: String
+  let start: Double
+  let end: Double
+  /// The transcriber result the run belongs to, so segments can be rebuilt after a swap.
+  let segment: Int
+}
+
+/// Puts taught words into the long-form transcript. The short-form dictation model honors a
+/// list of words to listen for, but transcribes ordinary speech worse, so it only says where a
+/// taught word was heard: the long-form runs at that time are swapped for it when their
+/// spelling is close, and every other word stays as the long-form model heard it.
+enum TaughtWords {
+  /// Below this, the long-form words at that time are likely a different word, and stay.
+  static let minimumSimilarity = 0.4
+
+  static func apply(to runs: [HeardRun], dictated: [HeardRun], taught: [String]) -> [HeardRun] {
+    var out = runs
+    for heard in taughtWordsHeard(in: dictated, taught: taught) {
+      // Timing narrows the place; spelling picks the runs within it, so a neighbour the
+      // dictation range swallowed stays.
+      let hits = out.indices.filter {
+        guard out[$0].start >= 0 else { return false }
+        let middle = (out[$0].start + out[$0].end) / 2
+        return middle > heard.start && middle < heard.end
+      }
+      var best: (first: Int, last: Int, score: Double)?
+      for first in hits {
+        for last in hits where last >= first {
+          let score = similarity(key(out[first...last].map(\.text).joined()), key(heard.text))
+          if score > (best?.score ?? -1) { best = (first, last, score) }
+        }
+      }
+      guard let best, best.score >= minimumSimilarity else { continue }
+      // Spacing and punctuation around the matched words, such as "(" and ", ", stay as heard;
+      // punctuation the taught word itself starts or ends with (".github") belongs to it.
+      let word = heard.text
+      let joined = out[best.first...best.last].map(\.text).joined()
+      var lead = joined.prefix { $0.isWhitespace || $0.isPunctuation }
+      let leadMarks = lead.drop { $0.isWhitespace }
+      if let owned = (0...leadMarks.count).reversed().first(where: { word.hasPrefix(leadMarks.suffix($0)) }) {
+        lead = lead.dropLast(owned)
+      }
+      let rest = joined.dropFirst(lead.count)
+      var tail = Substring(rest.reversed().prefix { $0.isWhitespace || $0.isPunctuation }.reversed())
+      let tailMarks = tail.prefix { !$0.isWhitespace }
+      if let owned = (0...tailMarks.count).reversed().first(where: { word.hasSuffix(tailMarks.prefix($0)) }) {
+        tail = tail.dropFirst(owned)
+      }
+      let current = rest.dropLast(tail.count)
+      if current == word { continue }
+      // A plain taught word that is also ordinary speech ("Will", "every day") keeps the long-form
+      // casing and spacing; only a styled name ("PlatoChat", "gh-dash") restyles the same letters.
+      if key(String(current)) == key(word) && !isStyled(word) { continue }
+      out.replaceSubrange(
+        best.first...best.last,
+        with: [
+          HeardRun(
+            text: lead + word + tail,
+            start: out[best.first].start,
+            end: out[best.last].end,
+            segment: out[best.first].segment
+          )
+        ]
+      )
+    }
+    return out
+  }
+
+  /// Each taught word or phrase the dictation model heard, with the audio it spans. A phrase
+  /// such as a full name can arrive as one run per word, so the longest match wins.
+  static func taughtWordsHeard(in dictated: [HeardRun], taught: [String]) -> [HeardRun] {
+    let byKey = Dictionary(taught.map { (key($0), $0) }, uniquingKeysWith: { first, _ in first })
+    // A taught word can arrive split into pieces ("GH" + "Dash"), and a phrase one run per word.
+    let longest = taught.map { $0.split(whereSeparator: \.isWhitespace).count }.max().map { $0 + 3 } ?? 1
+    let timed = dictated.filter { $0.start >= 0 && !key($0.text).isEmpty }
+    var found: [HeardRun] = []
+    var index = 0
+    while index < timed.count {
+      var length = min(longest, timed.count - index)
+      while length > 0 {
+        let span = timed[index..<index + length]
+        if let word = byKey[key(span.map(\.text).joined())] {
+          found.append(HeardRun(text: word, start: span.first!.start, end: span.last!.end, segment: 0))
+          break
+        }
+        length -= 1
+      }
+      index += max(length, 1)
+    }
+    return found
+  }
+
+  /// Written in a way speech alone does not give: punctuation, or a capital inside the word.
+  static func isStyled(_ word: String) -> Bool {
+    let characters = Array(word)
+    return characters.contains { $0.isPunctuation }
+      || zip(characters, characters.dropFirst()).contains { $0.isLowercase && $1.isUppercase }
+  }
+
+  /// Letters and digits only, lowercased: "GH Dash", "gh-dash" and "ghdash" are one key.
+  static func key(_ text: String) -> String {
+    String(text.lowercased().filter { $0.isLetter || $0.isNumber })
+  }
+
+  /// One minus the edit distance over the longer length: 1 is the same, 0 shares nothing.
+  static func similarity(_ a: String, _ b: String) -> Double {
+    let a = Array(a), b = Array(b)
+    if a.isEmpty || b.isEmpty { return 0 }
+    var previous = Array(0...b.count)
+    for i in 1...a.count {
+      var current = [i] + Array(repeating: 0, count: b.count)
+      for j in 1...b.count {
+        current[j] = min(
+          previous[j] + 1,
+          current[j - 1] + 1,
+          previous[j - 1] + (a[i - 1] == b[j - 1] ? 0 : 1)
+        )
+      }
+      previous = current
+    }
+    return 1 - Double(previous[b.count]) / Double(max(a.count, b.count))
+  }
+}
