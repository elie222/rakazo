+      if let dictated = try? await dictatedTask?.value {
+        runs = TaughtWords.apply(to: runs, dictated: dictated, taught: words)
+        for index in collected.indices {
+          let text = runs.filter { $0.segment == index }.map(\.text).joined()
+          collected[index] = CollectedSegment(
+            text: text,
+            startSecond: collected[index].startSecond,
+            endSecond: collected[index].endSecond
+          )
+        }
+      }
+      let segments: [[String: Any]] = collected.map { segment in
+        [
+          "text": segment.text,
+          "startSecond": segment.startSecond,
+          "endSecond": segment.endSecond
