# Copy to .env next to docker-compose.images.yml.
# install-images.sh creates that file and fills the required secrets automatically.

POSTGRES_USER=rakazo
POSTGRES_PASSWORD=
POSTGRES_DB=rakazo
# The app's own database login, subject to row-level security.
POSTGRES_APP_PASSWORD=

BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Optional content master keys, active first: id:key,older-id:key. See docs/content-encryption.md.
ENCRYPTION_MASTER_KEYS=
# Optional: aws-kms wraps content keys with a key that never leaves AWS KMS. See docs/content-encryption.md.
MASTER_KEY_PROVIDER=local
AWS_KMS_KEY_ARN=
AWS_KMS_ACCESS_KEY_ID=
AWS_KMS_SECRET_ACCESS_KEY=
# on encrypts new content at rest. off stores it readable in the database; existing
# ciphertext still reads. See docs/self-host-storage.md#content-encryption.
CONTENT_ENCRYPTION=on
# Optional: keep bot homes in an S3-compatible bucket instead of only under DATA_DIR.
# Set the bucket to turn it on. See docs/self-host-storage.md#bot-homes-in-object-storage.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=
OBJECT_STORAGE_PATH_STYLE=
# Optional credential storage. See docs/infisical-secrets.md.
SECRET_STORE=encrypted
INFISICAL_URL=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=
INFISICAL_FOLDER=
SCREEN_PROXY_SECRET=
# Distinct from BETTER_AUTH_SECRET. Required for local Docker computers.
SANDBOX_SUPERVISOR_TOKEN=

# Public origin the browser uses. For a VPS, put TLS in front of :5173 and use https://…
# Host reverse-proxy snippet: docs/self-host.md (Published images).
# Vite preview allowlists RAKAZO_HOST. For that host TLS proxy you must set RAKAZO_HOST
# to the public hostname (e.g. app.example.com); do not leave localhost.
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
# Optional Compose web bind address; use 0.0.0.0 for LAN access (docs/self-host-clients.md).
RAKAZO_WEB_BIND=127.0.0.1
API_URL=http://127.0.0.1:5173
RAKAZO_HOST=localhost
# Optional https:// origins added to the web Content-Security-Policy, space-separated, for a
# script your CDN injects (for example analytics). See docs/self-host-clients.md#content-security-policy.
# RAKAZO_CSP_SCRIPT_SRC=https://static.example.com
# RAKAZO_CSP_CONNECT_SRC=https://beacon.example.com

SIGNUPS_ENABLED=true
# Per-file upload limit in MiB (positive integer; default 10).
MAX_UPLOAD_SIZE_MB=10
# Empty keeps the stored allowlist. A non-empty list is applied on every API start.
SIGNUP_ALLOWLIST=

# Optional. Needed only when the Expo project enables enhanced push security.
EXPO_ACCESS_TOKEN=

# Optional password-recovery email. Both Resend and Amazon SES provide SMTP credentials.
SMTP_URL=
EMAIL_FROM=
EMAIL_REPLY_TO=
WELCOME_EMAIL_ENABLED=

# Restricted-network / registry-mirror escape hatch: override these four when
# GHCR is unreachable. Keep app + computer on the same mirror. Defaults stay GHCR.
# edge tracks main (amd64 + arm64). Pin a published release tag when you need a fixed version.
RAKAZO_IMAGE=ghcr.io/elie222/rakazo/app
RAKAZO_IMAGE_TAG=edge
RAKAZO_COMPUTER_IMAGE=ghcr.io/elie222/rakazo/computer
RAKAZO_COMPUTER_IMAGE_TAG=edge

# Optional Hub postgres/busybox overrides for published-images compose.
# Unset keeps Docker Hub defaults (digest-pinned postgres:16, busybox:1).
# On restricted networks, point these at a mirror that already has the images:
# POSTGRES_IMAGE=registry.example.com/library/postgres:16
# BUSYBOX_IMAGE=registry.example.com/library/busybox:1

# docker = local computers via the in-stack supervisor (default). Optional remote: e2b, daytona, boat.
# none boots the UI without computers when Docker/supervisor is not configured.
SANDBOX_PROVIDER=docker
# restricted: public-internet egress only (no host, LAN, or cloud-metadata access), enforced by
# infra/compose/restrict-computer-egress.sh on the host. install-images.sh installs it and sets
# this, or sets open where the rules cannot run. Unset (auto) is restricted when the rules are
# installed and open otherwise.
# SANDBOX_COMPUTER_EGRESS=restricted
# Public DNS server IPs for computers when restricted egress blocks a private resolver
# (Docker older than 28 with a private host resolver, or a private daemon `dns`).
# SANDBOX_COMPUTER_DNS=1.1.1.1,1.0.0.1
# Docker sandboxes only. Host directories mounted into every bot computer in every Space, as
# comma-separated source:target[:rw][:rslave] entries, read-only unless rw. Targets sit below /mnt,
# /media or /srv. For a network share that can be remounted, mount it below a stable source
# directory and add rw:rslave. See docs/self-host-docker-computers.md.
# SANDBOX_COMPUTER_MOUNTS=/srv/shared:/mnt/shared
# E2B_API_KEY=
# DAYTONA_API_KEY=
# BOAT_API_KEY=

# Optional model / integration keys
OPENROUTER_API_KEY=
COMPOSIO_API_KEY=
# Optional Auto Review verifier (default: deployment/user LLM).
# RAKAZO_AUTO_REVIEW_PROVIDER=jev
# TYPESAFE_API_KEY=
# Comma-separated model ids on centrally managed local / openai-compatible endpoints that accept images.
# User-connected OpenAI-compatible models use the per-connection Supports images setting instead.
# Declared ids get input ["text","image"] so screenshot computer tools stay available.
RAKAZO_LOCAL_VISION_MODELS=
RAKAZO_OPENAI_COMPATIBLE_VISION_MODELS=
# Set to 0 to block user-connected public OpenAI-compatible hosts.
# RAKAZO_OPENAI_COMPAT_ALLOW_PUBLIC=0
# Exact trusted model hostnames resolving only to private IPs (no URLs or wildcards).
# RAKAZO_OPENAI_COMPAT_PRIVATE_HOSTS=models.example.test
# Loopback / LAN / Docker-network MCP servers, API connectors, and OpenAI-compatible
# model and speech servers for every user. No app account bypasses this policy. Leave unset on public installs.
# MCP_ALLOW_PRIVATE_ENDPOINT=true
# Optional integrations.sh-compatible catalog base URL (Rakazo appends api/search).
# Example: https://integrations.sh/ or a self-hosted mirror base, not the full search endpoint.
# INTEGRATIONS_CATALOG_URL=

# Optional outbound HTTP(S) proxy for api/worker containers (Mainland / corporate).
# Leave blank unless you need egress through a proxy. Uppercase or lowercase keys work.
# Include internal Compose names in NO_PROXY (postgres, supervisor, localhost, 127.0.0.1).
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,postgres,supervisor,api,worker,web

# Structured logs. JSON in production. Axiom is optional and disabled unless both are set.
LOG_LEVEL=info
LOG_FORMAT=
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_EDGE=
AXIOM_EDGE_URL=

# Error reporting is off unless a DSN is set.
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
