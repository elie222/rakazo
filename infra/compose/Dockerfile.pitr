# Point-in-time recovery sidecar and restore tool (docs/self-host.md#point-in-time-recovery).
# The same Postgres image as the database, so pg_receivewal, pg_basebackup and the restore server
# match its major version, plus pinned, checksum-verified age and rclone.
ARG POSTGRES_IMAGE=postgres:18@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6

FROM ${POSTGRES_IMAGE} AS tools
ARG TARGETARCH
ARG AGE_VERSION=1.3.2
ARG RCLONE_VERSION=1.75.2
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates curl unzip; \
  case "$TARGETARCH" in \
    amd64) age_sha256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10; \
      rclone_sha256=349ac8fba6ff65d6247043f1750cdcb518ec5d500ef91463a10d37c0ccdf3702 ;; \
    arm64) age_sha256=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4; \
      rclone_sha256=7e1e8d69654941b7b7df84ee74c5f7fb09cce7d5496947fb7bf16b55ff427d10 ;; \
    *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
  esac; \
  cd "$(mktemp -d)"; \
  curl -fsSL -o age.tar.gz "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-${TARGETARCH}.tar.gz"; \
  echo "$age_sha256  age.tar.gz" | sha256sum -c -; \
  tar -xzf age.tar.gz --no-same-owner --strip-components=1 -C /usr/local/bin age/age age/age-keygen; \
  curl -fsSL -o rclone.zip "https://github.com/rclone/rclone/releases/download/v${RCLONE_VERSION}/rclone-v${RCLONE_VERSION}-linux-${TARGETARCH}.zip"; \
  echo "$rclone_sha256  rclone.zip" | sha256sum -c -; \
  unzip -j rclone.zip "rclone-v${RCLONE_VERSION}-linux-${TARGETARCH}/rclone" -d /usr/local/bin; \
  age-keygen | age-keygen -y

FROM ${POSTGRES_IMAGE}
COPY --from=tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=tools /usr/local/bin/age /usr/local/bin/age-keygen /usr/local/bin/rclone /usr/local/bin/
COPY --chmod=755 pitr-agent.sh /usr/local/bin/rakazo-pitr
RUN install -d -o postgres -g postgres -m 700 /var/lib/rakazo-pitr
ENV RCLONE_CONFIG=/dev/null
ENTRYPOINT ["rakazo-pitr"]
CMD ["run"]
