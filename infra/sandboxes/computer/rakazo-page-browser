    .filter((block) => block.querySelector('input[name="link_pay_token"]'));
  const holder = blocks.length !== 1 ? null : blocks[0].matches("[data-stripe-merchant-account]") ? blocks[0]
    : blocks[0].querySelector("[data-stripe-merchant-account]");
