        first ??= problem;
      }
      throw settled(first);
    },
    // After the pointer has moved onto the spot: the page may have reacted by putting something else there.
    // The page's scroll offset comes back too: the browser's own hit-test (check_frame) takes
    // the spot on the page, not in the window.
    stillAimed(ref, x, y) {
      checkLanding(this.resolve(ref), x, y, true);
      return { x: window.pageXOffset, y: window.pageYOffset };
    },
    fill(ref, value, origin, field) {
      // A purchase's card detail, bound to the merchant's origin like a saved login to its site.
      const card = field === "card";
      // Checked in the same evaluation as the fill, so a navigation cannot slip in between.
      // Private-LAN plain HTTP is not a login target, even when the page origin matches.
      if (origin || card) {
        let saved = null;
        try { saved = new URL(origin); } catch { /* rejected below */ }
        if (!saved || saved.protocol !== "https:" || location.protocol !== "https:") {
          throw refused(card
            ? "A card can only be filled on HTTPS. Open the merchant's checkout with browser_navigate, then fill again."
            : "Website logins can only be filled on HTTPS. Open the saved site with browser_navigate, then fill again.");
        }
        if (location.origin !== saved.origin) {
          throw refused(card
            ? "The page is not on the merchant's site for this purchase. Open the merchant's checkout with browser_navigate, then fill again."
            : "The page is not on the site this login was saved for. Open the saved site with browser_navigate, then fill again.");
        }
      }
      const el = this.resolve(ref);
      if (el.readOnly) throw refused("Element is read-only");
      el.focus();
      // After focus, whose handlers may change the field. A password goes only into a password
      // field, which never displays it. A username is an input; textareas, search boxes, and
      // editable page content stay out.
      // A card goes only into a plain input: text, tel, or password (CVC boxes are often masked).
      if (card && !(el instanceof HTMLInputElement && ["text", "tel", "password"].includes(el.type))) {
        throw refused("A card can only be typed into a card field.");
      }
      const password = Boolean(origin) && !card && field !== "username";
      if (password && !(el instanceof HTMLInputElement && el.type === "password")) {
        throw refused("A saved password can only be typed into a password field.");
      }
      if (origin && !card && !password && !(el instanceof HTMLInputElement && ["text", "email", "tel"].includes(el.type))) {
        throw refused("A saved username can only be typed into a text, email, or telephone field.");
      }
      if (el instanceof HTMLSelectElement) {
        chooseOption(el, String(value));
        el.dispatchEvent(new Event("input", { bubbles: true }));
        el.dispatchEvent(new Event("change", { bubbles: true }));
      } else if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
        if (el instanceof HTMLInputElement && !TEXT_INPUT_TYPES.includes(el.type)) {
          throw new Error("Input type requires desktop tools");
        }
        const prototype = el instanceof HTMLInputElement ? HTMLInputElement.prototype : HTMLTextAreaElement.prototype;
        Object.getOwnPropertyDescriptor(prototype, "value").set.call(el, String(value));
        if (el.value !== String(value)) {
          // A partly accepted login (an email field trimming a username) is not left on the page,
          // and desktop tools can't type a saved login either, so it is settled like other refusals.
          if (origin) {
            Object.getOwnPropertyDescriptor(prototype, "value").set.call(el, "");
            throw refused(card ? "This field didn't accept the card, so it was cleared."
              : "This field didn't accept the saved login, so it was cleared.");
          }
          throw new Error("Input did not accept the requested value");
        }
        if (origin) loginFilled.add(el);
        else loginFilled.delete(el);
        // Screenshots reach the model too, so a card is drawn as dots, like a password.
        if (card) maskCard(el);
        else unmaskCard(el);
        el.dispatchEvent(new Event("input", { bubbles: true }));
        el.dispatchEvent(new Event("change", { bubbles: true }));
      } else if (el.isContentEditable) {
        // Let Chromium deliver beforeinput and native editing, including editor cancellation.
        // Select the existing content so one Input.insertText replaces it, even for long text.
        const range = document.createRange();
        range.selectNodeContents(el);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        return { insertText: true };
      } else {
        throw new Error(`Element is not fillable: ${ref}`);
      }
      return { url: location.href, title: (document.title || "").slice(0, 200) };
    },
    fileInput(ref, count) {
      const el = this.resolve(ref);
      if (!isFileInput(el)) throw new Error("upload needs a file upload element from browser_snapshot");
      if (count > 1 && !el.multiple) throw new Error("This file upload accepts one file");
      return el;
    },
    // Empties the field and focuses where typing starts. Real key presses then follow the focus of the
    // page, so a widget that moves between boxes gets each one. For a split code, a whole code empties
    // every box and starts at the first; one character replaces only the box it is typed into, so a
    // code can also be entered box by box.
    focusForKeys(ref, whole = true) {
      const el = this.resolve(ref);
      if (el.readOnly) throw new Error("Element is read-only");
      if (el instanceof HTMLSelectElement) return { select: true };
      if (el instanceof HTMLInputElement && !TEXT_INPUT_TYPES.includes(el.type)) {
        throw new Error("Input type requires desktop tools");
      }
      if (!(el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el.isContentEditable)) {
        throw new Error(`Element is not fillable: ${ref}`);
      }
      const code = codeBoxes(el);
      const boxes = whole ? code : [el];
      let container = code[0].parentElement;
      while (container && !code.every((box) => container.contains(box))) container = container.parentElement;
      keyTarget = { el, boxes, at: pageFields().indexOf(boxes[0]), size: code.length,
        container, names: code.map(naming) };
      // Only boxes that hold something are emptied, so an empty widget sees no events at all.
      for (let i = 0; i < boxes.length; i++) {
        const box = targetBoxes()[i];
        loginFilled.delete(box);
        if (!(box.isContentEditable ? box.textContent : box.value)) continue;
        if (box.isContentEditable) box.textContent = "";
        else Object.getOwnPropertyDescriptor(Object.getPrototypeOf(box), "value").set.call(box, "");
        box.dispatchEvent(new Event("input", { bubbles: true }));
      }
      targetBoxes()[0].focus();
      return {
        focused: this.focusHolds(),
        multiline: !(el instanceof HTMLInputElement),
      };
    },
    // Whether the next key still lands in the field, or in a box of its code when the widget moved
    // on by itself. Focus anywhere else, or a box the page removed, ends the typing.
    focusHolds() {
      const active = document.activeElement;
      return Boolean(active) && targetBoxes().some((box) => box.isConnected
        && (box.contains(active) || (active.isContentEditable && active.contains(box))));
    },
    // Whether what the step was meant to change (the field, one box, or every box of a split code)
    // now holds the typed letters and digits. Widgets may add spaces or dashes, or change case.
    typed(ref, text) {
      const el = refMap.get(String(ref));
      const boxes = el === keyTarget.el ? targetBoxes() : el?.isConnected ? codeBoxes(el) : [];
      if (!boxes.length || !boxes.every((box) => box.isConnected)) return true;
      const letters = (value) => String(value).replace(/[^\p{L}\p{N}]/gu, "").toLowerCase();
      const shown = boxes.map((box) => (box.isContentEditable ? box.innerText : box.value)).join("");
      return letters(shown) === letters(text);
    },
  };
  return true;
})()
"""


def eval_json(client: CdpClient, session_id: str, expression: str, context_id: int | None = None) -> Any:
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "contextId": client.context_id if context_id is None else context_id,
            "returnByValue": True,
            "awaitPromise": True,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        # Chromium's text is just "Uncaught"; the reason is the thrown error's first line.
        description = str((details.get("exception") or {}).get("description") or "").split("\n")[0]
        text = description.removeprefix("Error: ") or details.get("text") or "evaluate failed"
        if text.startswith("Settled: "):
            raise Settled(text.removeprefix("Settled: "))
        if text.startswith("Refused: "):
            raise Refused(text.removeprefix("Refused: "))
        raise RuntimeError(str(text))
    return (result.get("result") or {}).get("value")


def ensure_helpers(client: CdpClient, session_id: str) -> None:
    ensure_world(client, session_id)
    eval_json(client, session_id, EVAL_HELPERS)


def navigate(client: CdpClient, session_id: str, url: str) -> dict[str, Any]:
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")
    result = client.call("Page.navigate", {"url": url}, session_id=session_id, timeout_s=15.0)
    if result.get("errorText") or result.get("isDownload"):
        raise RuntimeError(result.get("errorText") or "Navigation started a download")
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
            if result.get("loaderId") and frame.get("loaderId") != result["loaderId"]:
                time.sleep(0.1)
                continue
            ensure_world(client, session_id)
            ready = eval_json(client, session_id, "document.readyState")
            if ready in ("interactive", "complete"):
                return {"ok": True, "url": eval_json(client, session_id, "location.href"),
                        "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)")}
        except Exception:
            pass
        time.sleep(0.1)
    raise RuntimeError("Navigation did not settle; inspect the screen before continuing")


MAX_UPLOAD_FILES = 10
MAX_UPLOAD_BYTES = 100 * 1024 * 1024


def resolve_upload_paths(
    paths: Any, home: str | None = None, roots: list[str] | None = None,
) -> list[str]:
    """Resolve regular files within trusted roots before handing them to Chromium."""
    if not isinstance(paths, list) or not 1 <= len(paths) <= MAX_UPLOAD_FILES:
        raise RuntimeError(f"upload needs 1 to {MAX_UPLOAD_FILES} file paths")
    home = os.path.realpath(home or os.environ.get("HOME") or "/home/rakazo")
    location = "your folder or shared/" if roots is not None else "this computer's home folder"
    allowed = [home]
    if roots is not None:
        allowed = []
        for root in roots:
            expected = os.path.normpath(os.path.join(home, root))
            full = os.path.realpath(expected)
            # A root redirected by a symlink (bots/b1 -> bots/b2) could reach another bot's files.
            if os.path.isabs(root) or full != expected or os.path.commonpath([home, full]) != home:
                raise RuntimeError(f"Upload files must be inside {location}")
            # A folder that does not exist yet holds no files; the other root still applies.
            if os.path.isdir(full):
                allowed.append(full)
    max_bytes = MAX_UPLOAD_BYTES
    override = os.environ.get("RAKAZO_BROWSER_UPLOAD_MAX_BYTES", "")
    try:
        if int(override) > 0:
            max_bytes = int(override)
    except ValueError:
        pass
    resolved = []
    total = 0
    for path in paths:
        if not isinstance(path, str) or not path.strip():
            raise RuntimeError("upload paths must be non-empty strings")
        full = os.path.realpath(os.path.join(home, path))
        # Check confinement before existence to avoid revealing outside targets.
        if not any(os.path.commonpath([root, full]) == root for root in allowed):
            raise RuntimeError(f"Upload files must be inside {location}: {path}")
        try:
            info = os.stat(full)
        except OSError:
            raise RuntimeError(f"File not found: {path}") from None
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"Not a regular file: {path}")
        total += info.st_size
        if total > max_bytes:
            raise RuntimeError(f"upload files are larger than {max_bytes / (1024 * 1024):g} MB in total")
        resolved.append(full)
    return resolved


def upload(client: CdpClient, session_id: str, ref: str, files: list[str]) -> None:
    # Hand the files to the input directly: no native file chooser is opened.
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": f"window.__rakazoPageBrowser.fileInput({json.dumps(ref)}, {len(files)})",
            "contextId": client.context_id,
            "returnByValue": False,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        raise RuntimeError(
            (details.get("exception") or {}).get("description")
            or details.get("text")
            or "upload failed"
        )
    object_id = (result.get("result") or {}).get("objectId")
    if not object_id:
        raise RuntimeError("upload target unavailable")
    try:
        client.call("DOM.setFileInputFiles", {"files": files, "objectId": object_id},
                    session_id=session_id)
    finally:
        client.call("Runtime.releaseObject", {"objectId": object_id}, session_id=session_id)


SETTLE_SECONDS = 3.0


def wait_for_settle(client: CdpClient, session_id: str, seconds: float | None = None) -> bool:
    """Wait until the page has loaded and made no requests for 500 ms (Chromium's networkIdle).

    Many sites draw a signed-out shell first and replace it once their own requests return,
    so a page captured earlier can show "Sign in" to an account that is signed in.
    """
    deadline = time.monotonic() + (SETTLE_SECONDS if seconds is None else seconds)

    def remaining() -> float:
        budget = deadline - time.monotonic()
        if budget <= 0:
            raise TimeoutError("Page settle budget exhausted")
        return budget

    try:
        # Enabling lifecycle events replays the ones the current document has already reached.
        client.call("Page.setLifecycleEventsEnabled", {"enabled": True}, session_id=session_id,
                    timeout_s=remaining())
        while True:
            # Each call also handles the lifecycle events that arrived meanwhile.
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=remaining())
            if {"load", "networkIdle"} <= client.lifecycle(session_id, frame["frameTree"]["frame"]["id"]):
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(min(0.1, remaining()))
    except TimeoutError:
        # A browser too slow to answer within the wait is not settled either.
        return False


# An action's result waits until its own requests are done and the page has stopped changing for this
# long, then is taken within the settle budget.
ACTION_QUIET_SECONDS = 0.12
# The most an action's result waits for its requests and the snapshot after them together. An action
# that leaves the page for another document waits as long as a snapshot does (SETTLE_SECONDS).
ACTION_WAIT_SECONDS = 2.0
# A request begun this soon after one of the action's finished is set off by its answer.
ACTION_FOLLOW_SECONDS = 0.03
# Page changes later than this after the action's last step or request do not hold the result back, so
# a page that always animates is not waited for.
ACTION_CHANGE_SECONDS = 0.3


def wait_for_action(client: CdpClient, session_id: str, ended: float, seconds: float) -> bool:
    """Wait for what the action set in motion: its own requests, and the page drawing their answers.

    Many actions fetch data and render it afterwards, so a snapshot taken at once shows "loading".
    False when a request of the action is still open `seconds` after its last step.
    """
    deadline = ended + seconds
    while True:
        now = time.monotonic()
        try:
            changed = now - float(eval_json(client, session_id, "window.__rakazoPageBrowser.quietFor()")) / 1000
        except Exception:  # noqa: BLE001
            # A page that moved to another document has no helper yet; its own load is awaited next.
            changed = ended
        pending, finished = client.action_requests(session_id, ended, ACTION_QUIET_SECONDS, ACTION_FOLLOW_SECONDS)
        last = max(ended, finished)
        if changed <= last + ACTION_CHANGE_SECONDS:
            last = max(last, changed)
        if not pending and now - last >= ACTION_QUIET_SECONDS:
            return True
        if now >= deadline:
            return not pending
        client.listen(0.03)


def key_event(char: str) -> dict[str, Any] | None:
    """CDP keyDown parameters for one character, or None for an ASCII control inserted as text."""
    if char == "\n":
        # Shift+Enter breaks the line; many chat boxes send their message on a plain Enter.
        return {"key": "Enter", "code": "Enter", "text": "\r", "windowsVirtualKeyCode": 13, "modifiers": 8}
    # Unicode has no assumed physical key mapping. Dispatch each code point without IME composition;
    # combining sequences and ZWJ emoji are neither normalized nor grouped.
    if len(char) == 1 and ord(char) > 127:
        return {"key": char, "text": char}
    if len(char) != 1 or not " " <= char <= "~":
        return None
    if char.isdigit():
        return {"key": char, "code": f"Digit{char}", "text": char, "windowsVirtualKeyCode": ord(char)}
    if char.isalpha():
        return {"key": char, "code": f"Key{char.upper()}", "text": char,
                "windowsVirtualKeyCode": ord(char.upper())}
    if char == " ":
        return {"key": " ", "code": "Space", "text": " ", "windowsVirtualKeyCode": 32}
    return {"key": char, "text": char}


def press_key(client: CdpClient, session_id: str, event: dict[str, Any]) -> None:
    down = {"type": "keyDown", **event}
    if "text" in event:
        down["unmodifiedText"] = event["text"]
    client.call("Input.dispatchKeyEvent", down, session_id=session_id)
    client.call("Input.dispatchKeyEvent", {"type": "keyUp", **{k: v for k, v in event.items() if k != "text"}},
                session_id=session_id)


class TypingStopped(RuntimeError):
    """Typing ended before the last key. The message never repeats any of the text."""


def focus_holds(client: CdpClient, session_id: str) -> bool | None:
    """Whether keys still reach the field or its code boxes; None once its document is gone."""
    try:
        return eval_json(client, session_id, "window.__rakazoPageBrowser.focusHolds()") is True
    except Exception:  # noqa: BLE001
        return None


def page_mark(client: CdpClient, session_id: str) -> tuple[dict[str, Any], int]:
    """The main frame and its navigation count, taken before a type step touches the page."""
    frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
    return frame, client.navigations(session_id, frame["id"])


def type_keys(client: CdpClient, session_id: str, text: str, multiline: bool,
              mark: tuple[dict[str, Any], int]) -> bool:
    """Press each character as a real key into whatever element has focus at that moment.

    Before each key, the page must still be the document of mark, with focus in the field or in a
    box of its code. The check also reads the browser's navigation events, which a page reports
    before the evaluation's answer, so a page that navigates on a key, or while its field was being
    emptied, gets no further keys.
    Returns whether the page moved to another document on the last key, as auto-submitting codes do.
    Either way, the next document has replaced the old one before this returns, when it loads in time.
    """
    frame, navigations = mark
    frame_id = frame["id"]

    def moved_on(holds: bool | None) -> bool:
        if holds is not None and client.navigations(session_id, frame_id) == navigations:
            return False
        wait_for_new_document(client, session_id, frame.get("loaderId"))
        return True

    # Enter in a one-line field would submit its form.
    chars = [char for char in text.replace("\r\n", "\n").replace("\r", "\n") if multiline or char != "\n"]
    for index, char in enumerate(chars):
        holds = focus_holds(client, session_id)
        if moved_on(holds):
            raise TypingStopped(f"The page changed while typing, after {index} of {len(chars)} characters, "
                                "so the rest was not typed. Take a fresh snapshot before continuing.")
        if not holds:
            raise TypingStopped(f"Focus left the field while typing, after {index} of {len(chars)} characters, "
                                "so the rest was not typed. Check the page in this snapshot before trying again.")
        event = key_event(char)
        if event is None:
            client.call("Input.insertText", {"text": char}, session_id=session_id)
        else:
            press_key(client, session_id, event)
    return moved_on(focus_holds(client, session_id))


def wait_for_new_document(client: CdpClient, session_id: str, loader_id: Any) -> None:
    """Give a page that began loading another document the settle budget to replace the old one."""
    deadline = time.monotonic() + SETTLE_SECONDS
    while time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=SETTLE_SECONDS)
            if frame["frameTree"]["frame"].get("loaderId") != loader_id:
                return
        except Exception:  # noqa: BLE001
            return
        time.sleep(0.05)


def typed_in_full(client: CdpClient, session_id: str, ref: str, text: str) -> bool:
    """A widget may refuse keys. A page that submitted or navigated on the last key counts as done."""
    try:
        return eval_json(client, session_id,
                         f"window.__rakazoPageBrowser.typed({json.dumps(ref)}, {json.dumps(text)})") is not False
    except Exception:  # noqa: BLE001
        return True


def payment_frames(client: CdpClient, session_id: str) -> list[tuple[str, str, int]]:
    """Visible frames of a known payment provider that the page itself shows: (session, frame, world).

    Only frames whose owner element is in the page's own documents count, so a provider frame
    inside an ad or other third-party frame on the checkout never receives the card.
    """
    client.call("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": False, "flatten": True,
                                         "filter": [{"type": "iframe"}]}, session_id=session_id)
    frames = []
    for frame_session in client.frame_sessions(session_id)[:32]:
        try:
            frame = client.call("Page.getFrameTree", session_id=frame_session)["frameTree"]["frame"]
            if not payment_frame_origin(frame.get("url")):
                continue
            owner = client.call("DOM.getFrameOwner", {"frameId": frame["id"]}, session_id=session_id)
            if not frame_owner_visible(client, session_id, owner["backendNodeId"]):
                continue
            client.call("Page.enable", session_id=frame_session)
            world = world_in(client, frame_session, frame["id"])
            eval_json(client, frame_session, EVAL_HELPERS, context_id=world)
            frames.append((frame_session, frame["id"], world))
        except Exception:  # noqa: BLE001
            continue
    return frames


FRAME_OWNER_VISIBLE = """function () {
  for (let el = this; el; el = el.parentElement) {
    const style = getComputedStyle(el);
    if (style.display === "none" || style.visibility !== "visible" || Number(style.opacity) === 0) return false;
  }
  const box = this.getBoundingClientRect();
  return box.width > 1 && box.height > 1;
}"""


def frame_owner_visible(client: CdpClient, session_id: str, backend_node_id: int) -> bool:
    # Resolved in the helper's isolated world, so the page cannot fake the answer; an owner outside it fails.
    node = client.call("DOM.resolveNode", {"backendNodeId": backend_node_id,
                                           "executionContextId": client.context_id}, session_id=session_id)
    result = client.call("Runtime.callFunctionOn", {"objectId": node["object"]["objectId"],
                                                    "functionDeclaration": FRAME_OWNER_VISIBLE,
                                                    "returnByValue": True}, session_id=session_id)
    return result.get("result", {}).get("value") is True


def frame_eval(client: CdpClient, frames: list[tuple[str, str, int]], expression: str) -> list[Any]:
    """`expression` in each frame, with None for a frame that failed."""
    results = []
    for frame_session, _, world in frames:
        try:
            results.append(eval_json(client, frame_session, expression, context_id=world))
        except Exception:  # noqa: BLE001
            results.append(None)
    return results


def pay_token_frames(client: CdpClient, frames: list[tuple[str, str, int]]) -> list[tuple[str, str, int]]:
    return [frame for frame, origin in zip(frames, frame_eval(client, frames, "location.origin"))
            if origin == PAY_TOKEN_FRAME_ORIGIN]


def snapshot(client: CdpClient, session_id: str, settle: float | None = None) -> dict[str, Any]:
    settled = wait_for_settle(client, session_id, settle)
    ensure_helpers(client, session_id)
    data = eval_json(client, session_id, "window.__rakazoPageBrowser.snapshot()")
    if not isinstance(data, dict):
        raise RuntimeError("snapshot returned non-object")
    tree = str(data.get("tree") or "")
    account = eval_json(client, session_id, "window.__rakazoPageBrowser.payTokenAccount()")
    if data.pop("frames", False):
        try:
            frames = payment_frames(client, session_id)
        except Exception:  # noqa: BLE001
            frames = []
        card_shown = any(frame_eval(client, frames, "window.__rakazoPageBrowser.hasCardField()"))
        tree += "\n" + (PAYMENT_FRAME_HINT if card_shown else "Embedded frames require desktop tools.")
        accounts = [found for found in frame_eval(client, pay_token_frames(client, frames),
                                                  "window.__rakazoPageBrowser.payTokenAccount()") if found]
        account = account or (accounts[0] if len(accounts) == 1 else None)
    if isinstance(account, str):
        tree += "\n" + pay_token_hint(account)
    data["tree"] = tree
    return {"ok": True, **data, **({} if settled else {"loading": True})}


def find_card_field(client: CdpClient, session_id: str, main_frame_id: str, token: str) -> tuple[str, str, int]:
    """The one field the page shows for this card detail, in the page itself or else in a payment frame."""
    find = f"window.__rakazoPageBrowser.findCard({json.dumps(token)})"
    found = eval_json(client, session_id, find)
    if found == 1:
        return session_id, main_frame_id, client.context_id
    if found:
        raise Refused(CARD_FIELD_AMBIGUOUS)
    matches = [frame for frame in payment_frames(client, session_id)
               for _ in range(eval_json(client, frame[0], find, context_id=frame[2]) or 0)]
    if not matches:
        raise Refused(CARD_FIELD_MISSING)
    if len(matches) > 1:
        raise Refused(CARD_FIELD_AMBIGUOUS)
    return matches[0]


def merchant_check(client: CdpClient, session_id: str, origin: str) -> Any:
    """A check that the top page is still the document it was on now, and on the merchant's origin."""
    if not origin.startswith("https://"):
        raise Refused("A card can only be filled on HTTPS. "
                      "Open the merchant's checkout with browser_navigate, then fill again.")
    top_world = client.context_id
    main_frame, top_navigations = page_mark(client, session_id)

    def on_merchant() -> bool:
        return (client.navigations(session_id, main_frame["id"]) == top_navigations
                and eval_json(client, session_id, "location.origin", context_id=top_world) == origin)

    if not on_merchant():
        raise Refused(NOT_ON_MERCHANT)
    on_merchant.main_frame_id = main_frame["id"]  # type: ignore[attr-defined]
    return on_merchant


def fill_pay_token(client: CdpClient, session_id: str, step: dict[str, Any]) -> None:
    """Hand an approved pay token to the merchant account's hidden block, in the page or Stripe's frame.

    The token is passed as a call argument, never in script source or the result, and only once the
    top page is still the merchant's and the block names the purchase's merchant account.
    """
    on_merchant = merchant_check(client, session_id, step["origin"])
    account = step["merchantAccountId"]
    lookup = "window.__rakazoPageBrowser.payTokenAccount()"
    targets = []
    if eval_json(client, session_id, lookup) == account:
        targets.append((session_id, on_merchant.main_frame_id, client.context_id))
    else:
        frames = pay_token_frames(client, payment_frames(client, session_id))
        targets = [frame for frame, found in zip(frames, frame_eval(client, frames, lookup)) if found == account]
    if len(targets) != 1:
        raise Refused(PAY_TOKEN_MISSING)
    target_session, _, world = targets[0]
    if not on_merchant() or (target_session != session_id and eval_json(
            client, target_session, "location.origin", context_id=world) != PAY_TOKEN_FRAME_ORIGIN):
        raise Refused(NOT_ON_MERCHANT)
    try:
        result = client.call("Runtime.callFunctionOn", {
            "functionDeclaration": "function (token) { return window.__rakazoPageBrowser.setPayToken(token); }",
            "executionContextId": world,
            "arguments": [{"value": step["text"]}],
            "returnByValue": True,
        }, session_id=target_session)
    except Exception:  # noqa: BLE001
        raise RuntimeError("The pay token could not be handed to the checkout.") from None
    if result.get("exceptionDetails") or (result.get("result") or {}).get("value") is not True:
        raise Refused("The checkout didn't take the pay token. Take a fresh snapshot before trying again.")


def fill_card(client: CdpClient, session_id: str, step: dict[str, Any]) -> None:
    """Type a card detail with trusted input into the field the page or its payment frame marks for it.

    Before every key the top page must still be the merchant's document, the frame its payment
    provider's, and the field focused, so a navigation between finding the field and typing refuses.
    """
    text = step["text"]
    if step["cardField"] == "expiry":
        text = "".join(char for char in text if char.isalnum())
    on_merchant = merchant_check(client, session_id, step["origin"])
    field_session, frame_id, world = find_card_field(client, session_id, on_merchant.main_frame_id,
                                                     CARD_AUTOCOMPLETE[step["cardField"]])
    in_frame = field_session != session_id
    frame_navigations = client.navigations(field_session, frame_id)

    def run(expression: str) -> Any:
        return eval_json(client, field_session, expression, context_id=world)

    def stopped() -> str | None:
        if not on_merchant():
            return NOT_ON_MERCHANT
        if in_frame and (client.navigations(field_session, frame_id) != frame_navigations
                         or not payment_frame_origin(run("location.origin"))):
            return "The payment frame changed, so the card was not typed. Take a fresh snapshot before trying again."
        return None

    if run("window.__rakazoPageBrowser.focusCard()") is not True:
        raise Refused("The card field did not take focus, so nothing was typed.")
    for index, char in enumerate(text):
        reason = stopped() or (None if run("window.__rakazoPageBrowser.cardHolds()") is True else
                               "Focus left the card field, so the card was not typed. Fill it again.")
        if reason:
            if index:
                clear_or_uncertain(client, field_session, run, reason)
            raise Refused(reason)
        client.call("Input.insertText", {"text": char}, session_id=field_session)
    reason = stopped()
    if reason:
        clear_or_uncertain(client, field_session, run, reason)
        raise Refused(reason)
    # Fields often move on to the next one by themselves once complete, so focus is not checked here.
    if run(f"window.__rakazoPageBrowser.cardTyped({sum(char.isalnum() for char in text)})") is not True:
        reason = "This field didn't accept the card, so it was cleared."
        clear_or_uncertain(client, field_session, run, reason)
        raise Refused(reason)


def clear_or_uncertain(client: CdpClient, session_id: str, run: Any, reason: str) -> None:
    if not clear_card(client, session_id, run):
        raise CardFieldUncertain(f"{reason} The field could not be confirmed empty, so check it before continuing.")


def clear_card(client: CdpClient, session_id: str, run: Any) -> bool:
    """Keys erase what the field's own script kept, then its value is emptied directly; True once it is empty."""
    try:
        if run("window.__rakazoPageBrowser.focusCard()") is True:
            press_key(client, session_id, {"key": "Backspace", "code": "Backspace", "windowsVirtualKeyCode": 8})
        run("window.__rakazoPageBrowser.emptyCard()")
        return run("window.__rakazoPageBrowser.cardTyped(0)") is True
    except Exception:  # noqa: BLE001
        return False


def draw_frames(client: CdpClient, session_id: str) -> None:
    """Let the page draw, so the browser's own hit-test knows where a scroll left things."""
    try:
        eval_json(client, session_id, "window.__rakazoPageBrowser.nextFrames()")
    except Exception:  # noqa: BLE001
        pass


def check_frame(client: CdpClient, session_id: str, x: float, y: float) -> None:
    """Refuse a press that would land in another document, which the page script cannot see into
    (a frame in a closed shadow tree, for one). The browser itself says which frame owns the spot,
    given as a spot on the page (the window's spot plus the scroll), not in the window.

    Any answer but "the main frame" stops the press, including a failed call. A cross-origin frame runs
    in its own process, so the browser's hit-test stops at its frame element, which the main frame owns:
    that element stops the press too. Right after a scroll the browser may not know the spot yet
    ("No node found"): it gets one more frame to catch up.
    """
    for attempt in range(2):
        try:
            hit = client.call("DOM.getNodeForLocation", {"x": x, "y": y, "includeUserAgentShadowDOM": True},
                              session_id=session_id)
            main = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]["id"]
            node = client.call("DOM.describeNode", {"backendNodeId": hit["backendNodeId"]},
                               session_id=session_id)["node"]
            break
        except (RuntimeError, KeyError) as error:
            if attempt == 0 and "No node found" in str(error):
                draw_frames(client, session_id)
                continue
            if "No node found" in str(error):
                raise Settled(STILL_MOVING) from None
            raise Settled(CHANGED_UNDER_POINTER) from None
    if hit.get("frameId") != main or str(node.get("nodeName", "")).upper() in ("IFRAME", "FRAME", "OBJECT", "EMBED"):
        raise Settled(FRAME_CLICK)


def click_at(client: CdpClient, session_id: str, ref: str, x: float, y: float) -> None:
    """A real mouse click, as a person's: pointer enters, button goes down, button comes up.

    A page can answer the pointer by changing what is under it, so the spot is checked again between.
    """
    base = {"x": x, "y": y, "pointerType": "mouse"}
    draw_frames(client, session_id)
    client.call("Input.dispatchMouseEvent", {**base, "type": "mouseMoved"}, session_id=session_id)
    scrolled = eval_json(client, session_id, f"window.__rakazoPageBrowser.stillAimed({json.dumps(ref)}, {x}, {y})")
    scrolled = scrolled if isinstance(scrolled, dict) else {}
    check_frame(client, session_id, x + scrolled.get("x", 0), y + scrolled.get("y", 0))
    client.call("Input.dispatchMouseEvent", {**base, "type": "mousePressed", "button": "left", "buttons": 1,
                                             "clickCount": 1}, session_id=session_id)
    client.call("Input.dispatchMouseEvent", {**base, "type": "mouseReleased", "button": "left",
                                             "clickCount": 1}, session_id=session_id)


def act(client: CdpClient, session_id: str, actions: list[dict[str, Any]]) -> dict[str, Any]:
    if not actions or len(actions) > 24:
        raise RuntimeError("Expected 1 to 24 actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ("click", "fill", "type", "upload", "pay_token"):
            raise RuntimeError("Invalid browser action")
        if step["kind"] == "pay_token":
            if (step.get("ref") is not None or not isinstance(step.get("text"), str) or not step["text"]
                    or not isinstance(step.get("origin"), str)
                    or not isinstance(step.get("merchantAccountId"), str)):
                raise RuntimeError("A pay token needs its text, origin and merchant account, and no ref")
            continue
        if step.get("ref") is None and step.get("kind") == "fill" and step.get("field") == "card":
            if step.get("cardField") not in CARD_AUTOCOMPLETE:
                raise RuntimeError("A card fill without a ref needs its card field")
        elif not isinstance(step.get("ref"), str) or not step["ref"]:
            raise RuntimeError("Element ref is required")
        if step["kind"] == "upload":
            # Check every file before acting, so a bad path cannot leave a half-done form.
            step["files"] = resolve_upload_paths(step.get("paths"), roots=step.get("roots"))
        elif step["kind"] != "click" and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        if step.get("origin") is not None and (
            step["kind"] != "fill" or not isinstance(step["origin"], str)
        ):
            raise RuntimeError("An origin applies only to fill")
        # A card detail is hidden and checked only on an origin-bound fill.
        if step.get("field") == "card" and not step.get("origin"):
            raise RuntimeError("A card fill needs its origin")
    ensure_helpers(client, session_id)
    # Requests are told apart from the page's own background ones by when they begin, so listen from now.
    # Bodies are not wanted, and 0 would mean no limit: one byte keeps each event small.
    try:
        client.call("Network.enable", {"maxPostDataSize": 1}, session_id=session_id)
        client.drop_oversized = True
    except Exception:  # noqa: BLE001
        pass
    # A click that makes the page open a file chooser would show a native dialog on the screen. Hold
    # it back instead: files go in with upload.
    try:
        client.call("Page.setInterceptFileChooserDialog", {"enabled": True}, session_id=session_id)
    except Exception:  # noqa: BLE001
        pass
    navigations = client.navigation_count(session_id)
    completed = 0
    uncertain = False
    # Refs belong to the document that was typed into; a page that moved on keeps none of them.
    page_changed = False
    try:
        for step in actions:
            kind, ref = step["kind"], step.get("ref")
            if page_changed:
                # The result shows the page the code led to, so the bot can carry on from there.
                try:
                    snap = snapshot(client, session_id)
                except Exception:  # noqa: BLE001
                    snap = {"uncertain": True}
                return {"uncertain": False, **snap, "ok": False, "completed": completed,
                        "error": "Stale element ref. Take a fresh snapshot."}
            if kind == "pay_token":
                uncertain = True
                fill_pay_token(client, session_id, step)
                completed += 1
                uncertain = False
                continue
            if ref is None:
                uncertain = True
                fill_card(client, session_id, step)
                completed += 1
                uncertain = False
                continue
            # Preflight catches stale, hidden and disabled elements before a mutation is dispatched.
            eval_json(client, session_id, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))")
            if kind == "upload":
                uncertain = True
                upload(client, session_id, ref, step["files"])
                completed += 1
                uncertain = False
                continue
            if kind == "type":
                uncertain = True
                mark = page_mark(client, session_id)
                # One character goes into the ref'd box alone; longer text replaces the whole code.
                whole = json.dumps(len(step["text"]) > 1)
                focus = eval_json(client, session_id,
                                  f"window.__rakazoPageBrowser.focusForKeys({json.dumps(ref)}, {whole})")
                if isinstance(focus, dict) and focus.get("select"):
                    kind = "fill"
                else:
                    if not isinstance(focus, dict) or not focus.get("focused"):
                        raise RuntimeError("The field did not take keyboard focus. Click it, then type again.")
                    try:
                        page_changed = type_keys(client, session_id, step["text"],
                                                 multiline=bool(focus.get("multiline")), mark=mark)
                    except TypingStopped as stopped:
                        try:
                            snap = snapshot(client, session_id)
                        except Exception:  # noqa: BLE001
                            snap = {"uncertain": True}
                        return {"uncertain": False, **snap, "ok": False, "completed": completed,
                                "error": str(stopped)}
                    completed += 1
                    uncertain = False
                    if not page_changed and not typed_in_full(client, session_id, ref, step["text"]):
                        return {"uncertain": False, **snapshot(client, session_id), "ok": False, "completed": completed,
                                "error": "The page did not keep every character typed. "
                                         "Check the field in this snapshot before trying again."}
                    continue
            if kind == "click":
                uncertain = True
                aim = eval_json(client, session_id, f"window.__rakazoPageBrowser.aim({json.dumps(ref)})")
                if isinstance(aim, dict) and aim.get("x") is not None:
                    click_at(client, session_id, ref, aim["x"], aim["y"])
                completed += 1
                uncertain = False
                continue
            arguments = json.dumps(ref) + ", " + json.dumps(step["text"])
            if step.get("origin"):
                arguments += ", " + json.dumps(step["origin"]) + ", " + json.dumps(step.get("field"))
            uncertain = True
            data = eval_json(client, session_id, f"window.__rakazoPageBrowser.fill({arguments})")
            if not isinstance(data, dict):
                raise RuntimeError("Action response unavailable")
            if data.get("insertText"):
                client.call("Input.insertText", {"text": step["text"]}, session_id=session_id)
            completed += 1
            uncertain = False
        ended = time.monotonic()
        budget = SETTLE_SECONDS if client.navigation_count(session_id) != navigations else ACTION_WAIT_SECONDS
        busy = not wait_for_action(client, session_id, ended, budget)
        if client.file_choosers:
            raise Settled(FILE_CHOOSER)
        # The snapshot takes what is left of the budget, and none when a request is known to be open.
        snap = snapshot(client, session_id, 0.0 if busy else max(0.0, ended + budget - time.monotonic()))
        return {**snap, "completed": completed, **({"loading": True} if busy else {})}
    except Settled as exc:
        # Nothing changed for this step. The page as it is now goes with the reason.
        try:
            snap = snapshot(client, session_id)
        except Exception:  # noqa: BLE001
            snap = {}
        return {"uncertain": False, **snap, "ok": False, "completed": completed, "error": str(exc)}
    except Refused as exc:
        # Settled, and fixable in the page browser: no desktop fallback.
        return {"ok": False, "completed": completed, "uncertain": False, "error": str(exc)}
    except CardFieldUncertain as exc:
        return {"ok": False, "completed": completed, "uncertain": True, "error": str(exc)}
    except Exception as exc:
        return {"ok": False, "completed": completed, "uncertain": uncertain,
                "error": str(exc), "fallback": "computer_act"}


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def run(argv: list[str]) -> int:
    stdin_args = (
        read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    )
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "usage: rakazo-page-browser <command> [json-args]",
                    "fallback": "computer_act",
                }
            )
        )
        return 2
    command = argv[1]
    args: dict[str, Any] = {}
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    if raw_args.strip():
        args = json.loads(raw_args)
    port = cdp_port()
    # Set once the browser answers: before that, no action can have reached the page.
    connected = False
    try:
        wait_for_cdp(port)
        ws_url = discover_ws_url(port)
        client = CdpClient(ws_url)
        client.connect()
        connected = True
        try:
            session_id = attach_page(client)
            if command == "navigate":
                result = navigate(client, session_id, str(args.get("url") or ""))
            elif command == "snapshot":
                result = snapshot(client, session_id)
            elif command == "act":
                actions = args.get("actions")
                if not isinstance(actions, list):
                    raise RuntimeError("actions must be an array")
                result = act(client, session_id, actions)
            else:
                result = {
                    "ok": False,
                    "error": f"unknown command: {command}",
                    "fallback": "computer_act",
                }
                print(json.dumps(result))
                return 2
            print(json.dumps(result))
            return 0  # Structured failures preserve partial action progress.
        finally:
            client.close()
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"ok": False, "error": str(exc), "fallback": "computer_act",
                              "uncertain": command == "act" and connected}))
        return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv))
