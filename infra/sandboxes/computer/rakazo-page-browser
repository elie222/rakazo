      && (el.getAttribute("autocomplete") || "").toLowerCase().split(/\s+/).includes(token));
  }
  // Refs count up for as long as the page lives, so a ref from an earlier snapshot never names
  // another element; a new document starts from a random point, so refs from the page before it
  // name nothing either. Retain exact nodes, not selectors.
  let refCounter = Math.floor(Math.random() * 1e8);
  function newRef() {
    return `e${++refCounter}`;
