class Settled(RuntimeError):
    """A step the page cannot take as asked (stale ref, covered or disabled element, no such option).

    Nothing changed, and the result carries the page as it is, so the bot can choose again.
    """


class TypingStopped(RuntimeError):
    """Typing ended before the last key. The message never repeats any of the text."""


class KeysNotKept(RuntimeError):
    """Every key was pressed, but the field did not keep them all: the step ran, its result is wrong."""


class AbError(RuntimeError):
    def __init__(self, message: str, index: int = 0) -> None:
        super().__init__(message)
        self.index = index


def display_num() -> int:
    raw = os.environ.get("DISPLAY", ":1")
    try:
        return int(str(raw).lstrip(":").split(".")[0] or "1")
    except ValueError:
        return 1


def cdp_port() -> int:
    override = os.environ.get("RAKAZO_CDP_PORT")
    if override:
        return int(override)
    # rakazo-browser uses 9221 + display number (:1 -> 9222).
    return 9221 + display_num()


def http_get_json(url: str, timeout: float = 5.0) -> Any:
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        data = resp.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise RuntimeError("CDP discovery response too large")
        return json.loads(data.decode("utf-8"))


def wait_for_cdp(port: int, timeout_s: float = 3.0) -> Any:
    """The browser's version answer, once it answers."""
    deadline = time.time() + timeout_s
    last_error = "unreachable"
    while time.time() < deadline:
        try:
            return http_get_json(f"http://127.0.0.1:{port}/json/version", timeout=1.0)
        except Exception as exc:  # noqa: BLE001
            last_error = str(exc)
            time.sleep(0.25)
    raise RuntimeError(f"CDP not ready on port {port}: {last_error}")


# Chromium's own pages, such as the new tab page, which agent-browser leaves alone.
INTERNAL_SCHEMES = ("chrome", "chrome-extension", "chrome-untrusted", "chrome-search", "devtools")
INTERNAL_PAGE = "The browser is showing one of its own pages, which the page tools cannot read. Open a site with browser_navigate."


def page_tabs(port: int) -> list[dict[str, Any]]:
    """The browser's tabs: Chromium lists them by when they were last brought to the front."""
    return [target for target in http_get_json(f"http://127.0.0.1:{port}/json/list")
            if isinstance(target, dict) and target.get("type") == "page"]


def front_tab(port: int) -> tuple[str, str]:
    """The tab the person sees, and its address."""
    for target in page_tabs(port):
        return str(target["id"]), str(target.get("url") or "")
    raise RuntimeError("No browser tab is open. Use desktop tools to open one.")


# A page may open tabs: a pop-up, a link to a new tab, or a report it opens once it has made it.
# agent-browser follows a tab that opens in front, so the bot is told. More than MAX_NEW_TABS at once
# is a flood, not a report: they are closed, and the bot's own tab is in front again. Of the tabs pages
# opened, at most MAX_OPENED_TABS stay open; the ones longest out of sight are closed first.
MAX_NEW_TABS = 3
MAX_OPENED_TABS = 8
# agent-browser stops answering for good when the tab its session reads is closed under it, so the
# session moves to a tab that stays before any is closed. Closing tabs, moving the session and reading
# the bot's tab again share one deadline per step, so a flood never holds a call much longer.
TAB_WORK_SECONDS = 8.0
REREAD_FAILED = ("The page opened tabs that were closed, and this tab could not be read again in time. "
                 "Take a snapshot to read it.")


def left(deadline: float | None, most: float) -> float:
    """A wait of at most `most` seconds that ends by the deadline, and a short one once it has passed."""
    return most if deadline is None else max(0.2, min(most, deadline - time.monotonic()))


class Tabs:
    """The browser's tabs at the end of the last call, kept in the page browser's own folder."""

    def __init__(self, home: str, port: int, browser_id: Any, select: Callable[[Any], None]) -> None:
        self.path, self.port, self.browser_id = os.path.join(home, f"tabs-{port}.json"), port, browser_id
        # Points agent-browser's session at a tab, before tabs are closed.
        self.select = select
        try:
            with open(self.path, encoding="utf-8") as file:
                last = json.load(file)
            # A browser started again has new tabs only, and may have restored the person's own.
            self.known: set[Any] | None = set(last["tabs"]) if last["browser"] == browser_id else None
            self.opened: list[Any] = list(last.get("opened") or []) if self.known is not None else []
        except (OSError, ValueError, TypeError, KeyError, AttributeError):
            self.known, self.opened = None, []
        self.closed = self.trimmed = 0
        self.start: set[Any] = set()
        self.deadline: float | None = None

    def begin(self) -> None:
        """Close a flood of tabs opened since the last call, before the call picks its tab."""
        tabs = page_tabs(self.port)
        if self.known is not None:
            # The tab in front of those the last call left, or else the tab in front, which stays.
            keep = next((tab.get("id") for tab in tabs if tab.get("id") in self.known),
                        tabs[0].get("id") if tabs else None)
            # Kept as known, so it is not counted as page-opened and trimmed later.
            self.known.add(keep)
            tabs = self.close_flood(tabs, self.known, keep)
        self.start = {tab.get("id") for tab in tabs}

    def end(self, own: str, ours: str | None = None) -> tuple[list[dict[str, Any]], list[dict[str, Any]], bool]:
        """The tabs now, the ones opened since the last call (or, for a browser started again, every
        tab but this call's own), and whether tabs opened during the call were closed. The call's own
        tab is never closed."""
        tabs = page_tabs(self.port)
        closed = self.closed
        tabs = self.close_flood(tabs, self.start | {own}, own)
        before = self.known if self.known is not None else {own}
        opened = [tab for tab in tabs if tab.get("id") not in before and tab.get("id") != ours]
        if self.known is not None:
            ids = {tab.get("id") for tab in tabs}
            self.opened = [tab for tab in self.opened if tab in ids] + [tab.get("id") for tab in opened]
            tabs = self.trim(tabs, own)
        flooded = self.closed > closed
        if flooded:
            with contextlib.suppress(OSError):
                urllib.request.urlopen(f"http://127.0.0.1:{self.port}/json/activate/{own}",
                                       timeout=left(self.deadline, 5.0)).close()
                tabs = page_tabs(self.port)
        # By id, as the tabs listed again: tab_note tells the one in front by identity.
        current = {tab.get("id"): tab for tab in tabs}
        opened = [current[tab.get("id")] for tab in opened if tab.get("id") in current]
        # Written whole, then moved into place: a reader never sees half of it.
        temporary = f"{self.path}.{os.getpid()}"
        with open(temporary, "w", encoding="utf-8") as file:
            json.dump({"browser": self.browser_id, "tabs": [tab.get("id") for tab in tabs], "opened": self.opened}, file)
        os.replace(temporary, self.path)
        return tabs, opened, flooded

    def close(self, ids: list[Any], keep: Any) -> None:
        if keep is not None:
            # Best effort: if the session does not move, the tab it reads is read again or refused after.
            with contextlib.suppress(Exception):
                self.select(keep)
        for tab in ids:
            with contextlib.suppress(OSError):
                urllib.request.urlopen(f"http://127.0.0.1:{self.port}/json/close/{tab}",
                                       timeout=left(self.deadline, 5.0)).close()

    def close_flood(self, tabs: list[dict[str, Any]], before: set[Any], own: Any) -> list[dict[str, Any]]:
        new = [tab.get("id") for tab in tabs if tab.get("id") not in before and tab.get("id") != own]
        if len(new) <= MAX_NEW_TABS:
            return tabs
        self.close(new, own)
        self.closed += len(new)
        return page_tabs(self.port)

    def trim(self, tabs: list[dict[str, Any]], own: str) -> list[dict[str, Any]]:
        """Close the tabs pages opened beyond MAX_OPENED_TABS, longest out of sight first. Tabs no page
        opened, such as the person's own, are left alone."""
        by_sight = [tab.get("id") for tab in tabs if tab.get("id") in self.opened and tab.get("id") != own]
        extra = by_sight[MAX_OPENED_TABS:]
        if not extra:
            return tabs
        # The tab in front stays, as the oldest out of sight go: the session stays on it.
        self.close(extra, tabs[0].get("id"))
        self.trimmed += len(extra)
        self.opened = [tab for tab in self.opened if tab not in extra]
        return page_tabs(self.port)

    def note(self, tabs: list[dict[str, Any]], opened: list[dict[str, Any]], shown_url: Any) -> str | None:
        closed = (f"The page opened {self.closed} tabs at once, more than {MAX_NEW_TABS}, so they were closed."
                  if self.closed else None)
        trimmed = None if not self.trimmed else (
            f"Closed the oldest tab a page had opened, to keep at most {MAX_OPENED_TABS}." if self.trimmed == 1
            else f"Closed the {self.trimmed} oldest tabs pages had opened, to keep at most {MAX_OPENED_TABS}.")
        return " ".join(filter(None, [closed, trimmed, tab_note(opened, tabs, shown_url)])) or None


def tab_named(tab: dict[str, Any]) -> str:
    return f"{json.dumps(str(tab.get('title') or '')[:200], ensure_ascii=False)} at {str(tab.get('url') or '')[:500]}"


def tab_note(opened: list[dict[str, Any]], tabs: list[dict[str, Any]], shown_url: Any) -> str | None:
    """Tells the bot which tabs opened: agent-browser follows a tab that opens in front, so the page tools read it."""
    if not opened:
        return None
    front = tabs[0]
    others = [tab for tab in opened if tab is not front]
    listed = "; ".join(tab_named(tab) for tab in others[:3]) + (f"; and {len(others) - 3} more" if len(others) > 3 else "")
    if front not in opened:
        return f"{'A new tab' if len(opened) == 1 else f'{len(opened)} new tabs'} opened behind this one: {listed}."
    if not others:
        return (f"A new tab opened, and page tools now read it: {tab_named(front)}; the tab before it is still open."
                + ("" if shown_url == front.get("url") else " Take a snapshot to read it."))
    return (f"{len(opened)} new tabs opened, and page tools now read the one in front: {tab_named(front)}; "
            f"the others are {listed}; the tabs before them are still open."
            + ("" if shown_url == front.get("url") else " Take a snapshot to read it."))


def internal(url: str) -> bool:
    return urlsplit(url).scheme in INTERNAL_SCHEMES


def check_url(url: str) -> None:
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")


class AgentBrowser:
    """agent-browser's session for this display: one daemon, kept attached between calls."""

    def __init__(self, port: int) -> None:
        self.port = port
        self.home = os.path.join(tempfile.gettempdir(), f"rakazo-ab-{os.getuid()}")
        os.makedirs(self.home, mode=0o700, exist_ok=True)
        info = os.lstat(self.home)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            raise RuntimeError("The page browser's own folder is not this user's")
        # Its own configuration, never one from the bot's home or working folder.
        self.config = os.path.join(self.home, "config.json")
        with open(self.config, "w", encoding="utf-8") as config:
            config.write("{}")
        self.session = f"display-{port}"
        # When set, every command answers by then or is given up.
        self.deadline: float | None = None
        self.env = {key: value for key, value in os.environ.items()
                    if key in ("LANG", "LD_PRELOAD", "NSS_WRAPPER_PASSWD", "NSS_WRAPPER_GROUP")}
        self.env.update({
            "PATH": "/usr/local/bin:/usr/bin:/bin",
            "HOME": self.home,
            "AGENT_BROWSER_CONFIG": self.config,
            "AGENT_BROWSER_SOCKET_DIR": self.home,
            "AGENT_BROWSER_SESSION": self.session,
            # Always the Chromium on this display: without it, agent-browser would start a browser of its own.
            "AGENT_BROWSER_CDP": str(port),
            "AGENT_BROWSER_IDLE_TIMEOUT_MS": "900000",
            # Dialogs are the person's and the page's to answer, as on the screen; see PageBrowser.dialog_result.
            "AGENT_BROWSER_NO_AUTO_DIALOG": "1",
            "AGENT_BROWSER_NO_WEBMCP": "1",
        })

    def batch(self, commands: list[list[str]], *, timeout: float = 20.0, bail: bool = True) -> list[Any]:
        """Each command's result, in one agent-browser call. Commands and their text go over stdin, not argv."""
        try:
            proc = subprocess.run(
                [AGENT_BROWSER, "batch", "--json", "--omit-command", *(["--bail"] if bail else [])],
                input=json.dumps(commands), capture_output=True, text=True, env=self.env, cwd=self.home,
                timeout=left(self.deadline, timeout))
        except subprocess.TimeoutExpired:
            raise RuntimeError(NO_ANSWER) from None
        try:
            items = json.loads(proc.stdout)
        except json.JSONDecodeError:
            raise AbError((proc.stderr or proc.stdout).strip()[:500] or "agent-browser gave no answer") from None
        if not isinstance(items, list):
            raise AbError(str((items or {}).get("error") if isinstance(items, dict) else items)[:500])
        results: list[Any] = []
        for index, item in enumerate(items):
            if not isinstance(item, dict):
                raise AbError("agent-browser gave no answer", index)
            data = item.get("result") if isinstance(item.get("result"), dict) else {}
            # Only ever the browser on the screen: a page agent-browser opened itself is not the bot's.
            if (data.get("lifecycle") or {}).get("launched") is True:
                raise RuntimeError("Page browser is not attached to this computer's Chrome.")
            if not item.get("success"):
                if bail:
                    raise AbError(str(item.get("error") or "agent-browser failed"), index)
                results.append(None)
                continue
            results.append(data)
        if len(results) < len(commands):
            raise AbError("agent-browser stopped early", len(results))
        return results

    def session_tab(self) -> str | None:
        """The tab the session reads now; it also follows tabs opened while it was attached."""
        # One answer or none: a probe that hangs must leave the call's short budget to the work after it.
        try:
            proc = subprocess.run(
                [AGENT_BROWSER, "tab", "list", "--json"], capture_output=True, text=True,
                env=self.env, cwd=self.home, timeout=left(self.deadline, 1.0))
            envelope = json.loads(proc.stdout)
            data = envelope.get("data") if isinstance(envelope, dict) else None
            tabs = data.get("tabs") if isinstance(data, dict) else None
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            return None
        for tab in tabs if isinstance(tabs, list) else []:
            if isinstance(tab, dict) and tab.get("active") and tab.get("type") == "page":
                return str(tab.get("targetId"))
        return None

    def use_tab(self, target_id: str) -> None:
        """Point the session at the tab on screen when the person has switched tabs since the last call.

        agent-browser follows a newly opened tab on its own, so the tab it was last pointed at is
        not enough: ask where the session is and move it only when it reads another tab.
        """
        if self.session_tab() == target_id:
            return
        self.batch([["tab", target_id]])


# A navigation as from the address bar: no referrer leaves for the next site.
NAVIGATE = r"""(() => {
  const timeOrigin = performance.timeOrigin;
  const policy = document.createElement("meta");
  policy.name = "referrer";
  policy.content = "no-referrer";
  (document.head || document.documentElement).append(policy);
  // After this script has answered: a page being replaced answers late.
  setTimeout(() => location.assign(URL), 0);
  return { timeOrigin, href: location.href };
})()"""

# Whether the page has loaded, when its document began, and the requests it has finished (failed ones
# included) with when each ended.
PAGE_LOAD = r"""({ href: location.href, ready: document.readyState, began: performance.timeOrigin,
  done: performance.getEntriesByType("resource").slice(-500)
    .map((entry) => [entry.name, performance.timeOrigin + entry.responseEnd]) })"""

# The page's address, title and text, the values a snapshot must not show (password fields, fields
# holding a saved login or card, and fields drawn as dots), and the merchant account a pay token checkout names in the page itself.
PAGE_STATE = r"""(() => {
  const masked = [...document.querySelectorAll("input, textarea")]
    .filter((el) => el.value && (el.type === "password" || el.hasAttribute("data-rakazo-filled")
      || getComputedStyle(el).webkitTextSecurity !== "none"))
    .map((el) => el.value);
