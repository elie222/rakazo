def eval_json(client: CdpClient, session_id: str, expression: str, context_id: int | None = None) -> Any:
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "contextId": client.context_id if context_id is None else context_id,
            "returnByValue": True,
            "awaitPromise": True,
        },
        session_id=session_id,
    )
    return page_value(result)


def page_value(result: dict[str, Any]) -> Any:
    """The value of an evaluation in the helper's world, raising the page script's settled and refused errors."""
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        # Chromium's text is just "Uncaught"; the reason is the thrown error's first line.
        description = str((details.get("exception") or {}).get("description") or "").split("\n")[0]
        text = description.removeprefix("Error: ") or details.get("text") or "evaluate failed"
        if text.startswith("Settled: "):
            raise Settled(text.removeprefix("Settled: "))
        if text.startswith("Refused: "):
            raise Refused(text.removeprefix("Refused: "))
        raise RuntimeError(str(text))
    return (result.get("result") or {}).get("value")


def ensure_helpers(client: CdpClient, session_id: str) -> None:
    ensure_world(client, session_id)
    eval_json(client, session_id, EVAL_HELPERS)


def navigate(client: CdpClient, session_id: str, url: str, saving: bool = False) -> dict[str, Any]:
    """Open a URL. When `saving` downloads, a URL that is a file download is saved and the page stays."""
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")
    if saving:
        # The response tells the download's type, and that it is about to begin.
        with contextlib.suppress(Exception):
            client.call("Network.enable", {"maxPostDataSize": 1}, session_id=session_id)
            client.drop_oversized = True
    started = time.monotonic()
    result = client.call("Page.navigate", {"url": url}, session_id=session_id, timeout_s=15.0)
    if saving and result.get("isDownload"):
        ensure_world(client, session_id)
        return {"ok": True, "url": eval_json(client, session_id, "location.href"),
                "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)")}
    if result.get("errorText") or result.get("isDownload"):
        raise RuntimeError(result.get("errorText") or "Navigation started a download")
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
            if result.get("loaderId") and frame.get("loaderId") != result["loaderId"]:
                time.sleep(0.1)
                continue
            ensure_world(client, session_id)
            ready = eval_json(client, session_id, "document.readyState")
            if ready in ("interactive", "complete"):
                return {"ok": True, "url": eval_json(client, session_id, "location.href"),
                        "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)"),
                        **page_after_navigation(client, session_id, started)}
        except Exception:
            pass
        time.sleep(0.1)
    raise RuntimeError("Navigation did not settle; inspect the screen before continuing")


# browser_navigate returns the page as an action does, saving the bot a snapshot call, when the
# navigation took less than NAVIGATE_SNAPSHOT_BY; the snapshot then ends by NAVIGATE_SNAPSHOT_UNTIL
# or is left out, inside the supervisor's limit on one call.
NAVIGATE_SNAPSHOT_BY = 12.0
NAVIGATE_SNAPSHOT_UNTIL = 20.0


def page_after_navigation(client: CdpClient, session_id: str, started: float) -> dict[str, Any]:
    """The page a navigation reached, or nothing when there is no time left or it cannot be read."""
    left = NAVIGATE_SNAPSHOT_BY - (time.monotonic() - started)
    if left <= 0:
        return {}
    try:
        with time_limit(client, started + NAVIGATE_SNAPSHOT_UNTIL):
            page = snapshot(client, session_id, min(SETTLE_SECONDS, left))
    except Exception:  # noqa: BLE001
        return {}
    return {key: page[key] for key in ("url", "title", "tree", "elements", "loading") if key in page}


MAX_UPLOAD_FILES = 10
MAX_UPLOAD_BYTES = 100 * 1024 * 1024


def max_file_bytes() -> int:
    """The most bytes a file moved between this computer and a page may have, uploaded or downloaded."""
    try:
        override = int(os.environ.get("RAKAZO_BROWSER_UPLOAD_MAX_BYTES", ""))
    except ValueError:
        return MAX_UPLOAD_BYTES
    return override if override > 0 else MAX_UPLOAD_BYTES


def resolve_upload_paths(
    paths: Any, home: str | None = None, roots: list[str] | None = None,
) -> list[str]:
    """Resolve regular files within trusted roots before handing them to Chromium."""
    if not isinstance(paths, list) or not 1 <= len(paths) <= MAX_UPLOAD_FILES:
        raise RuntimeError(f"upload needs 1 to {MAX_UPLOAD_FILES} file paths")
    home = os.path.realpath(home or os.environ.get("HOME") or "/home/rakazo")
    location = "your folder or shared/" if roots is not None else "this computer's home folder"
    allowed = [home]
    if roots is not None:
        allowed = []
        for root in roots:
            expected = os.path.normpath(os.path.join(home, root))
            full = os.path.realpath(expected)
            # A root redirected by a symlink (bots/b1 -> bots/b2) could reach another bot's files.
            if os.path.isabs(root) or full != expected or os.path.commonpath([home, full]) != home:
                raise RuntimeError(f"Upload files must be inside {location}")
            # A folder that does not exist yet holds no files; the other root still applies.
            if os.path.isdir(full):
                allowed.append(full)
    max_bytes = max_file_bytes()
    resolved = []
    total = 0
    for path in paths:
        if not isinstance(path, str) or not path.strip():
            raise RuntimeError("upload paths must be non-empty strings")
        full = os.path.realpath(os.path.join(home, path))
        # Check confinement before existence to avoid revealing outside targets.
        if not any(os.path.commonpath([root, full]) == root for root in allowed):
            raise RuntimeError(f"Upload files must be inside {location}: {path}")
        try:
            info = os.stat(full)
        except OSError:
            raise RuntimeError(f"File not found: {path}") from None
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"Not a regular file: {path}")
        total += info.st_size
        if total > max_bytes:
            raise RuntimeError(f"upload files are larger than {max_bytes / (1024 * 1024):g} MB in total")
        resolved.append(full)
    return resolved


# A navigate or act that the host gives the bot's download folder saves the files its page downloads
# there, under the name the site gave (made safe), and lists them in its result.
MAX_DOWNLOADS = MAX_UPLOAD_FILES
# Downloads are waited for until this long after the helper started, inside the supervisor's limit on
# one call. One still running then is listed as downloading and given its name when it finishes.
DOWNLOAD_WAIT_UNTIL = 15.0
# A document whose answer is a download ends its request a moment before the download begins. A
# document still unanswered this long after it was requested is a slow page, not waited for longer.
DOWNLOAD_BEGIN_SECONDS = 0.5
DOCUMENT_WAIT_SECONDS = 5.0
FINISH_LATER_SECONDS = 15 * 60
STARTED = time.monotonic()
DOWNLOAD_FAILED = "The download failed."
DOWNLOADS_UNUSABLE = "Downloads cannot be saved on this computer: its Downloads folder is not usable."
TOO_MANY_DOWNLOADS = f"downloads not saved: a call saves at most {MAX_DOWNLOADS} files."


def download_folder(folder: Any, home: str) -> str:
    """The bot's download folder, made inside the home folder without passing through a symlink.

    A folder reached through a symlink (bots/b1 -> bots/b2) could put files in another bot's folder.
    """
    if not isinstance(folder, str) or not folder or "\0" in folder or os.path.isabs(folder):
        raise RuntimeError(DOWNLOADS_UNUSABLE)
    expected = os.path.normpath(os.path.join(home, folder))
    if expected == home or os.path.commonpath([home, expected]) != home:
        raise RuntimeError(DOWNLOADS_UNUSABLE)
    path = home
    for part in os.path.relpath(expected, home).split(os.sep):
        path = os.path.join(path, part)
        with contextlib.suppress(FileExistsError):
            os.mkdir(path, 0o755)
        if os.path.islink(path) or not os.path.isdir(path):
            raise RuntimeError(DOWNLOADS_UNUSABLE)
    return expected


def download_name(name: Any) -> str:
    """A site's name for a file as one short, plain path segment: it is untrusted text the bot reads and
    puts in its shell, so shell characters such as `$`, backticks, quotes and `;` become `_` too."""
    text = "".join(
        "_" if char in "/\\$`;|&<>!\"'" else " " if unicodedata.category(char)[0] in "CZ" else char
        for char in unicodedata.normalize("NFC", str(name or ""))
    )
    stem, ext = os.path.splitext(" ".join(text.split()).strip(". "))
    if len(ext) > 12 or " " in ext:
        stem, ext = stem + ext, ""
    while stem and (len(stem) + len(ext) > 80 or len((stem + ext).encode()) > 200):
        stem = stem[:-1]
    stem = stem.rstrip(". ")
    return stem + ext if stem else "download" + ext


def free_name(folder: str, name: str, taken: set[str]) -> str:
    """`name`, or `name (1)` and so on, that nothing in the folder or `taken` already has."""
    stem, ext = os.path.splitext(name)
    for number in range(1000):
        candidate = name if number == 0 else f"{stem} ({number}){ext}"
        if candidate not in taken and not os.path.lexists(os.path.join(folder, candidate)):
            return candidate
    raise RuntimeError(DOWNLOAD_FAILED)


def place_download(staged: str, folder: str, name: str, taken: set[str]) -> str:
    """Give a finished download its name. A link never replaces an existing entry or writes through a symlink."""
    while True:
        chosen = free_name(folder, name, taken)
        try:
            os.link(staged, os.path.join(folder, chosen))
        except FileExistsError:
            taken.add(chosen)
            continue
        os.unlink(staged)
        return chosen


def remove_partial(staged: str) -> None:
    for path in (staged, staged + ".crdownload"):
        with contextlib.suppress(OSError):
            os.unlink(path)


class Downloads:
    """Saves the files a call's page downloads into the bot's folder, from when it is made until `finish`.

    Chromium's download setting covers the whole browser and goes back to its default when the CDP
    connection that made it closes, so the person's own downloads afterwards are unaffected.
    """

    def __init__(self, client: CdpClient, folder: Any, session_id: str | None = None, home: str | None = None) -> None:
        self.client = client
        self.home = os.path.realpath(home or os.environ.get("HOME") or "/home/rakazo")
        try:
            self.folder: str | None = download_folder(folder, self.home)
        except (RuntimeError, OSError):
            # Fail closed: the call's downloads are refused rather than saved anywhere else.
            self.folder = None
        try:
            client.call("Browser.setDownloadBehavior", {
                "behavior": "allowAndName" if self.folder else "deny",
                **({"downloadPath": self.folder} if self.folder else {}),
                "eventsEnabled": True,
            })
        except Exception:  # noqa: BLE001
            # A browser that cannot be told downloads as it would without a folder; the call goes on.
            self.folder = None
        self.max_bytes = max_file_bytes()
        self.stopped: dict[str, str] = {}
        # Only the page's own navigations can turn into downloads; a frame's slow document is not waited for.
        with contextlib.suppress(Exception):
            if session_id:
                frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
                client.download_frame = frame["id"]

    def check_limits(self) -> None:
        """Cancel a download past the call's count or over the size limit; Chromium deletes what it wrote."""
        for index, (guid, download) in enumerate(self.client.downloads.items()):
            if guid in self.stopped or download["state"] not in ("inProgress", "completed"):
                continue
            if index >= MAX_DOWNLOADS:
                self.stopped[guid] = TOO_MANY_DOWNLOADS
            elif max(download["total"], download["received"]) > self.max_bytes:
                self.stopped[guid] = f"Not saved: larger than {self.max_bytes / (1024 * 1024):g} MB."
            else:
                continue
            with contextlib.suppress(Exception):
                self.client.call("Browser.cancelDownload", {"guid": guid})

    def finish(self) -> list[dict[str, Any]]:
        """Wait for the call's downloads within its time, then list each one as the bot will find it."""
        while True:
            self.check_limits()
            running = any(download["state"] == "inProgress" and guid not in self.stopped
                          for guid, download in self.client.downloads.items())
            left = STARTED + DOWNLOAD_WAIT_UNTIL - time.monotonic()
            documents = self.client.documents_pending(DOWNLOAD_BEGIN_SECONDS, DOCUMENT_WAIT_SECONDS)
            if left <= 0 or not (running or documents):
                break
            self.client.listen(min(0.05, left))
        taken: set[str] = set()
        later: list[dict[str, str]] = []
        found = [self.entry(guid, download, taken, later) for guid, download in self.client.downloads.items()]
        if later:
            # Detached and holding none of this call's files or connections, so the call ends now. Each
            # call that leaves a download running starts one; it ends with them or after FINISH_LATER_SECONDS.
            env = {key: value for key, value in os.environ.items()
                   if key not in ("RAKAZO_BROWSER_ARGS_STDIN", "RAKAZO_BROWSER_WATCH_STDIN")}
            subprocess.Popen([sys.executable, os.path.abspath(__file__), "finish", json.dumps({"downloads": later})],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True, close_fds=True, env=env)
        if len(found) > MAX_DOWNLOADS:
            found = found[:MAX_DOWNLOADS] + [{"error": f"{len(found) - MAX_DOWNLOADS} more {TOO_MANY_DOWNLOADS}"}]
        return found

    def entry(self, guid: str, download: dict[str, Any], taken: set[str],
              later: list[dict[str, str]]) -> dict[str, Any]:
        name = download_name(download["name"])
        if self.folder is None:
            return {"name": name, "error": DOWNLOADS_UNUSABLE}
        staged = os.path.join(self.folder, guid)
        if guid in self.stopped or download["state"] not in ("completed", "inProgress"):
            remove_partial(staged)
            return {"name": name, "error": self.stopped.get(guid, DOWNLOAD_FAILED)}
        shown = os.path.relpath(self.folder, self.home)
        if download["state"] == "inProgress":
            # Not held on disk until it finishes: a file given this name meanwhile makes it `name (1)`.
            name = free_name(self.folder, name, taken)
            taken.add(name)
            later.append({"guid": guid, "staged": staged, "folder": self.folder, "name": name})
            return {"name": name, "path": f"{shown}/{name}", "state": "downloading", "size": download["received"]}
        try:
            name = place_download(staged, self.folder, name, taken)
            size = os.stat(os.path.join(self.folder, name)).st_size
        except (OSError, RuntimeError):
            remove_partial(staged)
            return {"name": name, "error": DOWNLOAD_FAILED}
        taken.add(name)
        kind = self.client.mime_type(download["url"]) or mimetypes.guess_type(name)[0]
        return {"name": name, "path": f"{shown}/{name}", "size": size, **({"type": kind} if kind else {})}


def finish_later(pending: list[dict[str, str]], seconds: float = FINISH_LATER_SECONDS) -> None:
    """Name the downloads still running when their call ended once Chromium finishes them.

    Chromium writes `<guid>.crdownload` and renames it `<guid>` when complete. Over the size limit,
    the download is cancelled.
    """
    until = time.monotonic() + seconds
    max_bytes = max_file_bytes()
    begun: set[str] = set()
    while pending and time.monotonic() < until:
        time.sleep(0.5)
        for item in list(pending):
            staged = item["staged"]
            try:
                size = os.path.getsize(staged + ".crdownload")
            except OSError:
                if os.path.exists(staged):
                    pending.remove(item)
                    with contextlib.suppress(OSError, RuntimeError):
                        place_download(staged, item["folder"], item["name"], set())
                elif staged in begun:
                    # Cancelled or failed: Chromium removed what it wrote.
                    pending.remove(item)
                continue
            begun.add(staged)
            if size > max_bytes:
                pending.remove(item)
                with contextlib.suppress(Exception):
                    client = CdpClient(discover_ws_url(cdp_port()))
                    client.connect()
                    try:
                        client.call("Browser.cancelDownload", {"guid": item["guid"]})
                    finally:
                        client.close()
                remove_partial(staged)


def upload(client: CdpClient, session_id: str, ref: str, files: list[str]) -> None:
    # Hand the files to the input directly: no native file chooser is opened.
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": f"window.__rakazoPageBrowser.fileInput({json.dumps(ref)}, {len(files)})",
            "contextId": client.context_id,
            "returnByValue": False,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        raise RuntimeError(
            (details.get("exception") or {}).get("description")
            or details.get("text")
            or "upload failed"
        )
    object_id = (result.get("result") or {}).get("objectId")
    if not object_id:
        raise RuntimeError("upload target unavailable")
    try:
        client.call("DOM.setFileInputFiles", {"files": files, "objectId": object_id},
                    session_id=session_id)
    finally:
        client.call("Runtime.releaseObject", {"objectId": object_id}, session_id=session_id)


SETTLE_SECONDS = 3.0


def wait_for_settle(client: CdpClient, session_id: str, seconds: float | None = None) -> bool:
    """Wait until the page has loaded and made no requests for 500 ms (Chromium's networkIdle).

    Many sites draw a signed-out shell first and replace it once their own requests return,
    so a page captured earlier can show "Sign in" to an account that is signed in.
    """
    deadline = time.monotonic() + (SETTLE_SECONDS if seconds is None else seconds)

    def remaining() -> float:
        budget = deadline - time.monotonic()
        if budget <= 0:
            raise TimeoutError("Page settle budget exhausted")
        return budget

    try:
        # Enabling lifecycle events replays the ones the current document has already reached.
        client.call("Page.setLifecycleEventsEnabled", {"enabled": True}, session_id=session_id,
                    timeout_s=remaining())
        while True:
            # Each call also handles the lifecycle events that arrived meanwhile.
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=remaining())
            if {"load", "networkIdle"} <= client.lifecycle(session_id, frame["frameTree"]["frame"]["id"]):
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(min(0.1, remaining()))
    except TimeoutError:
        # A browser too slow to answer within the wait is not settled either.
        return False


# An action's result waits until its own requests are done and the page has stopped changing for this
# long, then is taken within the settle budget.
ACTION_QUIET_SECONDS = 0.12
# The most an action's result waits for its requests and the snapshot after them together. An action
# that leaves the page for another document waits as long as a snapshot does (SETTLE_SECONDS).
ACTION_WAIT_SECONDS = 2.0
# A request begun this soon after one of the action's finished is set off by its answer.
ACTION_FOLLOW_SECONDS = 0.03
# Page changes later than this after the action's last step or request do not hold the result back, so
# a page that always animates is not waited for.
ACTION_CHANGE_SECONDS = 0.3


def wait_for_action(client: CdpClient, session_id: str, ended: float, seconds: float) -> bool:
    """Wait for what the action set in motion: its own requests, and the page drawing their answers.

    Many actions fetch data and render it afterwards, so a snapshot taken at once shows "loading".
    False when a request of the action is still open `seconds` after its last step.
    """
    deadline = ended + seconds
    while True:
        now = time.monotonic()
        try:
            changed = now - float(eval_json(client, session_id, "window.__rakazoPageBrowser.quietFor()")) / 1000
        except Exception:  # noqa: BLE001
            # A page that moved to another document has no helper yet; its own load is awaited next.
            changed = ended
        pending, finished = client.action_requests(session_id, ended, ACTION_QUIET_SECONDS, ACTION_FOLLOW_SECONDS)
        last = max(ended, finished)
        if changed <= last + ACTION_CHANGE_SECONDS:
            last = max(last, changed)
        if not pending and now - last >= ACTION_QUIET_SECONDS:
            return True
        if now >= deadline:
            return not pending
        client.listen(0.03)


def key_event(char: str) -> dict[str, Any] | None:
    """CDP keyDown parameters for one character, or None for an ASCII control inserted as text."""
    if char == "\n":
        # Shift+Enter breaks the line; many chat boxes send their message on a plain Enter.
        return {"key": "Enter", "code": "Enter", "text": "\r", "windowsVirtualKeyCode": 13, "modifiers": 8}
    # Unicode has no assumed physical key mapping. Dispatch each code point without IME composition;
    # combining sequences and ZWJ emoji are neither normalized nor grouped.
    if len(char) == 1 and ord(char) > 127:
        return {"key": char, "text": char}
    if len(char) != 1 or not " " <= char <= "~":
        return None
    if char.isdigit():
        return {"key": char, "code": f"Digit{char}", "text": char, "windowsVirtualKeyCode": ord(char)}
    if char.isalpha():
        return {"key": char, "code": f"Key{char.upper()}", "text": char,
                "windowsVirtualKeyCode": ord(char.upper())}
    if char == " ":
        return {"key": " ", "code": "Space", "text": " ", "windowsVirtualKeyCode": 32}
    return {"key": char, "text": char}


def press_key(client: CdpClient, session_id: str, event: dict[str, Any]) -> None:
    down = {"type": "keyDown", **event}
    if "text" in event:
        down["unmodifiedText"] = event["text"]
    client.call("Input.dispatchKeyEvent", down, session_id=session_id)
    client.call("Input.dispatchKeyEvent", {"type": "keyUp", **{k: v for k, v in event.items() if k != "text"}},
                session_id=session_id)


class TypingStopped(RuntimeError):
    """Typing ended before the last key. The message never repeats any of the text."""


NOT_KEPT = "The page did not keep every character typed. Check the field in this snapshot before trying again."


class KeysNotKept(RuntimeError):
    """Every key was pressed, but the field did not keep them all: the step ran, its result is wrong."""


def focus_holds(client: CdpClient, session_id: str) -> bool | None:
    """Whether keys still reach the field or its code boxes; None once its document is gone."""
    try:
        return eval_json(client, session_id, "window.__rakazoPageBrowser.focusHolds()") is True
    except Exception:  # noqa: BLE001
        return None


def frame_in_tree(client: CdpClient, session_id: str, frame_id: str | None = None,
                  timeout_s: float = 10.0) -> dict[str, Any] | None:
    """The session's root frame, or the frame frame_id in its tree."""
    stack = [client.call("Page.getFrameTree", session_id=session_id, timeout_s=timeout_s)["frameTree"]]
    while stack:
        node = stack.pop()
        if frame_id is None or node["frame"]["id"] == frame_id:
            return node["frame"]
        stack += node.get("childFrames") or []
    return None


def page_mark(client: CdpClient, session_id: str, frame_id: str | None = None) -> tuple[dict[str, Any], int]:
    """The frame typed into (the main frame by default) and its navigation count, taken before a type step."""
    frame = frame_in_tree(client, session_id, frame_id)
    if frame is None:
        raise Settled(STALE_REF)
    return frame, client.navigations(session_id, frame["id"])


def type_keys(client: CdpClient, session_id: str, text: str, multiline: bool,
              mark: tuple[dict[str, Any], int]) -> bool:
    """Press each character as a real key into whatever element has focus at that moment.

    Before each key, the page must still be the document of mark, with focus in the field or in a
    box of its code. The check also reads the browser's navigation events, which a page reports
    before the evaluation's answer, so a page that navigates on a key, or while its field was being
    emptied, gets no further keys.
    Returns whether the page moved to another document on the last key, as auto-submitting codes do.
    Either way, the next document has replaced the old one before this returns, when it loads in time.
    """
    frame, navigations = mark
    frame_id = frame["id"]

    def moved_on(holds: bool | None) -> bool:
        if holds is not None and client.navigations(session_id, frame_id) == navigations:
            return False
        wait_for_new_document(client, session_id, frame_id, frame.get("loaderId"))
        return True

    # Enter in a one-line field would submit its form.
    chars = [char for char in text.replace("\r\n", "\n").replace("\r", "\n") if multiline or char != "\n"]
    for index, char in enumerate(chars):
        holds = focus_holds(client, session_id)
        if moved_on(holds):
            raise TypingStopped(f"The page changed while typing, after {index} of {len(chars)} characters, "
                                "so the rest was not typed. Take a fresh snapshot before continuing.")
        if not holds:
            raise TypingStopped(f"Focus left the field while typing, after {index} of {len(chars)} characters, "
                                "so the rest was not typed. Check the page in this snapshot before trying again.")
        event = key_event(char)
        if event is None:
            client.call("Input.insertText", {"text": char}, session_id=session_id)
        else:
            press_key(client, session_id, event)
    return moved_on(focus_holds(client, session_id))


def wait_for_new_document(client: CdpClient, session_id: str, frame_id: str, loader_id: Any) -> None:
    """Give a frame that began loading another document the settle budget to replace the old one."""
    deadline = time.monotonic() + SETTLE_SECONDS
    while time.monotonic() < deadline:
        try:
            frame = frame_in_tree(client, session_id, frame_id, timeout_s=SETTLE_SECONDS)
            if frame is None or frame.get("loaderId") != loader_id:
                return
        except Exception:  # noqa: BLE001
            return
        time.sleep(0.05)


def typed_in_full(client: CdpClient, session_id: str, ref: str, text: str) -> bool:
    """A widget may refuse keys. A page that submitted or navigated on the last key counts as done."""
    try:
        return eval_json(client, session_id,
                         f"window.__rakazoPageBrowser.typed({json.dumps(ref)}, {json.dumps(text)})") is not False
    except Exception:  # noqa: BLE001
        return True


def payment_frames(client: CdpClient, session_id: str) -> list[tuple[str, str, int]]:
    """Visible frames of a known payment provider that the page itself shows: (session, frame, world).

    Only frames whose owner element is in the page's own documents count, so a provider frame
    inside an ad or other third-party frame on the checkout never receives the card.
    """
    client.call("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": False, "flatten": True,
                                         "filter": [{"type": "iframe"}]}, session_id=session_id)
    frames = []
    for frame_session in client.frame_sessions(session_id)[:32]:
        try:
            frame = client.call("Page.getFrameTree", session_id=frame_session)["frameTree"]["frame"]
            if not payment_frame_origin(frame.get("url")):
                continue
            owner = client.call("DOM.getFrameOwner", {"frameId": frame["id"]}, session_id=session_id)
            if not frame_owner_visible(client, session_id, owner["backendNodeId"]):
                continue
            client.call("Page.enable", session_id=frame_session)
            world = world_in(client, frame_session, frame["id"])
            eval_json(client, frame_session, EVAL_HELPERS, context_id=world)
            frames.append((frame_session, frame["id"], world))
        except Exception:  # noqa: BLE001
            continue
    return frames


FRAME_OWNER_VISIBLE = """function () {
  for (let el = this; el; el = el.parentElement) {
    const style = getComputedStyle(el);
    if (style.display === "none" || style.visibility !== "visible" || Number(style.opacity) === 0) return false;
  }
  const box = this.getBoundingClientRect();
  // A frame sized to nothing still draws its border, which is not a page anyone can see.
  return box.width > 1 && box.height > 1 && this.clientWidth > 1 && this.clientHeight > 1;
}"""


def frame_owner_visible(client: CdpClient, session_id: str, backend_node_id: int, world: int | None = None) -> bool:
    # Resolved in the helper's isolated world, so the page cannot fake the answer; an owner outside it fails.
    node = client.call("DOM.resolveNode", {"backendNodeId": backend_node_id,
                                           "executionContextId": client.context_id if world is None else world},
                       session_id=session_id)
    result = client.call("Runtime.callFunctionOn", {"objectId": node["object"]["objectId"],
                                                    "functionDeclaration": FRAME_OWNER_VISIBLE,
                                                    "returnByValue": True}, session_id=session_id)
    return result.get("result", {}).get("value") is True


def frame_eval(client: CdpClient, frames: list[tuple[str, str, int]], expression: str) -> list[Any]:
    """`expression` in each frame, with None for a frame that failed."""
    results = []
    for frame_session, _, world in frames:
        try:
            results.append(eval_json(client, frame_session, expression, context_id=world))
        except Exception:  # noqa: BLE001
            results.append(None)
    return results


def pay_token_frames(client: CdpClient, frames: list[tuple[str, str, int]]) -> list[tuple[str, str, int]]:
    return [frame for frame, origin in zip(frames, frame_eval(client, frames, "location.origin"))
            if origin == PAY_TOKEN_FRAME_ORIGIN]



# Frames of any origin, read and acted in through their own isolated worlds. Each frame's helper hands
# out refs starting with "f" and answers only for its own, in a world the page cannot reach; a
# login, card or code goes into a frame only when the frame itself is on its site.

MAX_PAGE_FRAMES = 16
MAX_FRAME_DEPTH = 4
# The most a snapshot spends on frames, beyond the page itself.
FRAMES_SECONDS = 4.0
# What one frame may take to answer while the frames are listed; a frame busy in a loop answers nothing.
FRAME_CALL_SECONDS = 1.5
# The page helper's budget for a snapshot (TREE_BUDGET, CONTROLS_BUDGET, MAX_CONTROLS there). Frames
# share at most FRAMES_BUDGET of it, and the page itself keeps the rest.
TREE_BUDGET = 10000
CONTROLS_SHARE = 0.55
MAX_CONTROLS = 80
FRAMES_BUDGET = 5000
MIN_FRAME_SHARE = 600
UNREAD_FRAMES = "Embedded frames require desktop tools."
STALE_REF = "Stale element ref: the page has changed since that snapshot. Use a ref from the page below."
TWO_FRAMES = "Two frames answer to that ref, so nothing was done. Take a fresh snapshot."
FRAME_SPOT_TAKEN = ("Something other than this element's frame is at that spot, so the click was not made. "
                    "Use the page below and click again.")
FRAME_DRAWN = "The frame holding this element is drawn scaled or turned, so the page tools cannot click in it."
FRAME_SPOT = "function (x, y, moved) { return window.__rakazoPageBrowser.frameSpot(this, x, y, moved); }"


class PageFrame:
    """A frame of the page: the CDP session it is local to, its helper's world, its element in its parent."""

    def __init__(self, session: str, frame_id: str, parent: PageFrame | None, world: int, owner: int | None,
                 url: str = "") -> None:
        self.session, self.id, self.parent, self.world, self.owner, self.url = (
            session, frame_id, parent, world, owner, url)

    def chain(self) -> list[PageFrame]:
        """This frame and the frames around it, up to but not including the top page."""
        levels, at = [], self
        while at.parent is not None:
            levels.append(at)
            at = at.parent
        return levels


def is_frame_ref(ref: Any) -> bool:
    return isinstance(ref, str) and len(ref) > 1 and ref[0] == "f" and ref[1:].isdigit()


def frame_tree(client: CdpClient, session_id: str, deadline: float) -> tuple[
        dict[str, tuple[str, str]], dict[str, list[str]], int]:
    """Every frame of the page, in its process or not: frame id -> (session it is local to, url), each
    frame's children, and how many frames of other processes were left unvisited.

    Frames of another process come through auto-attached sessions, frames inside them through theirs.
    A session listed later wins, so a frame is read where it is local.
    """
    local: dict[str, tuple[str, str]] = {}
    parents: dict[str, str] = {}
    sessions, seen, failed = [session_id], set(), 0
    while sessions and len(seen) <= MAX_PAGE_FRAMES and time.monotonic() < deadline:
        session = sessions.pop(0)
        if session in seen:
            continue
        seen.add(session)
        try:
            with time_limit(client, min(deadline, time.monotonic() + FRAME_CALL_SECONDS)):
                if session != session_id:
                    client.call("Page.enable", session_id=session)
                client.call("Target.setAutoAttach", {"autoAttach": True, "waitForDebuggerOnStart": False,
                                                     "flatten": True, "filter": [{"type": "iframe"}]},
                            session_id=session)
                sessions += client.frame_sessions(session)
                tree = client.call("Page.getFrameTree", session_id=session)["frameTree"]
        except Exception:  # noqa: BLE001
            failed += 1
            continue
        if session != session_id and not tree["frame"].get("parentId"):
            # A frame that cannot be placed in the page is not read; payment providers' are never read.
            failed += 0 if payment_frame_origin(tree["frame"].get("url")) else 1
            continue
        stack = [(tree, tree["frame"].get("parentId"))]
        while stack:
            node, parent = stack.pop()
            frame = node["frame"]
            local[frame["id"]] = (session, str(frame.get("url") or ""))
            if parent:
                parents[frame["id"]] = parent
            stack += [(child, frame["id"]) for child in reversed(node.get("childFrames") or [])]
    children: dict[str, list[str]] = {}
    for frame_id, parent in parents.items():
        children.setdefault(parent, []).append(frame_id)
    return local, children, failed + len({session for session in sessions if session not in seen})


def page_frames(client: CdpClient, session_id: str, deadline: float) -> tuple[list[PageFrame], int]:
    """The page's frames that the page tools can read, outermost first in page order, with how many
    shown frames could not be read (over the limits, or unreachable).

    A frame whose element, or any frame element around it, is hidden is left out with what is inside
    it. Payment providers' frames are too: card details reach them only through fill_card.
    """
    local, children, unread = frame_tree(client, session_id, deadline)
    main = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]["id"]
    found: list[PageFrame] = []

    def visit(parent: PageFrame, depth: int) -> None:
        nonlocal unread
        owners: dict[str, int] = {}
        for frame_id in children.get(parent.id, []):
            if payment_frame_origin(local[frame_id][1]):
                continue
            try:
                owners[frame_id] = client.call("DOM.getFrameOwner", {"frameId": frame_id},
                                               session_id=parent.session)["backendNodeId"]
            except Exception:  # noqa: BLE001
                unread += 1
        for frame_id in in_page_order(client, parent, owners):
            session, url = local[frame_id]
            if time.monotonic() > deadline:
                unread += 1
                continue
            try:
                if not frame_owner_visible(client, parent.session, owners[frame_id], parent.world):
                    continue
                if len(found) >= MAX_PAGE_FRAMES or depth > MAX_FRAME_DEPTH:
                    unread += 1
                    continue
                world = world_in(client, session, frame_id)
                eval_json(client, session, EVAL_HELPERS, context_id=world)
            except Exception:  # noqa: BLE001
                unread += 1
                continue
            frame = PageFrame(session, frame_id, parent, world, owners[frame_id], url)
            found.append(frame)
            visit(frame, depth + 1)

    with time_limit(client, deadline):
        visit(PageFrame(session_id, main, None, client.context_id, None), 1)
    return found, unread


IN_PAGE_ORDER = """function (...owners) {
  return owners.map((_, at) => at).sort((a, b) => (owners[a].compareDocumentPosition(owners[b])
    & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
}"""


def in_page_order(client: CdpClient, parent: PageFrame, owners: dict[str, int]) -> list[str]:
    """The frames of a parent in the order their elements come in its page; frames in other processes are
    only found session by session."""
    frame_ids = list(owners)
    if len(frame_ids) < 2:
        return frame_ids
    try:
        objects = [client.call("DOM.resolveNode", {"backendNodeId": owner, "executionContextId": parent.world},
                               session_id=parent.session)["object"]["objectId"] for owner in owners.values()]
        result = client.call("Runtime.callFunctionOn", {
            "executionContextId": parent.world, "functionDeclaration": IN_PAGE_ORDER, "returnByValue": True,
            "arguments": [{"objectId": object_id} for object_id in objects]}, session_id=parent.session)
        return [frame_ids[at] for at in result["result"]["value"]]
    except Exception:  # noqa: BLE001
        return frame_ids


def sent_length(text: str) -> int:
    """A text's length as the bot receives it, line breaks escaped (the page helper's sent())."""
    return len(json.dumps(text, ensure_ascii=False)) - 2


def snapshot_limits(prefix: str, budget: int) -> dict[str, Any]:
    return {"prefix": prefix, "tree": budget, "controls": int(budget * CONTROLS_SHARE),
            "maxControls": max(8, MAX_CONTROLS * budget // TREE_BUDGET), "minText": min(1500, budget // 4)}


def frame_snapshots(client: CdpClient, session_id: str) -> tuple[str, list[Any], int]:
    """Each shown frame's page under a line naming its site, their elements, and how many shown
    frames could not be read. Frames with nothing in them are left out."""
    deadline = time.monotonic() + FRAMES_SECONDS
    try:
        frames, unread = page_frames(client, session_id, deadline)
    except Exception:  # noqa: BLE001
        return "", [], 1
    if not frames:
        return "", [], unread
    sections, elements, left = [], [], FRAMES_BUDGET
    for index, frame in enumerate(frames):
        # What the frames before it left over goes to the ones after.
        share = max(MIN_FRAME_SHARE, left // (len(frames) - index))
        if time.monotonic() > deadline or left < MIN_FRAME_SHARE:
            unread += len(frames) - index
            break
        limits = json.dumps(snapshot_limits("f", share))
        try:
            with time_limit(client, deadline):
                data = eval_json(client, frame.session, "({...window.__rakazoPageBrowser.snapshot(" + limits + "), "
                                 "origin: location.origin, scheme: location.protocol})", context_id=frame.world)
        except Exception:  # noqa: BLE001
            unread += 1
            continue
        if not isinstance(data, dict):
            unread += 1
            continue
        tree = unframed(str(data.get("tree") or "").strip())
        if tree in ("", "(no interactive elements)"):
            continue
        site = data.get("origin") if data.get("origin") not in (None, "", "null") else data.get("scheme")
        section = f"[frame {site}]\n{tree}"
        if sent_length(section) + 1 > left:
            unread += 1
            continue
        left -= sent_length(section) + 1
        sections.append(section)
        elements += data.get("elements") or []
    return "".join("\n" + section for section in sections), elements, unread


def unframed(text: str) -> str:
    """Page text with anything that reads like a frame's header line set apart, so a page cannot name a site."""
    return text.replace("[frame ", "[ frame ")


def frame_of(client: CdpClient, session_id: str, ref: str, known: list[PageFrame]) -> PageFrame:
    """The one frame whose helper handed out ref. `known` holds the frames found earlier in this action;
    they are found again only when none or two of them answer to ref."""
    deadline = time.monotonic() + FRAMES_SECONDS

    def owners_of(frames: list[PageFrame]) -> list[PageFrame]:
        owners = []
        for frame in frames:
            try:
                with time_limit(client, deadline):
                    if eval_json(client, frame.session, f"window.__rakazoPageBrowser.owns({json.dumps(ref)})",
                                 context_id=frame.world) is True:
                        owners.append(frame)
            except Exception:  # noqa: BLE001
                continue
        return owners

    owners = owners_of(known)
    if len(owners) != 1:
        known[:] = page_frames(client, session_id, deadline)[0]
        owners = owners_of(known)
    if not owners:
        raise Settled(STALE_REF)
    if len(owners) > 1:
        raise Settled(TWO_FRAMES)
    return owners[0]


@contextlib.contextmanager
def time_limit(client: CdpClient, until: float):  # type: ignore[no-untyped-def]
    """No call waits past `until` (on the monotonic clock) meanwhile: a frame busy in a loop answers nothing."""
    before = client.deadline
    limit = time.time() + until - time.monotonic()
    client.deadline = limit if before is None else min(before, limit)
    try:
        yield
    finally:
        client.deadline = before


@contextlib.contextmanager
def in_frame(client: CdpClient, frame: PageFrame):  # type: ignore[no-untyped-def]
    """Helpers written for the top page evaluate in this frame's world meanwhile."""
    top = client.context_id
    client.context_id = frame.world
    try:
        yield
    finally:
        client.context_id = top


def frame_spot(client: CdpClient, frame: PageFrame, x: float, y: float, moved: bool) -> tuple[float, float, dict[str, Any]]:
    """The spot (x, y) of the frame's page as a spot in the browser window, with the top page's scroll.

    At every level the frame element around it must show that spot: not covered, hidden, or drawn
    scaled or turned. Each level is asked in its parent's world.
    """
    scroll: dict[str, Any] = {}
    for level in frame.chain():
        parent = level.parent
        assert parent is not None
        try:
            node = client.call("DOM.resolveNode", {"backendNodeId": level.owner, "executionContextId": parent.world},
                               session_id=parent.session)
            object_id = node["object"]["objectId"]
            try:
                result = client.call("Runtime.callFunctionOn", {
                    "objectId": object_id, "functionDeclaration": FRAME_SPOT, "returnByValue": True,
                    "arguments": [{"value": x}, {"value": y}, {"value": moved}],
                }, session_id=parent.session)
            finally:
                client.call("Runtime.releaseObject", {"objectId": object_id}, session_id=parent.session)
            spot = page_value(result)
        except Refused:
            raise
        except (RuntimeError, KeyError, TypeError):
            raise Settled(CHANGED_UNDER_POINTER) from None
        if not isinstance(spot, dict):
            raise Settled(CHANGED_UNDER_POINTER)
        check_upright(client, parent.session, level.owner, spot)
        x, y, scroll = spot["x"], spot["y"], spot.get("scroll") or {}
    return x, y, scroll


def check_upright(client: CdpClient, session_id: str, owner: int | None, spot: dict[str, Any]) -> None:
    """Where the browser itself draws the frame element's content: upright and at its own size, whatever
    style turned, flipped or scaled it. The page script reads styles; this reads the drawn corners."""
    try:
        quad = client.call("DOM.getBoxModel", {"backendNodeId": owner}, session_id=session_id)["model"]["content"]
        x1, y1, x2, y2, x3, y3, x4, y4 = (float(value) for value in quad)
    except (RuntimeError, KeyError, TypeError, ValueError):
        raise Settled(CHANGED_UNDER_POINTER) from None
    width, height = float(spot.get("width") or 0), float(spot.get("height") or 0)
    upright = (abs(y2 - y1) <= 1 and abs(x3 - x2) <= 1 and abs(y3 - y4) <= 1 and abs(x4 - x1) <= 1
               and abs((x2 - x1) - width) <= max(1.0, width * 0.02) and abs((y4 - y1) - height) <= max(1.0, height * 0.02))
    if not upright:
        raise Settled(FRAME_DRAWN)


def check_frame_spot(client: CdpClient, session_id: str, frame: PageFrame, x: float, y: float) -> None:
    """The browser's own hit-test at the spot (x, y) of the top page must reach the frame: the frame itself
    when the page's process holds it, else the element of the first frame on the way in another process."""
    # The hit-test takes whole pixels; a scroll offset may not be one.
    hit, node = hit_at(client, session_id, round(x), round(y))
    levels = frame.chain()
    boundary = next((level for level in reversed(levels) if level.session != session_id), None)
    if boundary is None:
        reached = hit.get("frameId") == frame.id and str(node.get("nodeName", "")).upper() not in (
            "IFRAME", "FRAME", "OBJECT", "EMBED")
    else:
        assert boundary.parent is not None
        reached = hit.get("backendNodeId") == boundary.owner and hit.get("frameId") == boundary.parent.id
    if not reached:
        raise Settled(FRAME_SPOT_TAKEN)


def frame_click(client: CdpClient, session_id: str, frame: PageFrame, ref: str) -> None:
    """A real mouse click on an element inside a frame, sent to the top page at the element's spot in the window.

    Checked in the frame and at every frame element around it before the pointer moves, again after,
    and by the browser's own hit-test right before the press.
    """
    def in_page(expression: str) -> Any:
        return eval_json(client, frame.session, expression, context_id=frame.world)

    aim = in_page(f"window.__rakazoPageBrowser.aim({json.dumps(ref)})")
    if not isinstance(aim, dict) or aim.get("x") is None:
        return
    # The browser's hit-test takes whole pixels, so the press goes to the same one.
    x, y = (round(value) for value in frame_spot(client, frame, aim["x"], aim["y"], False)[:2])
    base = {"x": x, "y": y, "pointerType": "mouse"}
    draw_frames(client, session_id)
    client.call("Input.dispatchMouseEvent", {**base, "type": "mouseMoved"}, session_id=session_id)
    in_page(f"window.__rakazoPageBrowser.stillAimed({json.dumps(ref)}, {aim['x']}, {aim['y']})")
    again_x, again_y, scroll = frame_spot(client, frame, aim["x"], aim["y"], True)
    if round(again_x) != x or round(again_y) != y:
        raise Settled(CHANGED_UNDER_POINTER)
    check_frame_spot(client, session_id, frame, x + scroll.get("x", 0), y + scroll.get("y", 0))
    client.call("Input.dispatchMouseEvent", {**base, "type": "mousePressed", "button": "left", "buttons": 1,
                                             "clickCount": 1}, session_id=session_id)
    client.call("Input.dispatchMouseEvent", {**base, "type": "mouseReleased", "button": "left",
                                             "clickCount": 1}, session_id=session_id)


def frame_site_check(client: CdpClient, frame: PageFrame, step: dict[str, Any]) -> None:
    """A saved login, card or code goes into a frame only when the frame itself is on its site, an HTTPS
    page inside HTTPS pages. The fill checks the frame's site again in the same evaluation."""
    found = eval_json(client, frame.session, "(() => { let saved = null; try { saved = new URL("
                      + json.dumps(step["origin"]) + ").origin; } catch { /* refused below */ } "
                      "return { origin: location.origin, same: location.origin === saved, sandboxed: self.origin !== location.origin, "
                      "secure: location.protocol === 'https:' && window.isSecureContext !== false }; })()",
                      context_id=frame.world)
    login = step.get("field") in ("username", "password")
    if not isinstance(found, dict) or not found.get("secure"):
        raise Refused("Website logins can only be filled on HTTPS, and this field's frame is not an HTTPS page "
                      "inside HTTPS pages." if login else
                      "This field's frame is not an HTTPS page inside HTTPS pages, so nothing was filled.")
    if found.get("sandboxed"):
        # Served from its site but run sandboxed, without that site's own origin: not the site's page as such.
        raise Refused("This field is in a sandboxed frame, so nothing was filled.")
    if not found.get("same"):
        raise Refused(f"This field is in a frame from {found.get('origin')}, not on the site this login was saved "
                      "for, so nothing was filled." if login else
                      f"This field is in a frame from {found.get('origin')}, not on the site it is meant for, "
                      "so nothing was filled.")


def frame_step(client: CdpClient, session_id: str, step: dict[str, Any], touched: dict[str, PageFrame],
               known: list[PageFrame]) -> bool:
    """One step on an element inside a frame, as act takes it on the page itself.

    Returns whether the frame's page moved to another document on the last key of a type step.
    """
    kind, ref = step["kind"], step["ref"]
    frame = frame_of(client, session_id, ref, known)
    touched[frame.id] = frame
    if frame.session != session_id:
        # Requests the step sets off in a frame of another process are its session's, and so is a file
        # chooser it opens, which is held back as on the page itself.
        for method, params in (("Network.enable", {"maxPostDataSize": 1}),
                               ("Page.setInterceptFileChooserDialog", {"enabled": True})):
            try:
                client.call(method, params, session_id=frame.session)
            except Exception:  # noqa: BLE001
                pass
    if kind == "click":
        eval_json(client, frame.session, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))",
                  context_id=frame.world)
        note_download_link(client, frame.session, ref, frame.world)
        frame_click(client, session_id, frame, ref)
        return False
    with in_frame(client, frame):
        eval_json(client, frame.session, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))")
        if kind == "upload":
            upload(client, frame.session, ref, step["files"])
            return False
        if kind == "type":
            mark = page_mark(client, frame.session, frame.id)
            whole = json.dumps(len(step["text"]) > 1)
            focus = eval_json(client, frame.session,
                              f"window.__rakazoPageBrowser.focusForKeys({json.dumps(ref)}, {whole})")
            if not (isinstance(focus, dict) and focus.get("select")):
                if not isinstance(focus, dict) or not focus.get("focused"):
                    raise RuntimeError("The field did not take keyboard focus. Click it, then type again.")
                moved = type_keys(client, frame.session, step["text"], multiline=bool(focus.get("multiline")),
                                  mark=mark)
                if not moved and not typed_in_full(client, frame.session, ref, step["text"]):
                    raise KeysNotKept(NOT_KEPT)
                return moved
        if step.get("origin"):
            frame_site_check(client, frame, step)
        arguments = json.dumps(ref) + ", " + json.dumps(step["text"])
        if step.get("origin"):
            arguments += ", " + json.dumps(step["origin"]) + ", " + json.dumps(step.get("field"))
        data = eval_json(client, frame.session, f"window.__rakazoPageBrowser.fill({arguments})")
        if not isinstance(data, dict):
            raise RuntimeError("Action response unavailable")
        if data.get("insertText"):
            client.call("Input.insertText", {"text": step["text"]}, session_id=frame.session)
    return False


def wait_for_frames(client: CdpClient, frames: dict[str, PageFrame], ended: float, seconds: float) -> bool:
    """Wait, within the action's budget, for the frames it acted in: their requests and their pages drawing."""
    calm = True
    for frame in frames.values():
        with in_frame(client, frame):
            calm = wait_for_action(client, frame.session, ended, seconds) and calm
    return calm


def snapshot(client: CdpClient, session_id: str, settle: float | None = None) -> dict[str, Any]:
    settled = wait_for_settle(client, session_id, settle)
    ensure_helpers(client, session_id)
    data = eval_json(client, session_id, "window.__rakazoPageBrowser.snapshot()")
    if not isinstance(data, dict):
        raise RuntimeError("snapshot returned non-object")
    tree = str(data.get("tree") or "")
    account = eval_json(client, session_id, "window.__rakazoPageBrowser.payTokenAccount()")
    if data.pop("frames", False):
        try:
            with time_limit(client, time.monotonic() + FRAMES_SECONDS):
                frames = payment_frames(client, session_id)
        except Exception:  # noqa: BLE001
            frames = []
        card_shown = any(frame_eval(client, frames, "window.__rakazoPageBrowser.hasCardField()"))
        sections, frame_elements, unread = frame_snapshots(client, session_id)
        if sections and sent_length(tree) + sent_length(sections) > TREE_BUDGET:
            # The frames' share comes out of the page's own, so the whole snapshot still goes to the bot in one piece.
            room = max(TREE_BUDGET - FRAMES_BUDGET, TREE_BUDGET - sent_length(sections))
            data = eval_json(client, session_id, "window.__rakazoPageBrowser.snapshot("
                             + json.dumps(snapshot_limits("e", room)) + ")")
            if not isinstance(data, dict):
                raise RuntimeError("snapshot returned non-object")
            data.pop("frames", None)
            tree = str(data.get("tree") or "")
        tree = unframed(tree) + sections
        data["elements"] = list(data.get("elements") or []) + frame_elements
        if card_shown:
            tree += "\n" + PAYMENT_FRAME_HINT
        if unread or (frames and not card_shown):
            tree += "\n" + UNREAD_FRAMES
        accounts = [found for found in frame_eval(client, pay_token_frames(client, frames),
                                                  "window.__rakazoPageBrowser.payTokenAccount()") if found]
        account = account or (accounts[0] if len(accounts) == 1 else None)
    if isinstance(account, str):
        tree += "\n" + pay_token_hint(account)
    data["tree"] = tree
    return {"ok": True, **data, **({} if settled else {"loading": True})}


def find_card_field(client: CdpClient, session_id: str, main_frame_id: str, token: str) -> tuple[str, str, int]:
    """The one field the page shows for this card detail, in the page itself or else in a payment frame."""
    find = f"window.__rakazoPageBrowser.findCard({json.dumps(token)})"
    found = eval_json(client, session_id, find)
    if found == 1:
        return session_id, main_frame_id, client.context_id
    if found:
        raise Refused(CARD_FIELD_AMBIGUOUS)
    matches = [frame for frame in payment_frames(client, session_id)
               for _ in range(eval_json(client, frame[0], find, context_id=frame[2]) or 0)]
    if not matches:
        raise Refused(CARD_FIELD_MISSING)
    if len(matches) > 1:
        raise Refused(CARD_FIELD_AMBIGUOUS)
    return matches[0]


def merchant_check(client: CdpClient, session_id: str, origin: str) -> Any:
    """A check that the top page is still the document it was on now, and on the merchant's origin."""
    if not origin.startswith("https://"):
        raise Refused("A card can only be filled on HTTPS. "
                      "Open the merchant's checkout with browser_navigate, then fill again.")
    top_world = client.context_id
    main_frame, top_navigations = page_mark(client, session_id)

    def on_merchant() -> bool:
        return (client.navigations(session_id, main_frame["id"]) == top_navigations
                and eval_json(client, session_id, "location.origin", context_id=top_world) == origin)

    if not on_merchant():
        raise Refused(NOT_ON_MERCHANT)
    on_merchant.main_frame_id = main_frame["id"]  # type: ignore[attr-defined]
    return on_merchant


def fill_pay_token(client: CdpClient, session_id: str, step: dict[str, Any]) -> None:
    """Hand an approved pay token to the merchant account's hidden block, in the page or Stripe's frame.

    The token is passed as a call argument, never in script source or the result, and only once the
    top page is still the merchant's and the block names the purchase's merchant account.
    """
    on_merchant = merchant_check(client, session_id, step["origin"])
    account = step["merchantAccountId"]
    lookup = "window.__rakazoPageBrowser.payTokenAccount()"
    targets = []
    if eval_json(client, session_id, lookup) == account:
        targets.append((session_id, on_merchant.main_frame_id, client.context_id))
    else:
        frames = pay_token_frames(client, payment_frames(client, session_id))
        targets = [frame for frame, found in zip(frames, frame_eval(client, frames, lookup)) if found == account]
    if len(targets) != 1:
        raise Refused(PAY_TOKEN_MISSING)
    target_session, _, world = targets[0]
    if not on_merchant() or (target_session != session_id and eval_json(
            client, target_session, "location.origin", context_id=world) != PAY_TOKEN_FRAME_ORIGIN):
        raise Refused(NOT_ON_MERCHANT)
    try:
        result = client.call("Runtime.callFunctionOn", {
            "functionDeclaration": "function (token) { return window.__rakazoPageBrowser.setPayToken(token); }",
            "executionContextId": world,
            "arguments": [{"value": step["text"]}],
            "returnByValue": True,
        }, session_id=target_session)
    except Exception:  # noqa: BLE001
        raise RuntimeError("The pay token could not be handed to the checkout.") from None
    if result.get("exceptionDetails") or (result.get("result") or {}).get("value") is not True:
        raise Refused("The checkout didn't take the pay token. Take a fresh snapshot before trying again.")


def fill_card(client: CdpClient, session_id: str, step: dict[str, Any]) -> None:
    """Type a card detail with trusted input into the field the page or its payment frame marks for it.

    Before every key the top page must still be the merchant's document, the frame its payment
    provider's, and the field focused, so a navigation between finding the field and typing refuses.
    """
    text = step["text"]
    if step["cardField"] == "expiry":
        text = "".join(char for char in text if char.isalnum())
    on_merchant = merchant_check(client, session_id, step["origin"])
    field_session, frame_id, world = find_card_field(client, session_id, on_merchant.main_frame_id,
                                                     CARD_AUTOCOMPLETE[step["cardField"]])
    in_frame = field_session != session_id
    frame_navigations = client.navigations(field_session, frame_id)

    def run(expression: str) -> Any:
        return eval_json(client, field_session, expression, context_id=world)

    def stopped() -> str | None:
        if not on_merchant():
            return NOT_ON_MERCHANT
        if in_frame and (client.navigations(field_session, frame_id) != frame_navigations
                         or not payment_frame_origin(run("location.origin"))):
            return "The payment frame changed, so the card was not typed. Take a fresh snapshot before trying again."
        return None

    if run("window.__rakazoPageBrowser.focusCard()") is not True:
        raise Refused("The card field did not take focus, so nothing was typed.")
    for index, char in enumerate(text):
        reason = stopped() or (None if run("window.__rakazoPageBrowser.cardHolds()") is True else
                               "Focus left the card field, so the card was not typed. Fill it again.")
        if reason:
            if index:
                clear_or_uncertain(client, field_session, run, reason)
            raise Refused(reason)
        client.call("Input.insertText", {"text": char}, session_id=field_session)
    reason = stopped()
    if reason:
        clear_or_uncertain(client, field_session, run, reason)
        raise Refused(reason)
    # Fields often move on to the next one by themselves once complete, so focus is not checked here.
    if run(f"window.__rakazoPageBrowser.cardTyped({sum(char.isalnum() for char in text)})") is not True:
        reason = "This field didn't accept the card, so it was cleared."
        clear_or_uncertain(client, field_session, run, reason)
        raise Refused(reason)


def clear_or_uncertain(client: CdpClient, session_id: str, run: Any, reason: str) -> None:
    if not clear_card(client, session_id, run):
        raise CardFieldUncertain(f"{reason} The field could not be confirmed empty, so check it before continuing.")


def clear_card(client: CdpClient, session_id: str, run: Any) -> bool:
    """Keys erase what the field's own script kept, then its value is emptied directly; True once it is empty."""
    try:
        if run("window.__rakazoPageBrowser.focusCard()") is True:
            press_key(client, session_id, {"key": "Backspace", "code": "Backspace", "windowsVirtualKeyCode": 8})
        run("window.__rakazoPageBrowser.emptyCard()")
        return run("window.__rakazoPageBrowser.cardTyped(0)") is True
    except Exception:  # noqa: BLE001
        return False


def draw_frames(client: CdpClient, session_id: str) -> None:
    """Let the page draw, so the browser's own hit-test knows where a scroll left things."""
    try:
        eval_json(client, session_id, "window.__rakazoPageBrowser.nextFrames()")
    except Exception:  # noqa: BLE001
        pass


def check_frame(client: CdpClient, session_id: str, x: float, y: float) -> None:
    """Refuse a press that would land in another document, which the page script cannot see into
    (a frame in a closed shadow tree, for one). The browser itself says which frame owns the spot,
    given as a spot on the page (the window's spot plus the scroll), not in the window.

    Any answer but "the main frame" stops the press, including a failed call. A cross-origin frame runs
    in its own process, so the browser's hit-test stops at its frame element, which the main frame owns:
    that element stops the press too. Right after a scroll the browser may not know the spot yet
    ("No node found"): it gets one more frame to catch up.
    """
    hit, node = hit_at(client, session_id, x, y)
    try:
        main = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]["id"]
    except (RuntimeError, KeyError):
        raise Settled(CHANGED_UNDER_POINTER) from None
    if hit.get("frameId") != main or str(node.get("nodeName", "")).upper() in ("IFRAME", "FRAME", "OBJECT", "EMBED"):
        raise Settled(FRAME_CLICK)


def hit_at(client: CdpClient, session_id: str, x: float, y: float) -> tuple[dict[str, Any], dict[str, Any]]:
    """What the browser's own hit-test finds at a spot on the page: the hit (frame, node) and its node."""
    for attempt in range(2):
        try:
            hit = client.call("DOM.getNodeForLocation", {"x": x, "y": y, "includeUserAgentShadowDOM": True},
                              session_id=session_id)
            node = client.call("DOM.describeNode", {"backendNodeId": hit["backendNodeId"]},
                               session_id=session_id)["node"]
            return hit, node
        except (RuntimeError, KeyError) as error:
            if attempt == 0 and "No node found" in str(error):
                draw_frames(client, session_id)
                continue
            if "No node found" in str(error):
                raise Settled(STILL_MOVING) from None
            raise Settled(CHANGED_UNDER_POINTER) from None
    raise Settled(STILL_MOVING)


def note_download_link(client: CdpClient, session_id: str, ref: str, context_id: int | None = None) -> None:
    """While downloads are saved, a click on a link that downloads is waited on until its download begins."""
    if client.download_frame is None:
        return
    with contextlib.suppress(Exception):
        if eval_json(client, session_id, "Boolean(window.__rakazoPageBrowser.resolve(%s).closest('a[download]'))"
                     % json.dumps(ref), context_id=context_id):
            client.download_links.append(time.monotonic())


def click_at(client: CdpClient, session_id: str, ref: str, x: float, y: float) -> None:
    """A real mouse click, as a person's: pointer enters, button goes down, button comes up.

    A page can answer the pointer by changing what is under it, so the spot is checked again between.
    """
    base = {"x": x, "y": y, "pointerType": "mouse"}
    draw_frames(client, session_id)
    client.call("Input.dispatchMouseEvent", {**base, "type": "mouseMoved"}, session_id=session_id)
    scrolled = eval_json(client, session_id, f"window.__rakazoPageBrowser.stillAimed({json.dumps(ref)}, {x}, {y})")
    scrolled = scrolled if isinstance(scrolled, dict) else {}
    check_frame(client, session_id, x + scrolled.get("x", 0), y + scrolled.get("y", 0))
    client.call("Input.dispatchMouseEvent", {**base, "type": "mousePressed", "button": "left", "buttons": 1,
                                             "clickCount": 1}, session_id=session_id)
    client.call("Input.dispatchMouseEvent", {**base, "type": "mouseReleased", "button": "left",
                                             "clickCount": 1}, session_id=session_id)


def act(client: CdpClient, session_id: str, actions: list[dict[str, Any]]) -> dict[str, Any]:
    if not actions or len(actions) > 24:
        raise RuntimeError("Expected 1 to 24 actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ("click", "fill", "type", "upload", "pay_token"):
            raise RuntimeError("Invalid browser action")
        if step["kind"] == "pay_token":
            if (step.get("ref") is not None or not isinstance(step.get("text"), str) or not step["text"]
                    or not isinstance(step.get("origin"), str)
                    or not isinstance(step.get("merchantAccountId"), str)):
                raise RuntimeError("A pay token needs its text, origin and merchant account, and no ref")
            continue
        if step.get("ref") is None and step.get("kind") == "fill" and step.get("field") == "card":
            if step.get("cardField") not in CARD_AUTOCOMPLETE:
                raise RuntimeError("A card fill without a ref needs its card field")
        elif not isinstance(step.get("ref"), str) or not step["ref"]:
            raise RuntimeError("Element ref is required")
        if step["kind"] == "upload":
            # Check every file before acting, so a bad path cannot leave a half-done form.
            step["files"] = resolve_upload_paths(step.get("paths"), roots=step.get("roots"))
        elif step["kind"] != "click" and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        if step.get("origin") is not None and (
            step["kind"] != "fill" or not isinstance(step["origin"], str)
        ):
            raise RuntimeError("An origin applies only to fill")
        # A card detail is hidden and checked only on an origin-bound fill.
        if step.get("field") == "card" and not step.get("origin"):
            raise RuntimeError("A card fill needs its origin")
    ensure_helpers(client, session_id)
    # Requests are told apart from the page's own background ones by when they begin, so listen from now.
    # Bodies are not wanted, and 0 would mean no limit: one byte keeps each event small.
    try:
        client.call("Network.enable", {"maxPostDataSize": 1}, session_id=session_id)
        client.drop_oversized = True
    except Exception:  # noqa: BLE001
        pass
    # A click that makes the page open a file chooser would show a native dialog on the screen. Hold
    # it back instead: files go in with upload.
    try:
        client.call("Page.setInterceptFileChooserDialog", {"enabled": True}, session_id=session_id)
    except Exception:  # noqa: BLE001
        pass
    navigations = client.navigation_count(session_id)
    # Frames a step acted in, whose own requests the result waits for too.
    touched: dict[str, PageFrame] = {}
    # The page's frames, found on the first frame step and reused by the next ones.
    known_frames: list[PageFrame] = []
    completed = 0
    uncertain = False
    # Refs belong to the document that was typed into; a page that moved on keeps none of them.
    page_changed = False
    try:
        for step in actions:
            kind, ref = step["kind"], step.get("ref")
            if page_changed:
                # The result shows the page the code led to, so the bot can carry on from there.
                try:
                    snap = snapshot(client, session_id)
                except Exception:  # noqa: BLE001
                    snap = {"uncertain": True}
                return {"uncertain": False, **snap, "ok": False, "completed": completed,
                        "error": "Stale element ref. Take a fresh snapshot."}
            if is_frame_ref(ref):
                uncertain = True
                try:
                    page_changed = frame_step(client, session_id, step, touched, known_frames)
                except TypingStopped as stopped:
                    try:
                        snap = snapshot(client, session_id)
                    except Exception:  # noqa: BLE001
                        snap = {"uncertain": True}
                    return {"uncertain": False, **snap, "ok": False, "completed": completed, "error": str(stopped)}
                except KeysNotKept:
                    return {"uncertain": False, **snapshot(client, session_id), "ok": False,
                            "completed": completed + 1, "error": NOT_KEPT}
                completed += 1
                uncertain = False
                continue
            if kind == "pay_token":
                uncertain = True
                fill_pay_token(client, session_id, step)
                completed += 1
                uncertain = False
                continue
            if ref is None:
                uncertain = True
                fill_card(client, session_id, step)
                completed += 1
                uncertain = False
                continue
            # Preflight catches stale, hidden and disabled elements before a mutation is dispatched.
            eval_json(client, session_id, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))")
            if kind == "upload":
                uncertain = True
                upload(client, session_id, ref, step["files"])
                completed += 1
                uncertain = False
                continue
            if kind == "type":
                uncertain = True
                mark = page_mark(client, session_id)
                # One character goes into the ref'd box alone; longer text replaces the whole code.
                whole = json.dumps(len(step["text"]) > 1)
                focus = eval_json(client, session_id,
                                  f"window.__rakazoPageBrowser.focusForKeys({json.dumps(ref)}, {whole})")
                if isinstance(focus, dict) and focus.get("select"):
                    kind = "fill"
                else:
                    if not isinstance(focus, dict) or not focus.get("focused"):
                        raise RuntimeError("The field did not take keyboard focus. Click it, then type again.")
                    try:
                        page_changed = type_keys(client, session_id, step["text"],
                                                 multiline=bool(focus.get("multiline")), mark=mark)
                    except TypingStopped as stopped:
                        try:
                            snap = snapshot(client, session_id)
                        except Exception:  # noqa: BLE001
                            snap = {"uncertain": True}
                        return {"uncertain": False, **snap, "ok": False, "completed": completed,
                                "error": str(stopped)}
                    completed += 1
                    uncertain = False
                    if not page_changed and not typed_in_full(client, session_id, ref, step["text"]):
                        return {"uncertain": False, **snapshot(client, session_id), "ok": False, "completed": completed,
                                "error": NOT_KEPT}
                    continue
            if kind == "click":
                uncertain = True
                aim = eval_json(client, session_id, f"window.__rakazoPageBrowser.aim({json.dumps(ref)})")
                if isinstance(aim, dict) and aim.get("x") is not None:
                    note_download_link(client, session_id, ref)
                    click_at(client, session_id, ref, aim["x"], aim["y"])
                completed += 1
                uncertain = False
                continue
            arguments = json.dumps(ref) + ", " + json.dumps(step["text"])
            if step.get("origin"):
                arguments += ", " + json.dumps(step["origin"]) + ", " + json.dumps(step.get("field"))
            uncertain = True
            data = eval_json(client, session_id, f"window.__rakazoPageBrowser.fill({arguments})")
            if not isinstance(data, dict):
                raise RuntimeError("Action response unavailable")
            if data.get("insertText"):
                client.call("Input.insertText", {"text": step["text"]}, session_id=session_id)
            completed += 1
            uncertain = False
        ended = time.monotonic()
        budget = SETTLE_SECONDS if client.navigation_count(session_id) != navigations else ACTION_WAIT_SECONDS
        busy = not wait_for_action(client, session_id, ended, budget)
        busy = not wait_for_frames(client, touched, ended, budget) or busy
        if client.file_choosers:
            raise Settled(FILE_CHOOSER)
        # The snapshot takes what is left of the budget, and none when a request is known to be open.
        snap = snapshot(client, session_id, 0.0 if busy else max(0.0, ended + budget - time.monotonic()))
        return {**snap, "completed": completed, **({"loading": True} if busy else {})}
    except Settled as exc:
        # Nothing changed for this step. The page as it is now goes with the reason.
        try:
            snap = snapshot(client, session_id)
        except Exception:  # noqa: BLE001
            snap = {}
        return {"uncertain": False, **snap, "ok": False, "completed": completed, "error": str(exc)}
    except Refused as exc:
        # Settled, and fixable in the page browser: no desktop fallback.
        return {"ok": False, "completed": completed, "uncertain": False, "error": str(exc)}
    except CardFieldUncertain as exc:
        return {"ok": False, "completed": completed, "uncertain": True, "error": str(exc)}
    except Exception as exc:
        return {"ok": False, "completed": completed, "uncertain": uncertain,
                "error": str(exc), "fallback": "computer_act"}


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def run(argv: list[str]) -> int:
    stdin_args = (
        read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    )
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "usage: rakazo-page-browser <command> [json-args]",
                    "fallback": "computer_act",
                }
            )
        )
        return 2
    command = argv[1]
    args: dict[str, Any] = {}
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    if raw_args.strip():
        args = json.loads(raw_args)
    if command == "finish":
        finish_later(args.get("downloads") or [])
        return 0
    port = cdp_port()
    # Set once the browser answers: before that, no action can have reached the page.
    connected = False
    downloads: Downloads | None = None
    saved: list[dict[str, Any]] = []
    try:
        wait_for_cdp(port)
        ws_url = discover_ws_url(port)
        client = CdpClient(ws_url)
        client.connect()
        connected = True
        try:
            session_id = attach_page(client)
            if command in ("navigate", "act") and args.get("downloads") is not None:
                downloads = Downloads(client, args["downloads"], session_id)
            if command == "navigate":
                result = navigate(client, session_id, str(args.get("url") or ""), saving=downloads is not None)
            elif command == "snapshot":
                result = snapshot(client, session_id)
            elif command == "act":
                actions = args.get("actions")
                if not isinstance(actions, list):
                    raise RuntimeError("actions must be an array")
                result = act(client, session_id, actions)
            else:
                result = {
                    "ok": False,
                    "error": f"unknown command: {command}",
                    "fallback": "computer_act",
                }
                print(json.dumps(result))
                return 2
        finally:
            # A file the call downloaded is saved and listed even when the call itself failed.
            if downloads is not None:
                try:
                    saved = downloads.finish()
                except Exception:  # noqa: BLE001
                    saved = [{"error": DOWNLOAD_FAILED}]
            client.close()
        print(json.dumps({**result, **({"downloads": saved} if saved else {})}))
        return 0  # Structured failures preserve partial action progress.
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"ok": False, "error": str(exc), "fallback": "computer_act",
                          "uncertain": command == "act" and connected, **({"downloads": saved} if saved else {})}))
        return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv))
