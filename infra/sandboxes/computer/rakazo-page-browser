#!/usr/bin/env python3
"""Drive the live Chromium on this computer over CDP (stdlib only).

Attaches to the Chrome already showing on DISPLAY. Used by the host
BrowserProvider. Not a vendor SDK. On failure prints JSON with
fallback computer_act.
"""

from __future__ import annotations

import base64
import hashlib
import json
import os
import socket
import stat
import struct
import sys
import time
import threading
import urllib.request
from urllib.parse import urlsplit
from typing import Any


def display_num() -> int:
    raw = os.environ.get("DISPLAY", ":1")
    try:
        return int(str(raw).lstrip(":").split(".")[0] or "1")
    except ValueError:
        return 1


def cdp_port() -> int:
    override = os.environ.get("RAKAZO_CDP_PORT")
    if override:
        return int(override)
    # rakazo-browser uses 9221 + display number (:1 -> 9222).
    return 9221 + display_num()


def http_get_json(url: str, timeout: float = 5.0) -> Any:
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        data = resp.read(1024 * 1024 + 1)
        if len(data) > 1024 * 1024:
            raise RuntimeError("CDP discovery response too large")
        return json.loads(data.decode("utf-8"))


def wait_for_cdp(port: int, timeout_s: float = 3.0) -> None:
    deadline = time.time() + timeout_s
    last_error = "unreachable"
    while time.time() < deadline:
        try:
            http_get_json(f"http://127.0.0.1:{port}/json/version", timeout=1.0)
            return
        except Exception as exc:  # noqa: BLE001
            last_error = str(exc)
            time.sleep(0.25)
    raise RuntimeError(f"CDP not ready on port {port}: {last_error}")


def discover_ws_url(port: int) -> str:
    version = http_get_json(f"http://127.0.0.1:{port}/json/version")
    ws = version.get("webSocketDebuggerUrl")
    if not isinstance(ws, str) or not ws:
        raise RuntimeError("CDP version endpoint missing webSocketDebuggerUrl")
    parsed = urlsplit(ws)
    if parsed.scheme != "ws" or parsed.hostname != "127.0.0.1" or parsed.port != port:
        raise RuntimeError("Unexpected CDP endpoint")
    return ws


WORLD_NAME = "rakazo-page-browser"


# A frame asked for, began or committed a load of another document. Same-document changes, such as
# a new URL fragment, leave the page and its fields in place and are not counted.
NAVIGATION_EVENTS = ("Page.frameRequestedNavigation", "Page.frameStartedNavigating", "Page.frameNavigated")


class CdpClient:
    def __init__(self, ws_url: str) -> None:
        self._ws_url = ws_url
        self._sock: socket.socket | None = None
        self._buf = bytearray()
        self._next_id = 1
        self.context_id: int | None = None
        self._pending: dict[int, dict[str, Any] | None] = {}
        # Worlds live in Chromium until navigation; rediscover them per CLI process.
        self._contexts: dict[int, dict[str, Any]] = {}
        # Lifecycle events reached by each frame's current document, per CDP session.
        self._lifecycle: dict[tuple[Any, str], tuple[Any, set[str]]] = {}
        # Navigations to another document started or committed in each frame, per CDP session.
        self._navigations: dict[tuple[Any, str], int] = {}

    def connect(self) -> None:
        assert self._ws_url.startswith("ws://"), self._ws_url
        rest = self._ws_url[len("ws://") :]
        host_port, _, path = rest.partition("/")
        if ":" in host_port:
            host, port_s = host_port.split(":", 1)
            port = int(port_s)
        else:
            host, port = host_port, 80
        path = "/" + path
        sock = socket.create_connection((host, port), timeout=10)
        key = base64.b64encode(os.urandom(16)).decode("ascii")
        req = (
            f"GET {path} HTTP/1.1\r\n"
            f"Host: {host_port}\r\n"
            "Upgrade: websocket\r\n"
            "Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            "Sec-WebSocket-Version: 13\r\n"
            "\r\n"
        )
        sock.sendall(req.encode("ascii"))
        data = b""
        while b"\r\n\r\n" not in data:
            chunk = sock.recv(4096)
            if not chunk:
                raise RuntimeError("CDP websocket handshake closed")
            data += chunk
            if len(data) > 16_384:
                raise RuntimeError("CDP handshake too large")
        header, _, leftover = data.partition(b"\r\n\r\n")
        if b"101" not in header.split(b"\r\n", 1)[0]:
            raise RuntimeError(f"CDP websocket upgrade failed: {header[:200]!r}")
        expected = base64.b64encode(
            hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")).digest()
        )
        if expected not in header:
            raise RuntimeError("CDP websocket accept mismatch")
        self._sock = sock
        self._buf.extend(leftover)

    def close(self) -> None:
        if self._sock is not None:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None

    def _send_frame(self, payload: bytes) -> None:
        assert self._sock is not None
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        header = bytearray([0x81])
        n = len(payload)
        if n < 126:
            header.append(0x80 | n)
        elif n < 65536:
            header.append(0x80 | 126)
            header.extend(struct.pack("!H", n))
        else:
            header.append(0x80 | 127)
            header.extend(struct.pack("!Q", n))
        header.extend(mask)
        self._sock.sendall(header + masked)

    def _send_control(self, opcode: int, payload: bytes) -> None:
        assert self._sock is not None
        mask = os.urandom(4)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        header = bytearray([0x80 | opcode, 0x80 | len(payload)])
        header.extend(mask)
        self._sock.sendall(header + masked)

    def _read_more(self) -> None:
        assert self._sock is not None
        chunk = self._sock.recv(65536)
        if not chunk:
            raise RuntimeError("CDP websocket closed")
        self._buf.extend(chunk)

    def _read_frame(self) -> bytes:
        assert self._sock is not None
        while True:
            while len(self._buf) < 2:
                chunk = self._sock.recv(65536)
                if not chunk:
                    raise RuntimeError("CDP websocket closed")
                self._buf.extend(chunk)
            b1, b2 = self._buf[0], self._buf[1]
            opcode = b1 & 0x0F
            masked = bool(b2 & 0x80)
            length = b2 & 0x7F
            offset = 2
            if length == 126:
                while len(self._buf) < 4:
                    self._read_more()
                length = struct.unpack("!H", self._buf[2:4])[0]
                offset = 4
            elif length == 127:
                while len(self._buf) < 10:
                    self._read_more()
                length = struct.unpack("!Q", self._buf[2:10])[0]
                offset = 10
            if length > 2 * 1024 * 1024:
                raise RuntimeError("CDP frame too large")
            if not (b1 & 0x80):
                raise RuntimeError("Fragmented CDP message unsupported")
            mask = b""
            if masked:
                while len(self._buf) < offset + 4:
                    self._read_more()
                mask = bytes(self._buf[offset : offset + 4])
                offset += 4
            while len(self._buf) < offset + length:
                chunk = self._sock.recv(65536)
                if not chunk:
                    raise RuntimeError("CDP websocket closed while reading frame")
                self._buf.extend(chunk)
            payload = bytes(self._buf[offset : offset + length])
            del self._buf[: offset + length]
            if masked:
                payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
            if opcode == 0x8:
                raise RuntimeError("CDP websocket closed by peer")
            if opcode == 0x9:
                self._send_control(0xA, payload)
                continue
            if opcode in (0x1, 0x2, 0x0):
                return payload

    def _handle_event(self, message: dict[str, Any]) -> None:
        method = message.get("method")
        params = message.get("params") or {}
        session_id = message.get("sessionId")
        if method == "Runtime.executionContextCreated":
            context = params.get("context")
            if not isinstance(context, dict):
                return
            context_id = context.get("id")
            if not isinstance(context_id, int):
                return
            recorded = dict(context)
            recorded["_sessionId"] = session_id
            self._contexts[context_id] = recorded
        elif method == "Runtime.executionContextDestroyed":
            context_id = params.get("executionContextId")
            if isinstance(context_id, int):
                self._contexts.pop(context_id, None)
        elif method == "Page.lifecycleEvent":
            frame_id, name = params.get("frameId"), params.get("name")
            if not isinstance(frame_id, str) or not isinstance(name, str):
                return
            loader_id, reached = self._lifecycle.get((session_id, frame_id), (None, set()))
            if name == "init" or params.get("loaderId") != loader_id:
                loader_id, reached = params.get("loaderId"), set()
            reached.add(name)
            self._lifecycle[(session_id, frame_id)] = (loader_id, reached)
        elif method in NAVIGATION_EVENTS:
            frame_id = params.get("frameId") or (params.get("frame") or {}).get("id")
            if not isinstance(frame_id, str) or params.get("disposition", "currentTab") != "currentTab":
                return
            if params.get("navigationType") in ("sameDocument", "historySameDocument"):
                return
            self._navigations[(session_id, frame_id)] = self._navigations.get((session_id, frame_id), 0) + 1
        elif method == "Runtime.executionContextsCleared":
            if session_id is None:
                self._contexts.clear()
            else:
                self._contexts = {
                    cid: ctx
                    for cid, ctx in self._contexts.items()
                    if ctx.get("_sessionId") != session_id
                }

    def lifecycle(self, session_id: str, frame_id: str) -> set[str]:
        return self._lifecycle.get((session_id, frame_id), (None, set()))[1]

    def navigations(self, session_id: str, frame_id: str) -> int:
        return self._navigations.get((session_id, frame_id), 0)

    def find_world_context(self, world_name: str, frame_id: str, session_id: str) -> int | None:
        for context_id, context in self._contexts.items():
            if context.get("name") != world_name:
                continue
            if context.get("_sessionId") != session_id:
                continue
            aux = context.get("auxData") or {}
            if not isinstance(aux, dict) or aux.get("frameId") != frame_id or aux.get("isDefault") is not False:
                continue
            return context_id
        return None

    def call(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        *,
        session_id: str | None = None,
        timeout_s: float = 30.0,
    ) -> dict[str, Any]:
        assert self._sock is not None
        msg_id = self._next_id
        self._next_id += 1
        payload: dict[str, Any] = {"id": msg_id, "method": method, "params": params or {}}
        if session_id:
            payload["sessionId"] = session_id
        self._pending[msg_id] = None
        self._send_frame(json.dumps(payload).encode("utf-8"))
        deadline = time.time() + timeout_s
        while time.time() < deadline:
            pending = self._pending.get(msg_id)
            if pending is not None:
                self._pending.pop(msg_id, None)
                if "error" in pending:
                    raise RuntimeError(f"{method} failed: {pending['error']}")
                result = pending.get("result")
                return result if isinstance(result, dict) else {}
            self._sock.settimeout(max(0.1, deadline - time.time()))
            try:
                frame = self._read_frame()
            except socket.timeout:
                continue
            message = json.loads(frame.decode("utf-8"))
            if not isinstance(message, dict):
                continue
            if message.get("id") in self._pending:
                self._pending[int(message["id"])] = message
                continue
            if message.get("method"):
                self._handle_event(message)
        raise TimeoutError(f"CDP call timed out: {method}")


def attach_page(client: CdpClient) -> str:
    targets = client.call("Target.getTargets").get("targetInfos") or []
    pages = [t for t in targets if isinstance(t, dict) and t.get("type") == "page"]
    candidates = []
    for page in pages[:32]:
        attached = client.call("Target.attachToTarget", {
            "targetId": page["targetId"], "flatten": True,
        })
        session_id = attached["sessionId"]
        try:
            client.call("Page.enable", session_id=session_id)
            ensure_world(client, session_id)
            if eval_json(client, session_id, 'document.visibilityState === "visible"'):
                focused = eval_json(client, session_id, "document.hasFocus()")
                candidates.append((session_id, focused))
        except Exception:
            continue
    focused = [session for session, focus in candidates if focus]
    if len(focused) == 1:
        selected = focused[0]
    elif len(candidates) == 1:
        selected = candidates[0][0]
    else:
        raise RuntimeError("No unambiguous visible browser tab. Use desktop tools to select a tab.")
    ensure_world(client, selected)
    return selected


def ensure_world(client: CdpClient, session_id: str) -> None:
    # Rediscover only an isolated context bound to this frame and CDP session.
    # Never run helpers in a page-owned default context with the same name.
    frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
    frame_id = frame["id"]
    client.call("Runtime.enable", session_id=session_id)
    existing = client.find_world_context(WORLD_NAME, frame_id, session_id)
    if existing is not None:
        client.context_id = existing
        return
    world = client.call("Page.createIsolatedWorld", {
        "frameId": frame_id, "worldName": WORLD_NAME,
    }, session_id=session_id)
    client.context_id = world["executionContextId"]


EVAL_HELPERS = r"""
(() => {
  if (window.__rakazoPageBrowser) return true;
  const refMap = new Map();
  // Fields holding a saved login: snapshots never report their values, whatever their type.
  const loginFilled = new WeakSet();
  // New snapshots/documents never recycle references. Retain exact nodes, not selectors.
  function newRef() {
    return `e${Array.from(crypto.getRandomValues(new Uint32Array(4)), n => n.toString(16).padStart(8, "0")).join("")}`;
  }
  // Code fields often keep their real input transparent under drawn boxes; it is still the target.
  function isCodeInput(el) {
    if (!(el instanceof HTMLInputElement) || el.autocomplete !== "one-time-code") return false;
    const style = window.getComputedStyle(el);
    const rect = el.getBoundingClientRect();
    return style.display !== "none" && style.visibility !== "hidden" && rect.width > 0 && rect.height > 0;
  }
  // Visible fields in page order, on the page or inside root.
  function pageFields(root = document) {
    return [...root.querySelectorAll("input, textarea, select, [contenteditable]")]
      .filter((field) => field.type !== "hidden" && visible(field));
  }
  // Boxes are usually named alike apart from their number: "Digit 1", "Digit 2", or not at all.
  const naming = (field) => [field.getAttribute("aria-label"), field.name, field.id,
    ...Array.from(field.labels || [], (label) => label.textContent)]
    .join("|").replace(/[\d\s]+/g, "").toLowerCase();
  // One box per character: every box of the one code el belongs to, in page order (split groups too).
  // A box is a one-character input, or a narrow one in a row of at least four, of el's size, type and
  // form on el's row (named one-character boxes may wrap). The unbroken run stays in its container
  // once it holds a complete code, so clearing it leaves adjacent widgets alone. A field at either
  // end of the run that is named unlike the rest, such as a middle initial before the code, is not a box.
  function codeBoxes(el) {
    if (!(el instanceof HTMLInputElement)) return [el];
    const own = el.getBoundingClientRect();
    const near = (a, b) => Math.abs(a - b) <= Math.max(2, b * 0.15);
    const isBox = (input) => {
      if (!(input instanceof HTMLInputElement) || input.type !== el.type || input.form !== el.form) return false;
      const rect = input.getBoundingClientRect();
      // Named one-character boxes can wrap onto another line in a narrow viewport.
      if (!(input.maxLength === 1 && naming(input) === naming(el))
          && Math.abs(rect.top + rect.height / 2 - (own.top + own.height / 2)) >= own.height / 2) return false;
      if (!near(rect.width, own.width) || !near(rect.height, own.height)) return false;
      return input.maxLength === 1 || (input.maxLength <= 2 && rect.width <= rect.height * 2);
    };
    const whole = (boxes) => boxes.every((box) => box.maxLength === 1) || boxes.length >= 4;
    let boxes = [el];
    if (!isBox(el)) return boxes;
    for (let parent = el.parentElement; parent && parent !== document.body; parent = parent.parentElement) {
      const fields = pageFields(parent);
      let from = fields.indexOf(el);
      let to = from;
      if (from < 0) break;
      while (from > 0 && isBox(fields[from - 1])) from--;
      while (to < fields.length - 1 && isBox(fields[to + 1])) to++;
      if (to - from >= 12) break;
      boxes = fields.slice(from, to + 1);
      // A six-box or longer code stays in its container; smaller subgroups can grow.
      if (boxes.length < fields.length || boxes.length >= 6) break;
    }
    const names = boxes.map(naming);
    const usual = names.reduce((best, name) =>
      names.filter((n) => n === name).length > names.filter((n) => n === best).length ? name : best, names[0]);
    if (names.filter((name) => name === usual).length >= 2) {
      if (naming(el) !== usual) return [el];
      while (names[0] !== usual) names.shift(), boxes.shift();
      while (names[names.length - 1] !== usual) names.pop(), boxes.pop();
    }
    return whole(boxes) ? boxes : [el];
  }
  // The field typed into; the field, one box or every box of its code that the keys are meant for;
  // where the first of them is among the page's fields; and how many boxes the code has.
  let keyTarget = { el: null, boxes: [], at: -1, size: 0, container: null, names: [] };
  // Some widgets replace every box with a new one on each input. The boxes are then found again at
  // the same place among the page's fields, in the original container with the same naming.
  function targetBoxes() {
    const { boxes, at, size, container, names } = keyTarget;
    if (size < 2 || boxes.every((box) => box.isConnected)) return boxes;
    const first = pageFields()[at];
    const code = first instanceof HTMLInputElement ? codeBoxes(first) : [];
    if (!container?.isConnected || code.some((box, i) => !container.contains(box) || naming(box) !== names[i])) return boxes;
    if (code.length !== size || (boxes.length > 1 && code[0] !== first) || !code.includes(first)) return boxes;
    keyTarget = { ...keyTarget, boxes: boxes.length > 1 ? code : [first] };
    return keyTarget.boxes;
  }
  const TEXT_INPUT_TYPES = ["text", "search", "email", "url", "tel", "password", "number"];
  // Sites usually hide the real file input behind a styled button; it is still the upload target.
  function isFileInput(el) {
    return el instanceof HTMLInputElement && el.type === "file";
  }
  function visible(el) {
    if (!(el instanceof Element)) return false;
    const style = window.getComputedStyle(el);
    if (style.display === "none" || style.visibility === "hidden" || style.opacity === "0") {
      return false;
    }
    const rect = el.getBoundingClientRect();
    return rect.width > 0 && rect.height > 0;
  }
  function roleOf(el) {
    if (isFileInput(el)) return "file upload";
    const explicit = el.getAttribute("role");
    if (explicit) return explicit;
    const tag = el.tagName.toLowerCase();
    if (tag === "a") return "link";
    if (tag === "button") return "button";
    if (tag === "input") {
      const type = (el.getAttribute("type") || "text").toLowerCase();
      if (type === "submit" || type === "button") return "button";
      if (type === "checkbox") return "checkbox";
      if (type === "radio") return "radio";
      return "textbox";
    }
    if (tag === "textarea" || el.isContentEditable) return "textbox";
    if (tag === "select") return "combobox";
    if (/^h[1-6]$/.test(tag)) return "heading";
    return tag;
  }
  function nameOf(el) {
    return (
      el.getAttribute("aria-label") ||
      Array.from(el.labels || []).map(label => label.textContent).join(" ").trim() ||
      el.getAttribute("placeholder") ||
      el.getAttribute("name") ||
      el.getAttribute("title") ||
      (isCodeInput(el) ? "One-time code" : "") ||
      (el.innerText || el.textContent || "").trim().slice(0, 80) ||
      ""
    );
  }
  function isInteractive(el) {
    if (!(el instanceof Element)) return false;
    const tag = el.tagName.toLowerCase();
    if (["a", "button", "input", "textarea", "select", "summary"].includes(tag)) return true;
    if (el.isContentEditable) return true;
    const role = el.getAttribute("role");
    if (
      role &&
      ["button", "link", "textbox", "checkbox", "radio", "menuitem", "tab", "option", "switch"].includes(
        role
      )
    ) {
      return true;
    }
    return typeof el.onclick === "function" || el.hasAttribute("tabindex");
  }
  // File inputs in open shadow roots (web-component uploaders) are invisible to querySelectorAll.
  function allFileInputs() {
    const found = [];
    const walk = (root) => {
      for (const el of root.querySelectorAll("*")) {
        if (isFileInput(el)) found.push(el);
        if (el.shadowRoot) walk(el.shadowRoot);
      }
    };
    walk(document);
    return found;
  }
  function formatTree(elements) {
    if (!elements.length) return "(no interactive elements)";
    return elements
      .map((el) => {
        const value =
          el.value !== undefined && el.value !== "" ? ` value=${JSON.stringify(el.value)}` : "";
        return `- ${el.role} "${el.name}" [${el.ref}]${value}`;
      })
      .join("\n");
  }
  window.__rakazoPageBrowser = {
    snapshot() {
      refMap.clear();
      const elements = [];
      const listed = new Set();
      const describe = (el) => {
        const ref = newRef();
        refMap.set(ref, el);
        listed.add(el);
        elements.push({
          ref,
          role: roleOf(el),
          name: String(nameOf(el)).slice(0, 200),
          value: el.type === "password" || loginFilled.has(el) ? undefined
            : isFileInput(el) ? Array.from(el.files || [], (file) => file.name).join(", ")
            : ["checkbox", "radio"].includes(el.type) ? (el.checked ? "checked" : "unchecked")
            : "value" in el ? String(el.value ?? "").slice(0, 2000) : undefined,
          tag: el.tagName.toLowerCase(),
        });
      };
      // Upload targets do not count toward the 80-control cap, so hidden inputs cannot crowd out buttons.
      let controls = 0;
      for (const el of document.querySelectorAll("body *")) {
        if (!isInteractive(el) || !(visible(el) || isFileInput(el) || isCodeInput(el))) continue;
        describe(el);
        if (!isFileInput(el) && ++controls >= 80) break;
      }
      // Upload targets are listed even past the element cap or inside shadow DOM.
      for (const el of allFileInputs()) {
        if (!listed.has(el)) describe(el);
      }
      return {
        url: location.href,
        title: (document.title || "").slice(0, 200),
        elements,
        tree: (document.body?.innerText || "").slice(0, 12000) + "\n" + formatTree(elements)
          + (document.querySelector("iframe,frame") ? "\nEmbedded frames require desktop tools." : ""),
      };
    },
    resolve(ref) {
      const el = refMap.get(String(ref));
      if (!el || !el.isConnected || !(visible(el) || isFileInput(el) || isCodeInput(el))) return null;
      if (el.matches(":disabled") || el.getAttribute("aria-disabled") === "true") {
        throw new Error("Element is disabled");
      }
      return el;
    },
    click(ref) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      el.focus();
      el.click();
      return { url: location.href, title: (document.title || "").slice(0, 200) };
    },
    fill(ref, value, origin) {
      // Checked in the same evaluation as the fill, so a navigation cannot slip in between.
      // Private-LAN plain HTTP is not a login target, even when the page origin matches.
      if (origin) {
        let saved = null;
        try { saved = new URL(origin); } catch { /* rejected below */ }
        if (!saved || saved.protocol !== "https:" || location.protocol !== "https:") {
          throw new Error("Website logins can only be filled on HTTPS.");
        }
        if (location.origin !== saved.origin) {
          throw new Error("The page is not on the site this login was saved for.");
        }
      }
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      if (el.readOnly) throw new Error("Element is read-only");
      // A username is an input. Textareas, search boxes, and editable page content stay out.
      if (origin && !(el instanceof HTMLInputElement && ["text", "email", "password", "tel"].includes(el.type))) {
        throw new Error("A saved login can only be typed into a text, email, password, or telephone field.");
      }
      el.focus();
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
        if (el instanceof HTMLInputElement && !TEXT_INPUT_TYPES.includes(el.type)) {
          throw new Error("Input type requires desktop tools");
        }
        const prototype = el instanceof HTMLInputElement ? HTMLInputElement.prototype
          : el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLSelectElement.prototype;
        Object.getOwnPropertyDescriptor(prototype, "value").set.call(el, String(value));
        if (el.value !== String(value)) throw new Error("Input did not accept the requested value");
        el.dispatchEvent(new Event("input", { bubbles: true }));
        el.dispatchEvent(new Event("change", { bubbles: true }));
        if (origin) loginFilled.add(el);
        else loginFilled.delete(el);
      } else if (el.isContentEditable) {
        el.textContent = String(value);
        el.dispatchEvent(new Event("input", { bubbles: true }));
      } else {
        throw new Error(`Element is not fillable: ${ref}`);
      }
      return { url: location.href, title: (document.title || "").slice(0, 200) };
    },
    fileInput(ref, count) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      if (!isFileInput(el)) throw new Error("upload needs a file upload element from browser_snapshot");
      if (count > 1 && !el.multiple) throw new Error("This file upload accepts one file");
      return el;
    },
    // Empties the field and focuses where typing starts. Real key presses then follow the focus of the
    // page, so a widget that moves between boxes gets each one. For a split code, a whole code empties
    // every box and starts at the first; one character replaces only the box it is typed into, so a
    // code can also be entered box by box.
    focusForKeys(ref, whole = true) {
      const el = this.resolve(ref);
      if (!el) throw new Error(`Unknown element ref: ${ref}`);
      if (el.readOnly) throw new Error("Element is read-only");
      if (el instanceof HTMLSelectElement) return { select: true };
      if (el instanceof HTMLInputElement && !TEXT_INPUT_TYPES.includes(el.type)) {
        throw new Error("Input type requires desktop tools");
      }
      if (!(el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el.isContentEditable)) {
        throw new Error(`Element is not fillable: ${ref}`);
      }
      const code = codeBoxes(el);
      const boxes = whole ? code : [el];
      let container = code[0].parentElement;
      while (container && !code.every((box) => container.contains(box))) container = container.parentElement;
      keyTarget = { el, boxes, at: pageFields().indexOf(boxes[0]), size: code.length,
        container, names: code.map(naming) };
      // Only boxes that hold something are emptied, so an empty widget sees no events at all.
      for (let i = 0; i < boxes.length; i++) {
        const box = targetBoxes()[i];
        loginFilled.delete(box);
        if (!(box.isContentEditable ? box.textContent : box.value)) continue;
        if (box.isContentEditable) box.textContent = "";
        else Object.getOwnPropertyDescriptor(Object.getPrototypeOf(box), "value").set.call(box, "");
        box.dispatchEvent(new Event("input", { bubbles: true }));
      }
      targetBoxes()[0].focus();
      return {
        focused: this.focusHolds(),
        multiline: !(el instanceof HTMLInputElement),
      };
    },
    // Whether the next key still lands in the field, or in a box of its code when the widget moved
    // on by itself. Focus anywhere else, or a box the page removed, ends the typing.
    focusHolds() {
      const active = document.activeElement;
      return Boolean(active) && targetBoxes().some((box) => box.isConnected
        && (box.contains(active) || (active.isContentEditable && active.contains(box))));
    },
    // Whether what the step was meant to change (the field, one box, or every box of a split code)
    // now holds the typed letters and digits. Widgets may add spaces or dashes, or change case.
    typed(ref, text) {
      const el = refMap.get(String(ref));
      const boxes = el === keyTarget.el ? targetBoxes() : el?.isConnected ? codeBoxes(el) : [];
      if (!boxes.length || !boxes.every((box) => box.isConnected)) return true;
      const letters = (value) => String(value).replace(/[^\p{L}\p{N}]/gu, "").toLowerCase();
      const shown = boxes.map((box) => (box.isContentEditable ? box.innerText : box.value)).join("");
      return letters(shown) === letters(text);
    },
  };
  return true;
})()
"""


def eval_json(client: CdpClient, session_id: str, expression: str) -> Any:
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": expression,
            "contextId": client.context_id,
            "returnByValue": True,
            "awaitPromise": True,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        text = (
            details.get("text")
            or (details.get("exception") or {}).get("description")
            or "evaluate failed"
        )
        raise RuntimeError(str(text))
    return (result.get("result") or {}).get("value")


def ensure_helpers(client: CdpClient, session_id: str) -> None:
    ensure_world(client, session_id)
    eval_json(client, session_id, EVAL_HELPERS)


def navigate(client: CdpClient, session_id: str, url: str) -> dict[str, Any]:
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or parsed.username or parsed.password:
        raise RuntimeError("Only HTTP(S) URLs without embedded credentials are supported")
    result = client.call("Page.navigate", {"url": url}, session_id=session_id, timeout_s=15.0)
    if result.get("errorText") or result.get("isDownload"):
        raise RuntimeError(result.get("errorText") or "Navigation started a download")
    deadline = time.monotonic() + 10.0
    while time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
            if result.get("loaderId") and frame.get("loaderId") != result["loaderId"]:
                time.sleep(0.1)
                continue
            ensure_world(client, session_id)
            ready = eval_json(client, session_id, "document.readyState")
            if ready in ("interactive", "complete"):
                return {"ok": True, "url": eval_json(client, session_id, "location.href"),
                        "title": eval_json(client, session_id, "(document.title || '').slice(0, 200)")}
        except Exception:
            pass
        time.sleep(0.1)
    raise RuntimeError("Navigation did not settle; inspect the screen before continuing")


MAX_UPLOAD_FILES = 10
MAX_UPLOAD_BYTES = 100 * 1024 * 1024


def resolve_upload_paths(
    paths: Any, home: str | None = None, roots: list[str] | None = None,
) -> list[str]:
    """Resolve regular files within trusted roots before handing them to Chromium."""
    if not isinstance(paths, list) or not 1 <= len(paths) <= MAX_UPLOAD_FILES:
        raise RuntimeError(f"upload needs 1 to {MAX_UPLOAD_FILES} file paths")
    home = os.path.realpath(home or os.environ.get("HOME") or "/home/rakazo")
    location = "your folder or shared/" if roots is not None else "this computer's home folder"
    allowed = [home]
    if roots is not None:
        allowed = []
        for root in roots:
            expected = os.path.normpath(os.path.join(home, root))
            full = os.path.realpath(expected)
            # A root redirected by a symlink (bots/b1 -> bots/b2) could reach another bot's files.
            if os.path.isabs(root) or full != expected or os.path.commonpath([home, full]) != home:
                raise RuntimeError(f"Upload files must be inside {location}")
            # A folder that does not exist yet holds no files; the other root still applies.
            if os.path.isdir(full):
                allowed.append(full)
    max_bytes = MAX_UPLOAD_BYTES
    override = os.environ.get("RAKAZO_BROWSER_UPLOAD_MAX_BYTES", "")
    try:
        if int(override) > 0:
            max_bytes = int(override)
    except ValueError:
        pass
    resolved = []
    total = 0
    for path in paths:
        if not isinstance(path, str) or not path.strip():
            raise RuntimeError("upload paths must be non-empty strings")
        full = os.path.realpath(os.path.join(home, path))
        # Check confinement before existence to avoid revealing outside targets.
        if not any(os.path.commonpath([root, full]) == root for root in allowed):
            raise RuntimeError(f"Upload files must be inside {location}: {path}")
        try:
            info = os.stat(full)
        except OSError:
            raise RuntimeError(f"File not found: {path}") from None
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"Not a regular file: {path}")
        total += info.st_size
        if total > max_bytes:
            raise RuntimeError(f"upload files are larger than {max_bytes / (1024 * 1024):g} MB in total")
        resolved.append(full)
    return resolved


def upload(client: CdpClient, session_id: str, ref: str, files: list[str]) -> None:
    # Hand the files to the input directly: no native file chooser is opened.
    result = client.call(
        "Runtime.evaluate",
        {
            "expression": f"window.__rakazoPageBrowser.fileInput({json.dumps(ref)}, {len(files)})",
            "contextId": client.context_id,
            "returnByValue": False,
        },
        session_id=session_id,
    )
    if result.get("exceptionDetails"):
        details = result["exceptionDetails"]
        raise RuntimeError(
            (details.get("exception") or {}).get("description")
            or details.get("text")
            or "upload failed"
        )
    object_id = (result.get("result") or {}).get("objectId")
    if not object_id:
        raise RuntimeError("upload target unavailable")
    try:
        client.call("DOM.setFileInputFiles", {"files": files, "objectId": object_id},
                    session_id=session_id)
    finally:
        client.call("Runtime.releaseObject", {"objectId": object_id}, session_id=session_id)


SETTLE_SECONDS = 3.0


def wait_for_settle(client: CdpClient, session_id: str) -> bool:
    """Wait until the page has loaded and made no requests for 500 ms (Chromium's networkIdle).

    Many sites draw a signed-out shell first and replace it once their own requests return,
    so a page captured earlier can show "Sign in" to an account that is signed in.
    """
    deadline = time.monotonic() + SETTLE_SECONDS

    def remaining() -> float:
        budget = deadline - time.monotonic()
        if budget <= 0:
            raise TimeoutError("Page settle budget exhausted")
        return budget

    try:
        # Enabling lifecycle events replays the ones the current document has already reached.
        client.call("Page.setLifecycleEventsEnabled", {"enabled": True}, session_id=session_id,
                    timeout_s=remaining())
        while True:
            # Each call also handles the lifecycle events that arrived meanwhile.
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=remaining())
            if {"load", "networkIdle"} <= client.lifecycle(session_id, frame["frameTree"]["frame"]["id"]):
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(min(0.1, remaining()))
    except TimeoutError:
        # A browser too slow to answer within the wait is not settled either.
        return False


def key_event(char: str) -> dict[str, Any] | None:
    """CDP keyDown parameters for one printable ASCII character, or None to insert it as text."""
    if char == "\n":
        # Shift+Enter breaks the line; many chat boxes send their message on a plain Enter.
        return {"key": "Enter", "code": "Enter", "text": "\r", "windowsVirtualKeyCode": 13, "modifiers": 8}
    if len(char) != 1 or not " " <= char <= "~":
        return None
    if char.isdigit():
        return {"key": char, "code": f"Digit{char}", "text": char, "windowsVirtualKeyCode": ord(char)}
    if char.isalpha():
        return {"key": char, "code": f"Key{char.upper()}", "text": char,
                "windowsVirtualKeyCode": ord(char.upper())}
    if char == " ":
        return {"key": " ", "code": "Space", "text": " ", "windowsVirtualKeyCode": 32}
    return {"key": char, "text": char}


def press_key(client: CdpClient, session_id: str, event: dict[str, Any]) -> None:
    down = {"type": "keyDown", **event}
    if "text" in event:
        down["unmodifiedText"] = event["text"]
    client.call("Input.dispatchKeyEvent", down, session_id=session_id)
    client.call("Input.dispatchKeyEvent", {"type": "keyUp", **{k: v for k, v in event.items() if k != "text"}},
                session_id=session_id)


class TypingStopped(RuntimeError):
    """Typing ended before the last key. The message never repeats any of the text."""


def focus_holds(client: CdpClient, session_id: str) -> bool | None:
    """Whether keys still reach the field or its code boxes; None once its document is gone."""
    try:
        return eval_json(client, session_id, "window.__rakazoPageBrowser.focusHolds()") is True
    except Exception:  # noqa: BLE001
        return None


def page_mark(client: CdpClient, session_id: str) -> tuple[dict[str, Any], int]:
    """The main frame and its navigation count, taken before a type step touches the page."""
    frame = client.call("Page.getFrameTree", session_id=session_id)["frameTree"]["frame"]
    return frame, client.navigations(session_id, frame["id"])


def type_keys(client: CdpClient, session_id: str, text: str, multiline: bool,
              mark: tuple[dict[str, Any], int]) -> bool:
    """Press each character as a real key into whatever element has focus at that moment.

    Before each key, the page must still be the document of mark, with focus in the field or in a
    box of its code. The check also reads the browser's navigation events, which a page reports
    before the evaluation's answer, so a page that navigates on a key, or while its field was being
    emptied, gets no further keys.
    Returns whether the page moved to another document on the last key, as auto-submitting codes do.
    Either way, the next document has replaced the old one before this returns, when it loads in time.
    """
    frame, navigations = mark
    frame_id = frame["id"]

    def moved_on(holds: bool | None) -> bool:
        if holds is not None and client.navigations(session_id, frame_id) == navigations:
            return False
        wait_for_new_document(client, session_id, frame.get("loaderId"))
        return True

    # Enter in a one-line field would submit its form.
    chars = [char for char in text.replace("\r\n", "\n").replace("\r", "\n") if multiline or char != "\n"]
    for index, char in enumerate(chars):
        holds = focus_holds(client, session_id)
        if moved_on(holds):
            raise TypingStopped(f"The page changed while typing, after {index} of {len(chars)} characters, "
                                "so the rest was not typed. Take a fresh snapshot before continuing.")
        if not holds:
            raise TypingStopped(f"Focus left the field while typing, after {index} of {len(chars)} characters, "
                                "so the rest was not typed. Check the page in this snapshot before trying again.")
        event = key_event(char)
        if event is None:
            client.call("Input.insertText", {"text": char}, session_id=session_id)
        else:
            press_key(client, session_id, event)
    return moved_on(focus_holds(client, session_id))


def wait_for_new_document(client: CdpClient, session_id: str, loader_id: Any) -> None:
    """Give a page that began loading another document the settle budget to replace the old one."""
    deadline = time.monotonic() + SETTLE_SECONDS
    while time.monotonic() < deadline:
        try:
            frame = client.call("Page.getFrameTree", session_id=session_id, timeout_s=SETTLE_SECONDS)
            if frame["frameTree"]["frame"].get("loaderId") != loader_id:
                return
        except Exception:  # noqa: BLE001
            return
        time.sleep(0.05)


def typed_in_full(client: CdpClient, session_id: str, ref: str, text: str) -> bool:
    """A widget may refuse keys. A page that submitted or navigated on the last key counts as done."""
    try:
        return eval_json(client, session_id,
                         f"window.__rakazoPageBrowser.typed({json.dumps(ref)}, {json.dumps(text)})") is not False
    except Exception:  # noqa: BLE001
        return True


def snapshot(client: CdpClient, session_id: str) -> dict[str, Any]:
    settled = wait_for_settle(client, session_id)
    ensure_helpers(client, session_id)
    data = eval_json(client, session_id, "window.__rakazoPageBrowser.snapshot()")
    if not isinstance(data, dict):
        raise RuntimeError("snapshot returned non-object")
    return {"ok": True, **data, **({} if settled else {"loading": True})}


def act(client: CdpClient, session_id: str, actions: list[dict[str, Any]]) -> dict[str, Any]:
    if not actions or len(actions) > 24:
        raise RuntimeError("Expected 1 to 24 actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ("click", "fill", "type", "upload"):
            raise RuntimeError("Invalid browser action")
        if not isinstance(step.get("ref"), str) or not step["ref"]:
            raise RuntimeError("Element ref is required")
        if step["kind"] == "upload":
            # Check every file before acting, so a bad path cannot leave a half-done form.
            step["files"] = resolve_upload_paths(step.get("paths"), roots=step.get("roots"))
        elif step["kind"] != "click" and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        if step.get("origin") is not None and (
            step["kind"] != "fill" or not isinstance(step["origin"], str)
        ):
            raise RuntimeError("An origin applies only to fill")
    ensure_helpers(client, session_id)
    completed = 0
    uncertain = False
    # Refs belong to the document that was typed into; a page that moved on keeps none of them.
    page_changed = False
    try:
        for step in actions:
            kind, ref = step["kind"], step["ref"]
            if page_changed:
                # The result shows the page the code led to, so the bot can carry on from there.
                try:
                    snap = snapshot(client, session_id)
                except Exception:  # noqa: BLE001
                    snap = {"uncertain": True}
                return {"uncertain": False, **snap, "ok": False, "completed": completed,
                        "error": "Stale element ref. Take a fresh snapshot."}
            # Preflight catches stale refs before a mutation is dispatched.
            if not eval_json(client, session_id, f"Boolean(window.__rakazoPageBrowser.resolve({json.dumps(ref)}))"):
                raise RuntimeError("Stale element ref. Take a fresh snapshot.")
            if kind == "upload":
                uncertain = True
                upload(client, session_id, ref, step["files"])
                completed += 1
                uncertain = False
                continue
            if kind == "type":
                uncertain = True
                mark = page_mark(client, session_id)
                # One character goes into the ref'd box alone; longer text replaces the whole code.
                whole = json.dumps(len(step["text"]) > 1)
                focus = eval_json(client, session_id,
                                  f"window.__rakazoPageBrowser.focusForKeys({json.dumps(ref)}, {whole})")
                if isinstance(focus, dict) and focus.get("select"):
                    kind = "fill"
                else:
                    if not isinstance(focus, dict) or not focus.get("focused"):
                        raise RuntimeError("The field did not take keyboard focus. Click it, then type again.")
                    try:
                        page_changed = type_keys(client, session_id, step["text"],
                                                 multiline=bool(focus.get("multiline")), mark=mark)
                    except TypingStopped as stopped:
                        try:
                            snap = snapshot(client, session_id)
                        except Exception:  # noqa: BLE001
                            snap = {"uncertain": True}
                        return {"uncertain": False, **snap, "ok": False, "completed": completed,
                                "error": str(stopped)}
                    completed += 1
                    uncertain = False
                    if not page_changed and not typed_in_full(client, session_id, ref, step["text"]):
                        return {"uncertain": False, **snapshot(client, session_id), "ok": False, "completed": completed,
                                "error": "The page did not keep every character typed. "
                                         "Check the field in this snapshot before trying again."}
                    continue
            arguments = json.dumps(ref)
            if kind != "click":
                arguments += ", " + json.dumps(step["text"])
            if step.get("origin"):
                arguments += ", " + json.dumps(step["origin"])
            uncertain = True
            data = eval_json(client, session_id, f"window.__rakazoPageBrowser.{kind}({arguments})")
            if not isinstance(data, dict):
                raise RuntimeError("Action response unavailable")
            completed += 1
            uncertain = False
        snap = snapshot(client, session_id)
        return {**snap, "completed": completed}
    except Exception as exc:
        return {"ok": False, "completed": completed, "uncertain": uncertain,
                "error": str(exc), "fallback": "computer_act"}


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def run(argv: list[str]) -> int:
    stdin_args = (
        read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    )
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(
            json.dumps(
                {
                    "ok": False,
                    "error": "usage: rakazo-page-browser <command> [json-args]",
                    "fallback": "computer_act",
                }
            )
        )
        return 2
    command = argv[1]
    args: dict[str, Any] = {}
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    if raw_args.strip():
        args = json.loads(raw_args)
    port = cdp_port()
    try:
        wait_for_cdp(port)
        ws_url = discover_ws_url(port)
        client = CdpClient(ws_url)
        client.connect()
        try:
            session_id = attach_page(client)
            if command == "navigate":
                result = navigate(client, session_id, str(args.get("url") or ""))
            elif command == "snapshot":
                result = snapshot(client, session_id)
            elif command == "act":
                actions = args.get("actions")
                if not isinstance(actions, list):
                    raise RuntimeError("actions must be an array")
                result = act(client, session_id, actions)
            else:
                result = {
                    "ok": False,
                    "error": f"unknown command: {command}",
                    "fallback": "computer_act",
                }
                print(json.dumps(result))
                return 2
            print(json.dumps(result))
            return 0  # Structured failures preserve partial action progress.
        finally:
            client.close()
    except Exception as exc:  # noqa: BLE001
        print(json.dumps({"ok": False, "error": str(exc), "fallback": "computer_act",
                              "uncertain": command == "act"}))
        return 0


if __name__ == "__main__":
    sys.exit(run(sys.argv))
