  if (window.__rakazoPageBrowser) return true;
  const refMap = new Map();
  // A refused fill changed nothing the bot cannot see; act() reports it as settled, not uncertain.
  const refused = (message) => new Error(`Refused: ${message}`);
  // A step the page cannot take as asked (stale ref, hidden or covered element, no such option):
  // settled like a refusal, and act() sends the current page along so the bot can pick again.
  const settled = (message) => new Error(`Settled: ${message}`);
