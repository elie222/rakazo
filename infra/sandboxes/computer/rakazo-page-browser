def payment_frame_origin(url: Any) -> bool:
    try:
        parts = urlsplit(str(url))
        port = parts.port
    except ValueError:
        return False
    if parts.username or parts.password or not parts.hostname:
        return False
    return f"{parts.scheme}://{parts.hostname}{f':{port}' if port else ''}" in PAYMENT_FRAME_ORIGINS


