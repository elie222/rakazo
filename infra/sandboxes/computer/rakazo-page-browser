          && !parent.closest(CONTROLS)) {
        // A price split over tags ("$", "3", ".", "00") is one amount; two numbers side by side are not.
        const within = (/\d$/.test(text) && /^[.,]/.test(part)) || (/[$€£₪¥.,]$/.test(text) && /^\d/.test(part));
        text += (!text || within ? "" : /\d$/.test(text) && /^\d/.test(part) ? APART : " ") + part;
        parts += 1;
      }
    }
    return text;
  }
  // The order lines the checkout lists above its total, as the page words them: each a name and the amount
  // at its end, such as an item with its quantity and price, delivery or tax. Read back from the total no further
  // than a card field, so a summary beside the card form is not mixed with the page above it. None without a total.
  // Order lines are a courtesy on the card: past this many milliseconds the page lists none, so a huge page never
  // slows the purchase check itself.
  const ITEMS_BUDGET_MS = 200;
  function orderItems() {
    const until = performance.now() + ITEMS_BUDGET_MS;
    const all = [...(document.body?.querySelectorAll("*") || [])];
    const small = (el, max) => (el.textContent || "").length <= max && !el.closest(CONTROLS) && !el.closest(PAGE_EDGES);
    // The last totals of the page, found from its end, and the stretch of the page just above them.
    const totals = [];
    let last = -1;
    for (let i = all.length - 1; i >= Math.max(0, all.length - 20000) && totals.length < 5; i--) {
      if (performance.now() > until) return [];
      const el = all[i];
      if (small(el, 200) && TOTAL.test(el.textContent) && !SUBTOTAL.test(el.textContent) && visible(el)) {
        totals.push(el);
        if (last < 0) last = i;
      }
    }
    if (!totals.length) return [];
    const rows = [];
    for (const el of all.slice(Math.max(0, last - 3000), last + 1).reverse()) {
      if (rows.length >= 400) break;
      if (performance.now() > until) return [];
      if (!small(el, 400) || !ANY_AMOUNT.test(el.textContent) || el.querySelector(CHOICES)
          || !seen(el) || offers(el)) continue;
      const text = shownText(el);
      const amount = text.length <= 160 ? text.match(LINE_AMOUNT)?.[0] : "";
      const name = amount ? text.slice(0, -amount.length).replaceAll(APART, " ").replace(/[\s:·•–—-]+$/u, "") : "";
      // A name with an amount of its own may be several lines read as one, which would put one line's price on
      // another's name: left out. Whole, so the bot's secrets are found and hidden before the card cuts it.
      if (/\p{L}/u.test(name) && !ANY_AMOUNT.test(name)) rows.unshift({ el, name, amount });
    }
    // The line itself, not the list or row group around it.
    const lines = rows.filter((row) => !rows.some((other) => other !== row && row.el.contains(other.el)));
    const cards = pageCards();
    const before = (a, b) => Boolean(b.compareDocumentPosition(a) & Node.DOCUMENT_POSITION_PRECEDING);
    // The last total first; an earlier one when the last has nothing listed above it.
    for (const total of totals) {
      const found = [];
      for (const line of [...lines].reverse()) {
        if (!before(line.el, total) || line.el.contains(total)) continue;
        if (cards.some((card) => before(line.el, card) && before(card, total))) break;
        if (!TOTAL_LINE.test(line.name) && !SUBTOTAL.test(line.name)) found.unshift({ name: line.name, amount: line.amount });
      }
      if (found.length) return found.slice(0, 30);
    }
    return [];
  }
  // What the card shows: the button's text, and the amount the button names or else the page's total.
  // `words`: everything the control says, so an amount only its aria label names is the one shown.
  // A button that names another amount than the page's total also reports the total, which the spending
  // limit counts if larger. `items`: the order lines the page lists, when it lists any.
  function shownPurchase(reason, label, words = [label]) {
    const named = words.map((word) => moneyIn(word, false)).find(Boolean) || "";
    const total = totalShown();
    const items = orderItems();
    return { reason, label: cut(label, 80), amount: named || total, amountFrom: named ? "button" : "page",
      ...(named && total && total !== named ? { total } : {}), ...(items.length ? { items } : {}) };
  }
  // `frame`: the page shows a payment provider's card frame, which only the caller can vouch for.
  function purchaseOf(el, frame) {
    const words = wordsOf(el);
    const form = submittedForm(el);
    let reason = null;
    if (form && ([...form.elements].some(cardLike) || (frame && form.querySelector("iframe,frame")))) reason = "card_form";
    else if ((el instanceof HTMLButtonElement || el instanceof HTMLInputElement || el instanceof HTMLAnchorElement
        || el.getAttribute("role") === "button" || pressable(el)) && isFinalStep(words, el)) reason = "final_step";
    else if ((frame || pageCards().length) && pressable(el) && !inSurroundings(el)
        && !words.some((word) => NOT_PAYING.test(phrase(word)))) reason = "payment_page";
    return reason ? shownPurchase(reason, words[0] || "", words) : null;
  }
  // The control a click at this spot of the page presses, unless it lands on a field, label or nothing.
  function pressedControl(hit) {
    const field = "input:not([type=submit]):not([type=button]):not([type=image]):not([type=reset]), textarea, select, label, [contenteditable]";
    for (let node = hit; node && node !== document.documentElement; node = node.parentElement || node.getRootNode().host) {
      // A click on a label presses its control: a submit button pays, a field or anything else does not.
      if (node instanceof HTMLLabelElement && node.control) {
        const control = node.control;
        return !control.matches?.(field) && (pressable(control) || control.matches?.("a, button, input, [role=button]"))
          ? control : null;
      }
      if (node.matches?.(field)) return null;
      if (pressable(node) || node.matches?.("a, button, input, [role=button]")) return node;
    }
    return null;
  }
  const FRAMES = ["iframe", "frame", "object", "embed"];
  const hasFrames = () => Boolean(document.querySelector("iframe,frame"));
  // The window's page starts below its toolbar. Calibrated for a window with the plain toolbar and no side
  // panel or docked tools: anything else moves the page, so a spot cannot be placed.
  const TOOLBAR_HEIGHT = 87;
  window.__rakazoPurchase = {
    // Where a point of the screen (x, y) is in this page, or null when that cannot be told (a zoomed page,
    // a scaled screen, a window with more than the toolbar).
    pagePoint(x, y) {
      if (window.devicePixelRatio !== 1 || !Number.isFinite(x) || !Number.isFinite(y)) return null;
      if (window.outerWidth !== window.innerWidth
          || Math.abs(window.outerHeight - window.innerHeight - TOOLBAR_HEIGHT) > 2) return null;
      const side = (window.outerWidth - window.innerWidth) / 2;
      const at = [x - (window.screenX + side), y - (window.screenY + window.outerHeight - window.innerHeight - side)];
      return { x: at[0], y: at[1], inside: at[0] >= 0 && at[1] >= 0 && at[0] < window.innerWidth && at[1] < window.innerHeight };
    },
    // What a click at a spot of this page (in viewport coordinates) would press: the purchase it completes, or
    // `inFrame` when the spot is inside a frame, whose own page must be asked.
    purchaseAt(x, y, frame = false) {
      if (!(x >= 0 && y >= 0 && x < window.innerWidth && y < window.innerHeight)) return { offscreen: true };
      const hit = elementAtPoint(x, y);
      const inFrame = Boolean(hit) && FRAMES.includes(hit.tagName.toLowerCase());
      const control = hit && !inFrame ? pressedControl(hit) : null;
      return { purchase: control && !control.matches(":disabled") ? purchaseOf(control, frame) : null,
        inFrame, scroll: [window.pageXOffset, window.pageYOffset], frames: hasFrames() };
    },
    // The same for a node the browser found at a spot inside a frame of this process.
    purchaseOfNode(node, frame = false) {
      const control = node instanceof Element ? pressedControl(node) : null;
      return control && !control.matches(":disabled") ? purchaseOf(control, frame) : null;
    },
    // A click or key whose spot is not known: the page shows a card form or a payment frame, or a control
    // worded as a final step. For a key (`enter`), the control with focus first.
    paymentPage(frame = false, enter = false) {
      const active = enter ? document.activeElement : null;
      const typingIn = active?.form && [...active.form.elements].some(cardLike) ? active.form : null;
      const submit = typingIn && [...typingIn.elements].find((el) => submittedForm(el) === typingIn);
      const focused = typingIn ? shownPurchase("card_form", submit ? wordsOf(submit)[0] || "" : "")
        : active && active !== document.body ? purchaseOf(pressedControl(active) || active, frame) : null;
      if (focused) return { purchase: focused, frames: hasFrames() };
      // Enter in a field submits only that field's form.
      if (active?.matches?.("input, textarea, select")) {
        const own = active.form && [...active.form.elements].find((el) => submittedForm(el) === active.form);
        return { purchase: own ? purchaseOf(own, frame) : null, frames: hasFrames() };
      }
      const final = [...document.querySelectorAll("button, input, a, [role=button]")].find((el) =>
        pressable(el) && visible(el) && !el.matches(":disabled") && isFinalStep(wordsOf(el), el));
      const shown = Boolean(frame || pageCards().length || final);
      return { purchase: shown ? shownPurchase("payment_page", final ? wordsOf(final)[0] || "" : "") : null,
        frames: hasFrames() };
    },
  };
  return true;
})()
"""

# Zero-width, bidirectional and tag characters, which the card does not show.
INVISIBLE = re.compile("[\U000E0000-\U000E007F​-‏⁠-⁤‪-‮⁦-⁩﻿]")
# What the card shows when not even the page's own signals can be read: the check asks rather than allows.
UNREADABLE_PURCHASE = {"reason": "unreadable", "label": "", "amount": "", "amountFrom": "page"}
DESKTOP_DEADLINE_SECONDS = 8.0
# Chromium's answer for a world whose document the tab has just replaced, and how long the check waits
# for the new one.
DOCUMENT_GONE = "Cannot find context with specified id"
DOCUMENT_GONE_TRIES = 5
DOCUMENT_GONE_WAIT_SECONDS = 0.2
# Elements that hold another document.
FRAME_ELEMENTS = ("IFRAME", "FRAME", "OBJECT", "EMBED")


def shown(text: Any) -> str:
    """Page text as the card shows it: no invisible characters, one space between words."""
    return " ".join(INVISIBLE.sub("", str(text or "")).split())


class Offscreen(RuntimeError):
    """The control is out of view, so no spot of the page shows it."""


class Deadline(RuntimeError):
    """The desktop check ran out of time."""


def check_deadline(deadline: float) -> None:
    if time.monotonic() > deadline:
        raise Deadline()


class Purchases:
    """The tab's purchase checks, in page_secrets' isolated world of each frame."""

    def __init__(self, port: int, target: str) -> None:
        self.client = page_secrets.connect(port)
        try:
            self.session = page_secrets.attach(self.client, target)
        except Exception:
            self.client.close()
            raise

    def close(self) -> None:
        self.client.close()

    def ask(self, session: str, world: int | None, call: str) -> Any:
        return page_secrets.eval_json(self.client, session, f"{PURCHASE_HELPERS}, window.__rakazoPurchase.{call}",
                                      context_id=world)

    def where(self) -> dict[str, str]:
        found = page_secrets.eval_json(self.client, self.session,
                                       "({url: location.href, title: (document.title || '').slice(0, 200)})")
        return {key: str(found.get(key) or "") for key in ("url", "title")} if isinstance(found, dict) else {}

    def site(self) -> str:
        """The top page's host. Each check starts here, in the world of the document the tab shows now: an
        earlier step may have navigated."""
        tries = DOCUMENT_GONE_TRIES
        while True:
            try:
                top = page_secrets.main_frame(self.client, self.session)["id"]
                self.client.context_id = page_secrets.world_in(self.client, self.session, top)
                host = page_secrets.eval_json(self.client, self.session, "location.host")
                return host if isinstance(host, str) else ""
            except RuntimeError as error:
                # The tab replaced its document between finding the world and reading it, as a login's
                # redirect does: read the new one. A page that keeps doing it still fails, and asks.
                tries -= 1
                if DOCUMENT_GONE not in str(error) or not tries:
                    raise
                time.sleep(DOCUMENT_GONE_WAIT_SECONDS)

    def asked_with_frames(self, session: str, world: int | None, call: str) -> dict[str, Any] | None:
        """`call` (with a %s for whether the page shows a payment provider's frame), asked again with one."""
        found = self.ask(session, world, call % "false")
        if not isinstance(found, dict):
            return None
        if found.get("purchase") is None and found.get("frames"):
            try:
                frame = bool(page_secrets.payment_frames(self.client, session))
            except Exception:  # noqa: BLE001
                frame = False
            if frame:
                found = self.ask(session, world, call % "true")
        return found if isinstance(found, dict) else None

    def frames(self, deadline: float) -> list[tuple[str, int]]:
        """Every frame of the page, of any origin, as (session, world): at most 32."""
        sessions = [(self.session, False)]
        try:
            sessions += [(child, True) for child in page_secrets.auto_attach(self.client, self.session)]
        except Exception:  # noqa: BLE001
            pass
        found: list[tuple[str, int]] = []
        for session, own in sessions:
            check_deadline(deadline)
            try:
                if own:
                    self.client.call("Page.enable", session_id=session)
                tree = self.client.call("Page.getFrameTree", session_id=session)["frameTree"]
            except Exception:  # noqa: BLE001
                continue
            stack = [tree] if own else list(tree.get("childFrames") or [])
            while stack and len(found) < 32:
                node = stack.pop(0)
                stack += node.get("childFrames") or []
                check_deadline(deadline)
                try:
                    found.append((session, page_secrets.world_in(self.client, session, node["frame"]["id"])))
                except Exception:  # noqa: BLE001
                    continue
        return found

    def signals(self, enter: bool, deadline: float = float("inf"), frames: bool = True) -> dict[str, Any] | None:
        """The purchase the page shows without a spot to look at: in the page itself, else in any of its frames."""
        call = "paymentPage(%s, " + json.dumps(enter) + ")"
        found = self.asked_with_frames(self.session, None, call)
        if found and isinstance(found.get("purchase"), dict):
            return found["purchase"]
        for session, world in self.frames(deadline) if frames else []:
            try:
                inside = self.ask(session, world, call % "false")
            except Exception:  # noqa: BLE001
                continue
            if isinstance(inside, dict) and isinstance(inside.get("purchase"), dict):
                return inside["purchase"]
        return None

    def signals_or_ask(self, enter: bool) -> dict[str, Any] | None:
        """After a failed check: the payment the page itself shows, and a page that cannot be read asks."""
        try:
            return self.signals(enter, frames=False)
        except Exception:  # noqa: BLE001
            return dict(UNREADABLE_PURCHASE)

    def at_point(self, session: str, world: int | None, x: float, y: float, deadline: float,
                 depth: int = 0) -> tuple[str, dict[str, Any] | None]:
        """What a click at (x, y) of this page's viewport presses: ("buy", purchase), ("none", None) when it
        lands on nothing that pays, or ("unknown", None) when a frame it lands in cannot be looked into."""
        check_deadline(deadline)
        client = self.client
        try:
            found = self.asked_with_frames(session, world, f"purchaseAt({json.dumps(x)}, {json.dumps(y)}, %s)")
        except Exception:  # noqa: BLE001
            return "unknown", None
        if not found:
            return "unknown", None
        if found.get("offscreen"):
            return ("offscreen" if depth == 0 else "unknown"), None
        if isinstance(found.get("purchase"), dict):
            return "buy", found["purchase"]
        if not found.get("inFrame"):
            return "none", None
        if depth >= 3:
            return "unknown", None
        scroll_x, scroll_y = found.get("scroll") or [0, 0]
        try:
            # The browser's own hit-test, which counts from the top of the page and goes into frames of this process.
            hit = client.call("DOM.getNodeForLocation", {"x": x + scroll_x, "y": y + scroll_y,
                                                         "includeUserAgentShadowDOM": True}, session_id=session)
            top = page_secrets.main_frame(client, session)["id"]
            node = client.call("DOM.describeNode", {"backendNodeId": hit["backendNodeId"]}, session_id=session)["node"]
            is_frame = str(node.get("nodeName", "")).upper() in FRAME_ELEMENTS
            if hit.get("frameId") != top and not is_frame:
                inner = page_secrets.world_in(client, session, hit["frameId"])
                page_secrets.eval_json(client, session, PURCHASE_HELPERS, context_id=inner)
                resolved = client.call("DOM.resolveNode", {"backendNodeId": hit["backendNodeId"],
                                                           "executionContextId": inner}, session_id=session)
                value = page_secrets.page_value(client.call("Runtime.callFunctionOn", {
                    "objectId": resolved["object"]["objectId"], "returnByValue": True,
                    "functionDeclaration": "function () { return window.__rakazoPurchase.purchaseOfNode(this, false); }",
                }, session_id=session))
                # Nothing paying in the frame itself: the page around it may still be the checkout.
                return ("buy", value) if isinstance(value, dict) else ("unknown", None)
            if not is_frame:
                return "unknown", None
            # A frame of another process: its own session answers, for the spot as that frame's page sees it.
            for child in page_secrets.auto_attach(client, session):
                check_deadline(deadline)
                frame = page_secrets.main_frame(client, child)
                owner = client.call("DOM.getFrameOwner", {"frameId": frame["id"]}, session_id=session)
                if owner.get("backendNodeId") != hit["backendNodeId"]:
                    continue
                box = client.call("DOM.getBoxModel", {"backendNodeId": hit["backendNodeId"]},
                                  session_id=session)["model"]["content"]
                client.call("Page.enable", session_id=child)
                inner = page_secrets.world_in(client, child, frame["id"])
                # The box is where the frame is in the viewport, scroll included.
                return self.at_point(child, inner, x - box[0], y - box[1], deadline, depth + 1)
        except Deadline:
            raise
        except Exception:  # noqa: BLE001
            return "unknown", None
        return "unknown", None

    def click(self, box: dict[str, Any] | None, scrolled: bool) -> dict[str, Any] | None:
        """What a click on a control of the top page, at the middle of its box in the viewport, would buy.
        Raises Offscreen for a control out of view the first time; one that cannot be looked at answers
        with what the page itself shows."""
        deadline = time.monotonic() + DESKTOP_DEADLINE_SECONDS
        try:
            x = float(box["x"]) + float(box["width"]) / 2  # type: ignore[index]
            y = float(box["y"]) + float(box["height"]) / 2  # type: ignore[index]
            verdict, found = self.at_point(self.session, None, x, y, deadline)
        except Exception:  # noqa: BLE001
            verdict, found = "unknown", None
        if verdict == "offscreen" and not scrolled:
            raise Offscreen()
        if verdict in ("buy", "none"):
            return found if verdict == "buy" else None
        # The spot could not be looked into, perhaps a frame, or the control is still out of view: what the
        # page or any of its frames shows decides, within the same time.
        try:
            return self.signals(False, deadline)
        except Exception:  # noqa: BLE001
            return dict(UNREADABLE_PURCHASE)

    def desktop(self, args: dict[str, Any]) -> dict[str, Any] | None:
        """The purchase a click or key on the screen would complete, or None.

        Each click is looked up on the page at its spot and asks only when it lands on a control that pays; a
        spot outside the browser window asks nothing. A key, or a spot that cannot be placed or looked into,
        asks when the page shows a payment by itself.
        """
        deadline = time.monotonic() + DESKTOP_DEADLINE_SECONDS
        enter = args.get("enter") is True
        points = [(p["x"], p["y"]) for p in (args.get("points") or [])[:24]
                  if isinstance(p, dict) and all(isinstance(p.get(k), (int, float)) for k in ("x", "y"))]
        unknown = enter or not points or args.get("unplaced") is True
        try:
            for x, y in points:
                placed = self.ask(self.session, None, f"pagePoint({json.dumps(x)}, {json.dumps(y)})")
                if not isinstance(placed, dict):
                    unknown = True
                elif placed.get("inside"):
                    verdict, found = self.at_point(self.session, None, placed["x"], placed["y"], deadline)
                    if verdict == "buy":
                        return found
                    unknown = unknown or verdict != "none"
            return self.signals(enter, deadline) if unknown else None
        except Exception:  # noqa: BLE001
            # Out of time, or a lookup failed: what the page itself already shows still asks.
            return self.signals_or_ask(enter)


def purchase_refusal(step: dict[str, Any], site: str, buying: dict[str, Any] | None, completed: int) -> dict[str, Any] | None:
    """Why a click that buys is not made: bought only on the user's word, for this site, while the button
    and total still say what the card showed. An earlier step may have changed the page since the caller asked."""
    if not buying:
        return None
    approved = step.get("approved") is True and step.get("site") == site
    # A total the card showed beside the button (empty when it showed none) must still be the page's.
    changed = approved and any(key in step and shown(step[key]) != shown(buying.get(key, ""))
                               for key in ("label", "amount", "total"))
    if approved and not changed:
        return None
    return {"ok": False, "completed": completed, "uncertain": False, "purchase": {**buying, "site": site},
            "error": PURCHASE_CHANGED if changed else PURCHASE_REFUSED}


def resolve_upload_paths(paths: Any, home: str | None = None, roots: list[str] | None = None) -> list[str]:
    """Resolve regular files within trusted roots before handing them to Chromium."""
    if not isinstance(paths, list) or not 1 <= len(paths) <= MAX_UPLOAD_FILES:
        raise RuntimeError(f"upload needs 1 to {MAX_UPLOAD_FILES} file paths")
    home = os.path.realpath(home or os.environ.get("HOME") or "/home/rakazo")
    location = "your folder or shared/" if roots is not None else "this computer's home folder"
    allowed = [home]
    if roots is not None:
        allowed = []
        for root in roots:
            expected = os.path.normpath(os.path.join(home, root))
            full = os.path.realpath(expected)
            # A root redirected by a symlink (bots/b1 -> bots/b2) could reach another bot's files.
            if os.path.isabs(root) or full != expected or os.path.commonpath([home, full]) != home:
                raise RuntimeError(f"Upload files must be inside {location}")
            # A folder that does not exist yet holds no files; the other root still applies.
            if os.path.isdir(full):
                allowed.append(full)
    max_bytes = max_file_bytes()
    resolved = []
    total = 0
    for path in paths:
        if not isinstance(path, str) or not path.strip():
            raise RuntimeError("upload paths must be non-empty strings")
        full = os.path.realpath(os.path.join(home, path))
        # Check confinement before existence to avoid revealing outside targets.
        if not any(os.path.commonpath([root, full]) == root for root in allowed):
            raise RuntimeError(f"Upload files must be inside {location}: {path}")
        try:
            info = os.stat(full)
        except OSError:
            raise RuntimeError(f"File not found: {path}") from None
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"Not a regular file: {path}")
        total += info.st_size
        if total > max_bytes:
            raise RuntimeError(f"upload files are larger than {max_bytes / (1024 * 1024):g} MB in total")
        resolved.append(full)
    return resolved


def validate_actions(actions: Any) -> None:
    """Every step is checked before any runs, so a bad one cannot leave a half-done form."""
    if not isinstance(actions, list) or not actions or len(actions) > 24:
        raise RuntimeError("Expected 1 to 24 actions")
    for step in actions:
        if not isinstance(step, dict) or step.get("kind") not in ("click", "fill", "type", "upload", "pay_token"):
            raise RuntimeError("Invalid browser action")
        if step["kind"] == "pay_token":
            if (step.get("ref") is not None or not isinstance(step.get("text"), str) or not step["text"]
                    or not isinstance(step.get("origin"), str) or not isinstance(step.get("merchantAccountId"), str)):
                raise RuntimeError("A pay token needs its text, origin and merchant account, and no ref")
            continue
        if step.get("ref") is None and step["kind"] == "fill" and step.get("field") == "card":
            if step.get("cardField") not in page_secrets.CARD_AUTOCOMPLETE:
                raise RuntimeError("A card fill without a ref needs its card field")
        elif not isinstance(step.get("ref"), str) or not re.fullmatch(r"e\d+", step["ref"]):
            raise RuntimeError("Element ref is required")
        if step["kind"] == "upload":
            step["files"] = resolve_upload_paths(step.get("paths"), roots=step.get("roots"))
        elif step["kind"] != "click" and not isinstance(step.get("text"), str):
            raise RuntimeError("Text is required")
        if step.get("origin") is not None and (step["kind"] != "fill" or not isinstance(step["origin"], str)):
            raise RuntimeError("An origin applies only to fill")
        if ("approved" in step or "site" in step) and (
                step["kind"] != "click" or not isinstance(step.get("approved"), bool)
                or not isinstance(step.get("site"), str)):
            raise RuntimeError("An approval applies only to click, with the site it was given for")
        if ("label" in step or "amount" in step or "total" in step) and (
                step["kind"] != "click" or not isinstance(step.get("approved"), bool)
                or not all(isinstance(step.get(key, ""), str) for key in ("label", "amount", "total"))):
            raise RuntimeError("An approved label and amount apply only to an approved click")
        # A card detail is hidden and checked only on an origin-bound fill.
        if step.get("field") == "card" and not step.get("origin"):
            raise RuntimeError("A card fill needs its origin")
        if step.get("origin") and not step.get("field"):
            raise RuntimeError("A saved login fill needs its field")


def exit_when_stdin_closes() -> None:
    """The supervisor owns this pipe; losing it cancels this helper, not Chromium."""
    try:
        while os.read(0, 1024):
            pass
    finally:
        os._exit(130)


def read_stdin_line() -> str:
    """Read one line from fd 0 unbuffered, leaving the rest of stdin for the EOF watcher."""
    data = bytearray()
    while len(data) < 1_048_576:
        chunk = os.read(0, 1)
        if not chunk or chunk == b"\n":
            break
        data += chunk
    return data.decode("utf-8")


def tab_deadline() -> float:
    return min(time.monotonic() + TAB_WORK_SECONDS, STARTED + TABS_DONE_BY)


def run(argv: list[str]) -> int:
    stdin_args = read_stdin_line() if os.environ.get("RAKAZO_BROWSER_ARGS_STDIN") == "1" else None
    if os.environ.get("RAKAZO_BROWSER_WATCH_STDIN") == "1":
        threading.Thread(target=exit_when_stdin_closes, daemon=True).start()
    if len(argv) < 2:
        print(json.dumps({"ok": False, "error": "usage: rakazo-page-browser <command> [json-args]",
                          "fallback": "computer_act"}))
        return 2
    command = argv[1]
    if command not in ("navigate", "snapshot", "act", "finish", "purchase_check"):
        print(json.dumps({"ok": False, "error": f"unknown command: {command}", "fallback": "computer_act"}))
        return 2
    raw_args = stdin_args if stdin_args is not None else (argv[2] if len(argv) >= 3 else "")
    args: dict[str, Any] = json.loads(raw_args) if raw_args.strip() else {}
    if command == "finish":
        try:
            finish_later(args.get("downloads") or [])
        except (OSError, RuntimeError):
            print(json.dumps({"downloads": [{"error": DOWNLOAD_FAILED}]}))
            return 1
        return 0
    port = cdp_port()
    downloads: Downloads | None = None
    client: CdpClient | None = None
    saved: list[dict[str, Any]] = []
    # Set once the browser answers: before that, no action can have reached the page.
    connected = False
    opened = False
    page: PageBrowser | None = None
    try:
        if command == "purchase_check":
            # No browser running, no tab open, or one of Chromium's own pages: nothing on it can be bought.
            # Any other failure is a failed check, which asks.
            try:
                # A closed browser has nothing to buy, and a desktop press waits on this check, so it is
                # told apart at once; a browser that is only slow is waited for, and failing still asks.
                address = ""
                if not browser_closed(port):
                    wait_for_cdp(port)
                    address = front_tab(port)[1]
            except RuntimeError as error:
                if str(error) != NO_TAB:
                    raise
                address = ""
            if not address or internal(address):
                print(json.dumps({"ok": True, "site": "", "purchase": None, "url": address, "title": ""}))
                return 0
        version = wait_for_cdp(port)
        connected = True
        browser = AgentBrowser(port)
        tabs: Tabs | None = None
        # Best effort here and below: a tab list that fails leaves the call as it was. A purchase check
        # presses nothing, so it leaves the tabs and what they have opened to the next call.
        if command != "purchase_check":
            with contextlib.suppress(Exception):
                started = Tabs(browser.home, port, (version or {}).get("webSocketDebuggerUrl"), browser.use_tab)
                browser.deadline = started.deadline = tab_deadline()
                try:
                    started.begin()
                finally:
                    browser.deadline = None
                # Only once it knows the tabs the call began with: without them, every tab would look new.
                tabs = started
        target, address = front_tab(port)
        if args.get("downloads") is not None:
            client = CdpClient(discover_ws_url(port))
            client.connect()
            downloads = Downloads(client, args["downloads"])
        if internal(address):
            if command != "navigate":
                raise RuntimeError(INTERNAL_PAGE)
            # agent-browser cannot drive Chromium's own pages, so the site opens in a tab of its own,
            # in front, and an empty new tab page it replaces is closed.
            url = str(args.get("url") or "")
            check_url(url)
            (tab,) = browser.batch([["tab", "new", url]], timeout=NAVIGATE_SECONDS)
            if urlsplit(address).netloc in ("newtab", "new-tab-page"):
                urllib.request.urlopen(f"http://127.0.0.1:{port}/json/close/{target}", timeout=5.0).close()
            # The tab it opened, by its id: a pop-up the site opens as it loads may already be in front.
            target = str(tab.get("targetId") or "") or front_tab(port)[0]
            # The new tab is already on the site: navigating it again would go unseen by the request log
            # it has only just started.
            opened = True
        browser.use_tab(target)
        page = PageBrowser(port, target, browser)
        if downloads:
            session = client.call("Target.attachToTarget", {"targetId": target, "flatten": True})["sessionId"]
            frame = client.call("Page.getFrameTree", session_id=session)["frameTree"]["frame"]
            client.download_frame = frame["id"]
            client.call("Network.enable", {"maxPostDataSize": 1}, session_id=session)
            page.downloads = downloads
        if command == "navigate":
            result = page.navigate(str(args.get("url") or ""), opened=opened)
        elif command == "purchase_check":
            result = page.purchase_check(args)
        elif command == "snapshot":
            query = args.get("query")
            result = page.snapshot(query=query.strip()[:200] if isinstance(query, str) and query.strip() else None)
        else:
            actions = args.get("actions")
            if not isinstance(actions, list):
                raise RuntimeError("actions must be an array")
            result = page.act(actions)
        note = None
        if tabs is not None:
            closed = tabs.closed
            now: list[dict[str, Any]] = []
            new: list[dict[str, Any]] = []
            browser.deadline = tabs.deadline = tab_deadline()
            try:
                now, new, _ = tabs.end(target, ours=target if opened else None)
            except Exception:  # noqa: BLE001
                pass  # The tabs it closed before failing are still counted below.
            try:
                if tabs.closed > closed and any(key in result for key in ("url", "tree")):
                    # What the bot read may have been one of the closed tabs: its own tab is read again, and
                    # nothing read from a closed tab, a dialog's text included, is ever returned.
                    for key in ("url", "title", "tree", "elements", "loading", "note", "dialog"):
                        result.pop(key, None)
                    try:
                        browser.use_tab(target)
                        result.update(page.snapshot(0.0))
                    except Exception:  # noqa: BLE001
                        result.update(ok=False, error=REREAD_FAILED,
                                      **({"uncertain": False} if command == "act" else {}))
            finally:
                browser.deadline = None
            note = tabs.note(now, new, result.get("url"))
        if downloads:
            front: dict[str, Any] = {}
            with contextlib.suppress(Exception):
                front = page_tabs(port)[0]
            page.save_pdf(front)
            client.listen(0.01)
            saved = downloads.finish()
            downloads = None
        if note:
            result["note"] = " ".join(filter(None, [result.get("note"), note]))
        print(json.dumps({**result, **({"downloads": saved} if saved else {})}))
        return 0  # Structured failures preserve partial action progress.
    except Exception as exc:  # noqa: BLE001
        if downloads:
            try:
                client.listen(0.01)
                saved = downloads.finish()
            except Exception:
                saved = [{"error": DOWNLOAD_FAILED}]
        dialog = page.dialog() if page else None
        failure = page.dialog_result(dialog, {}) if page and dialog else {
            "ok": False, "error": str(exc), "fallback": "computer_act", "uncertain": command == "act" and connected}
        print(json.dumps({**failure, **({"downloads": saved} if saved else {})}))
        return 0
    finally:
        if page:
            page.close()
        if client:
            client.close()


if __name__ == "__main__":
    sys.exit(run(sys.argv))
