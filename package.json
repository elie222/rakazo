{
  "name": "rakazo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "gallery": "pnpm --filter @rakazo/web dev --open /e2e/fixtures/gallery.html",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "checks": "node --test scripts/checks/*.test.mjs",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @rakazo/db generate",
    "db:migrate": "pnpm --filter @rakazo/api db:migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer",
    "sandbox:boat-snapshot": "tsx packages/adapters/src/providers/computer/boat/build-boat-snapshot.ts",
    "sandbox:boxd-snapshot": "tsx packages/adapters/src/providers/computer/boxd/build-boxd-snapshot.ts",
    "sandbox:novita-template": "tsx packages/adapters/src/providers/computer/novita/build-novita-template.ts",
    "sandbox:e2b-template": "tsx packages/adapters/src/providers/computer/e2b/build-e2b-template.ts",
    "test": "node --test scripts/pnpm.test.mjs scripts/setup-worktree.test.mjs && vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @rakazo/db generate && tsx packages/testkit/src/screenshots/mobile-screenshots.ts",
    "ios:screenshots": "pnpm --filter @rakazo/db generate && tsx packages/testkit/src/screenshots/ios-app-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/runtime/pi-offline.test.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:evals:compare": "tsx packages/testkit/src/evals/compare.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "test:flows": "tsx packages/testkit/src/cli/flows.ts",
    "perf:desktop": "tsx packages/testkit/src/performance/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/performance/compare-performance.ts",
    "perf:mobile-stack": "tsx packages/testkit/src/performance/mobile-stack.ts",
    "bench:page-browser": "tsx packages/testkit/src/cli/page-browser-bench.ts",
    "perf:web-chat": "tsx packages/testkit/src/performance/web-chat-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down",
    "intl:extract": "lingui extract --clean",
    "intl:compile": "lingui compile"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@lingui/cli": "6.12.0",
    "@lingui/conf": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@types/node": "24.19.2",
    "cross-env": "10.1.0",
    "esbuild": "0.28.2",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
