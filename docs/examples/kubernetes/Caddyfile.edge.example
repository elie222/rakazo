# Install ONLY after the upstream is private and oauth2-proxy is configured.
# RAKAZO_PRIVATE_UPSTREAM: private ingress host:port (reachable only by the edge).
# RAKAZO_AUTH_UPSTREAM: local oauth2-proxy host:port, proxying to the same ingress.
{$RAKAZO_PUBLIC_HOST} {
	# Keep the full path: the token in it is checked by Rakazo, not by this matcher.
	handle /novnc/session/* {
		header {
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy {$RAKAZO_PRIVATE_UPSTREAM}
	}
	# Includes /oauth2/callback, all normal pages, /api/* and /novnc/.
	handle {
		reverse_proxy {$RAKAZO_AUTH_UPSTREAM}
	}
}
