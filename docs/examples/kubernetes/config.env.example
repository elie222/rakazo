# Nonsecret settings. Replace the hostname, all three origins, and both owner emails.
NODE_ENV=production
DATA_DIR=/data
CONTENT_ENCRYPTION=on
SECRET_STORE=encrypted
WAKEUP_DRIVER=graphile
AGENT_RUNTIME=pi
API_HOST=0.0.0.0
API_PORT=3100
API_PROXY_TARGET=http://rakazo-api:3100
RAKAZO_HOST=app.example.com
BETTER_AUTH_URL=https://app.example.com
WEB_ORIGIN=https://app.example.com
API_URL=https://app.example.com
# Headless DNS names resolve the actual proxy Pods. Replace the example edge IP.
# Include other verified proxy hops (for example an OAuth proxy or a SNAT node) as needed.
TRUSTED_PROXIES=rakazo-web-peers.rakazo.svc.cluster.local,rakazo-ingress-peers.kube-system.svc.cluster.local,192.0.2.20/32
AUTH_PASSWORD_ENABLED=true
SIGNUPS_ENABLED=false
SIGNUP_ALLOWLIST=owner@example.com
OWNER_EMAIL=owner@example.com
EMAIL_PROVIDER=none
SANDBOX_PROVIDER=kubernetes
KUBERNETES_SANDBOX_NAMESPACE=rakazo-sandboxes
KUBERNETES_SANDBOX_COMPUTER_IMAGE=ghcr.io/elie222/rakazo/computer@sha256:d3e81bfcaf137f441cca63e7e72f61f83e8d8fdf1093a16aec368083eb916fa0
KUBERNETES_SANDBOX_CPU_LIMIT=2
KUBERNETES_SANDBOX_MEMORY_LIMIT=4Gi
KUBERNETES_SANDBOX_READY_TIMEOUT_MS=300000
SANDBOX_MAX_COMPUTERS_PER_USER=2
COMPUTER_MAX_ACTIVE_UNBILLED_MS=1800000
DB_POOL_MAX=10
RAYON_NUM_THREADS=4
