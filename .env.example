NODE_ENV=development
DATABASE_URL=postgres://rakazo:rakazo@127.0.0.1:5433/rakazo
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Optional separate service credential; defaults to BETTER_AUTH_SECRET when empty.
SANDBOX_SUPERVISOR_TOKEN=
SANDBOX_PROVIDER=docker
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
BOX_API_KEY=
# Optional Box API base URL; defaults to https://ascii.dev/api/box/v1.
BOX_API_URL=
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
# Pause or stop computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
SANDBOX_COMMAND_TIMEOUT_MS=300000
OPENROUTER_API_KEY=
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
# Optional local OpenAI-compatible models. Leave blank to disable the provider.
RAKAZO_LOCAL_MODELS=
RAKAZO_LOCAL_MODELS_URL=http://127.0.0.1:11434/v1
RAKAZO_LOCAL_CONTEXT_WINDOW=32768
RAKAZO_LOCAL_MAX_TOKENS=4096
E2B_API_KEY=
COMPOSIO_API_KEY=
SUPERMEMORY_API_KEY=
# Optional. Defaults to https://api.supermemory.ai. Self-hosted: http://localhost:6767
SUPERMEMORY_API_URL=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
# Set to 0 to remove the owner-only in-app server update entirely.
RAKAZO_SELF_UPDATE=

# --- Compose deployments: the updater sidecar ---
# Absolute path of this checkout as the Docker *daemon* sees it. The updater is bind-mounted at this
# exact path so that Compose resolves the same relative bind mounts inside the container that it
# does from your shell. Must be POSIX-absolute. Required by infra/compose/docker-compose.prod.yml.
#
# On Linux, where the daemon shares the host's filesystem, this is just the checkout path:
#   RAKAZO_DEPLOY_DIR=/srv/rakazo
#
# On Docker Desktop (Windows/macOS) the daemon runs inside a VM, so the host path and the daemon
# path differ and you have to name the daemon's. Docker Desktop mounts the Windows C: drive at
# /run/desktop/mnt/host/c, so a checkout at C:\Users\you\rakazo is:
#   RAKAZO_DEPLOY_DIR=/run/desktop/mnt/host/c/Users/you/rakazo
# A native Windows path fails outright (the drive-letter colon collides with the bind-mount
# separator) and /mnt/c/... fails *silently*, mounting an empty directory instead.
RAKAZO_DEPLOY_DIR=
# The images a Compose deployment runs, and the tag the in-app update moves. The updater rewrites
# RAKAZO_IMAGE_TAG and keeps the outgoing tag in RAKAZO_IMAGE_TAG_PREVIOUS for rollback, so leave
# both to it after the first deploy.
#
# The tag ships as `local`, not `latest`, because no registry serves `local`: your first
# `docker compose ... up -d --build` builds these images from this checkout, which works before any
# release has been published. Change it to a release tag (`vX.Y.Z`) once one exists and you want to
# pull prebuilt images instead of building on the server.
RAKAZO_IMAGE=ghcr.io/millson1/rakazo/app
RAKAZO_IMAGE_TAG=local
RAKAZO_IMAGE_TAG_PREVIOUS=
# The updater's own image, pinned separately because an update never recreates the updater.
RAKAZO_UPDATER_IMAGE=ghcr.io/millson1/rakazo/updater
RAKAZO_UPDATER_IMAGE_TAG=local
# Set inside Compose; leave empty for source checkouts. Optional separate service credential for
# the updater; defaults to BETTER_AUTH_SECRET when empty.
RAKAZO_UPDATER_URL=
RAKAZO_UPDATER_TOKEN=

# --- Source checkouts only ---
# Compose deployments do not need this: the updater sidecar performs the restart. On a source
# checkout, name the supervisor that will bring the process back after it exits (for example
# "docker"); systemd and pm2 are detected automatically. Left empty, updates still apply in full
# but you have to restart the processes yourself.
RAKAZO_UPDATE_RESTART_SUPERVISOR=
# Optional. GET /health returns this as `revision`. Leave it unset on a Compose deployment: the
# published image already carries the commit it was built from, and a value here would override it.
# GIT_SHA=
