NODE_ENV=development
DATABASE_URL=postgres://rakazo:rakazo@127.0.0.1:5433/rakazo
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-char-hex-or-passphrase
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Optional separate service credential; defaults to BETTER_AUTH_SECRET when empty.
SANDBOX_SUPERVISOR_TOKEN=
SANDBOX_PROVIDER=docker
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
BOX_API_KEY=
# Optional Box API base URL; defaults to https://ascii.dev/api/box/v1.
BOX_API_URL=
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
# Pause or stop computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
SANDBOX_COMMAND_TIMEOUT_MS=300000
OPENROUTER_API_KEY=
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
E2B_API_KEY=
COMPOSIO_API_KEY=
SUPERMEMORY_API_KEY=
# Optional. Defaults to https://api.supermemory.ai. Self-hosted: http://localhost:6767
SUPERMEMORY_API_URL=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
# Set to 0 to remove the owner-only in-app server update entirely.
RAKAZO_SELF_UPDATE=

# --- Compose deployments: the updater sidecar ---
# Absolute path of this checkout on the host. The updater is bind-mounted at this exact path so
# that Compose derives the same project name and resolves the same relative bind mounts it does
# from your shell. Required by infra/compose/docker-compose.prod.yml.
RAKAZO_DEPLOY_DIR=
# The published images a Compose deployment runs, and the tag the in-app update moves. The updater
# rewrites RAKAZO_IMAGE_TAG and keeps the outgoing tag in RAKAZO_IMAGE_TAG_PREVIOUS for rollback,
# so leave both to it after the first deploy.
RAKAZO_IMAGE=ghcr.io/elie222/rakazo/app
RAKAZO_IMAGE_TAG=latest
RAKAZO_IMAGE_TAG_PREVIOUS=
# The updater's own image, pinned separately because an update never recreates the updater.
RAKAZO_UPDATER_IMAGE=ghcr.io/elie222/rakazo/updater
RAKAZO_UPDATER_IMAGE_TAG=latest
# Set inside Compose; leave empty for source checkouts. Optional separate service credential for
# the updater; defaults to BETTER_AUTH_SECRET when empty.
RAKAZO_UPDATER_URL=
RAKAZO_UPDATER_TOKEN=

# --- Source checkouts only ---
# Compose deployments do not need this: the updater sidecar performs the restart. On a source
# checkout, name the supervisor that will bring the process back after it exits (for example
# "docker"); systemd and pm2 are detected automatically. Left empty, updates still apply in full
# but you have to restart the processes yourself.
RAKAZO_UPDATE_RESTART_SUPERVISOR=
# Optional. GET /health returns this as `revision`. Leave it unset on a Compose deployment: the
# published image already carries the commit it was built from, and a value here would override it.
# GIT_SHA=
